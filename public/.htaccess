<IfModule mod_rewrite.c>
    RewriteEngine On

    # If the requested file or folder exists, serve it normally.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Otherwise route clean URLs through the app entry point.
    RewriteRule ^ index.php [L]
</IfModule>
