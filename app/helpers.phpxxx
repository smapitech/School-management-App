function ui_theme_default_colors(): array
{
    return ui_theme_presets()['gmail_material']['colors'];
}

function is_valid_hex_color(mixed $value): bool
{
    return is_string($value) && preg_match('/^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/', trim($value)) === 1;
}

function normalize_hex_color(mixed $value, string $fallback = '#FFFFFF'): string
{
    $value = trim((string) $value);

    if (!is_valid_hex_color($value)) {
        return strtoupper($fallback);
    }

    $hex = strtoupper($value);
    if (strlen($hex) === 4) {
        $hex = '#' . $hex[1] . $hex[1] . $hex[2] . $hex[2] . $hex[3] . $hex[3];
    }

    return $hex;
}

function ui_theme_from_settings(array $settings): array
{
    $defaults = ui_theme_default_colors();
    $presets = ui_theme_presets();
    $preset = (string) ($settings['ui_theme_preset'] ?? 'gmail_material');

    if (!isset($presets[$preset])) {
        $preset = 'gmail_material';
    }

    $theme = ['theme_preset' => $preset];
    foreach ($defaults as $key => $fallback) {
        $theme[$key] = normalize_hex_color($settings['ui_' . $key] ?? $fallback, $fallback);
    }

    return $theme;
}

function notification_type_label(string $type): string
{
    return ucwords(str_replace('_', ' ', $type ?: 'general'));
}

function notification_priority_class(string $priority): string
{
    return 'notification-priority-' . (in_array($priority, ['low', 'normal', 'high', 'urgent'], true) ? $priority : 'normal');
}

function notification_icon(string $type): string
{
    return match ($type) {
        'homework' => 'book',
        'attendance' => 'calendar',
        'exam', 'result' => 'file',
        'fees' => 'money',
        'message' => 'mail',
        'announcement' => 'mega',
        'admission' => 'user+',
        'staff' => 'staff',
        'parent' => 'parent',
        'student' => 'student',
        'website' => 'web',
        'system' => 'cog',
        default => 'bell',
    };
}

function time_ago(?string $datetime): string
{
    if (!$datetime || strtotime($datetime) === false) {
        return '';
    }
    $seconds = max(0, time() - strtotime($datetime));
    if ($seconds < 60) {
        return 'just now';
    }
    $minutes = intdiv($seconds, 60);
    if ($minutes < 60) {
        return $minutes . ' min ago';
    }
    $hours = intdiv($minutes, 60);
    if ($hours < 24) {
        return $hours . ' hr ago';
    }
    $days = intdiv($hours, 24);
    if ($days < 7) {
        return $days . ' day' . ($days === 1 ? '' : 's') . ' ago';
    }

    return date('M j, Y', strtotime($datetime));
}

function money(mixed $value): string
{
    return 'NGN ' . number_format((float) $value, 0);
}

function is_active(string $path): string
{
    $current = parse_url($_SERVER['REQUEST_URI'] ?? '/', PHP_URL_PATH) ?: '/';

    return $current === $path ? 'is-active' : '';
}

function role_name(string $role): string
{
    return \App\Auth::ROLES[$role] ?? ucfirst($role);
}

function can(string $module, string $action = 'view'): bool
{
    return \App\Auth::can($module, $action);
}

