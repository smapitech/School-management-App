<?php

declare(strict_types=1);

function e(mixed $value): string
{
    return htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
}

function app_base_path(): string
{
    return dirname(__DIR__);
}

function app_env_path(): string
{
    return app_base_path() . '/.env';
}

function env(string $key, mixed $default = null): mixed
{
    $value = $_ENV[$key] ?? $_SERVER[$key] ?? getenv($key);

    if ($value === false || $value === null) {
        return $default;
    }

    if (is_string($value)) {
        $trimmed = trim($value);
        $normalized = strtolower($trimmed);

        return match ($normalized) {
            'true', '(true)', 'yes', 'on' => true,
            'false', '(false)', 'no', 'off' => false,
            'null', '(null)' => null,
            default => $trimmed,
        };
    }

    return $value;
}

function app_environment(): string
{
    $environment = trim((string) env('APP_ENV', 'local'));

    return $environment !== '' ? strtolower($environment) : 'local';
}

function app_debug(): bool
{
    $debug = env('APP_DEBUG', app_environment() !== 'production');

    if (is_bool($debug)) {
        return $debug;
    }

    return filter_var($debug, FILTER_VALIDATE_BOOL);
}

function show_sample_login_accounts(): bool
{
    $default = app_environment() !== 'production';
    $show = env('APP_SHOW_SAMPLE_ACCOUNTS', $default);

    if (is_bool($show)) {
        return $show;
    }

    return filter_var($show, FILTER_VALIDATE_BOOL);
}

function app_installed(): bool
{
    if (!is_file(app_env_path())) {
        return false;
    }

    $installed = env('APP_INSTALLED', null);
    if ($installed === null) {
        return app_environment() !== 'production';
    }

    if (is_bool($installed)) {
        return $installed;
    }

    return filter_var($installed, FILTER_VALIDATE_BOOL);
}

function app_installation_required(): bool
{
    if (!is_file(app_env_path())) {
        return true;
    }

    if (!app_installed()) {
        return true;
    }

    if (app_environment() !== 'production' && !app_request_is_local_host()) {
        return true;
    }

    return !app_installation_complete();
}

function app_request_is_local_host(): bool
{
    $host = strtolower(trim((string) ($_SERVER['HTTP_HOST'] ?? $_SERVER['SERVER_NAME'] ?? '')));

    if ($host === '') {
        return false;
    }

    return in_array($host, ['localhost', '127.0.0.1', '::1'], true)
        || str_ends_with($host, '.localhost')
        || str_ends_with($host, '.test')
        || str_ends_with($host, '.local');
}

function app_installation_complete(): bool
{
    static $cached = null;

    if ($cached !== null) {
        return $cached;
    }

    if (!is_file(app_env_path()) || !app_installed()) {
        return $cached = false;
    }

    $driver = strtolower(trim((string) env('DB_CONNECTION', '')));

    try {
        if ($driver === 'mysql') {
            foreach (['DB_HOST', 'DB_DATABASE', 'DB_USERNAME'] as $key) {
                if (trim((string) env($key, '')) === '') {
                    return $cached = false;
                }
            }

            $charset = trim((string) env('DB_CHARSET', 'utf8mb4'));
            if ($charset === '') {
                $charset = 'utf8mb4';
            }

            $socket = trim((string) env('DB_SOCKET', ''));
            $host = trim((string) env('DB_HOST', '127.0.0.1'));
            $port = (int) env('DB_PORT', 3306);
            $database = trim((string) env('DB_DATABASE', ''));
            $username = (string) env('DB_USERNAME', '');
            $password = (string) env('DB_PASSWORD', '');

            $dsn = $socket !== ''
                ? "mysql:unix_socket={$socket};dbname={$database};charset={$charset}"
                : "mysql:host={$host};port={$port};dbname={$database};charset={$charset}";

            $pdo = new PDO($dsn, $username, $password, [
                PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
                PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
                PDO::ATTR_EMULATE_PREPARES => false,
            ]);

            $tables = ['users', 'settings', 'website_settings'];
            $placeholders = implode(',', array_fill(0, count($tables), '?'));
            $statement = $pdo->prepare(
                "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = DATABASE() AND table_name IN ({$placeholders})"
            );
            $statement->execute($tables);

            if ((int) $statement->fetchColumn() < count($tables)) {
                return $cached = false;
            }

            $userCount = (int) $pdo->query('SELECT COUNT(*) FROM users')->fetchColumn();

            return $cached = $userCount > 0;
        }

        if ($driver === 'sqlite') {
            $path = (string) env('DB_SQLITE_PATH', app_base_path() . '/storage/database.sqlite');
            if (!is_file($path)) {
                return $cached = false;
            }

            $pdo = new PDO('sqlite:' . $path, null, null, [
                PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
                PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
                PDO::ATTR_EMULATE_PREPARES => false,
            ]);

            $tables = ['users', 'settings', 'website_settings'];
            foreach ($tables as $table) {
                $statement = $pdo->prepare("SELECT COUNT(*) FROM sqlite_master WHERE type = 'table' AND name = ?");
                $statement->execute([$table]);
                if ((int) $statement->fetchColumn() === 0) {
                    return $cached = false;
                }
            }

            $userCount = (int) $pdo->query('SELECT COUNT(*) FROM users')->fetchColumn();

            return $cached = $userCount > 0;
        }

        return $cached = false;
    } catch (Throwable) {
        return $cached = false;
    }
}

function rich_text(mixed $value): string
{
    $allowed = '<p><br><strong><b><em><i><u><a><ul><ol><li><h2><h3><font><span><div>';
    $html = strip_tags((string) $value, $allowed);

    return preg_replace('/\son[a-z]+\s*=\s*("[^"]*"|\'[^\']*\'|[^\s>]+)/i', '', $html) ?? '';
}

function csrf_token(): string
{
    if (empty($_SESSION['_csrf_token'])) {
        $_SESSION['_csrf_token'] = bin2hex(random_bytes(32));
    }

    return $_SESSION['_csrf_token'];
}

function csrf_field(): string
{
    return '<input type="hidden" name="_csrf_token" value="' . e(csrf_token()) . '">';
}

function csrf_verify(?string $token): bool
{
    return is_string($token) && hash_equals($_SESSION['_csrf_token'] ?? '', $token);
}

function public_upload_url(?string $path): string
{
    $path = trim((string) $path);
    if ($path === '') {
        return '';
    }
    $path = str_replace('\\', '/', $path);
    $path = ltrim($path, '/');
    if (str_starts_with($path, 'public/')) {
        $path = substr($path, 7);
    }

    return '/' . $path;
}

