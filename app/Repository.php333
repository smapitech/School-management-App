    }

    public function saveGalleryItems(array $items): void
    {
        $items = array_values(array_filter($items, static fn (array $item): bool => (($item['image_path'] ?? '') !== '')));
        if ($items === []) {
            return;
        }

        $statement = $this->pdo->prepare(
            'INSERT INTO website_gallery (image_path, title, description, category, is_featured, is_published, sort_order, created_by, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)'
        );

        $startedTransaction = false;
        try {
            if (!$this->pdo->inTransaction()) {
                $this->pdo->beginTransaction();
                $startedTransaction = true;
            }

            foreach ($items as $item) {
                $statement->execute([
                    $item['image_path'],
                    $item['title'] ?? '',
                    $item['description'] ?? '',
                    $item['category'] ?? 'General',
                    (int) ($item['is_featured'] ?? 0),
                    (int) ($item['is_published'] ?? 1),
                    (int) ($item['sort_order'] ?? 0),
                    (int) ($item['created_by'] ?? 0),
                    date('Y-m-d H:i:s'),
                ]);
            }

            if ($startedTransaction && $this->pdo->inTransaction()) {
                $this->pdo->commit();
            }
        } catch (\Throwable $e) {
            if ($this->pdo->inTransaction()) {
                $this->pdo->rollBack();
            }
            throw $e;
        }
    }

    public function deleteGalleryItem(int $id): void
    {
