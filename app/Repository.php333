    public function saveSalaryTemplate(array $data): void
    {
        $basic = (float) $data['basic_salary'];
        $overtime = (float) $data['overtime'];
        $bonus = (float) $data['bonus'];
        $allowanceAmount = (float) $data['allowance_amount'];
        $totalAllowance = (float) $data['total_allowance'];
        $totalDeduction = (float) $data['total_deduction'];
        $grossPay = $basic + $overtime + $bonus + $allowanceAmount + $totalAllowance;
        $netSalary = $grossPay - $totalDeduction;

        $statement = $this->pdo->prepare(
            'INSERT INTO salary_templates (staff_id, basic_salary, overtime, bonus, allowance_name, allowance_amount, total_allowance, total_deduction, gross_pay, net_salary, created_at)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)'
        );
        $statement->execute([
            $data['staff_id'],
            $basic,
            $overtime,
            $bonus,
            $data['allowance_name'],
            $allowanceAmount,
            $totalAllowance,
            $totalDeduction,
            $grossPay,
            $netSalary,
            date('Y-m-d'),
        ]);
    }

    public function salaryAssignments(): array
    {
        return $this->pdo->query(
            "SELECT sa.*, st.net_salary, s.employee_no, s.name, s.middle_name, s.surname, s.role, s.designation
            FROM salary_assignments sa
            JOIN salary_templates st ON st.id = sa.template_id
            JOIN staff s ON s.id = sa.staff_id
            ORDER BY sa.id DESC"
        )->fetchAll();
    }

    public function saveSalaryAssignment(array $data): void
    {
        $statement = $this->pdo->prepare('INSERT INTO salary_assignments (staff_id, template_id, assigned_date, note) VALUES (?, ?, ?, ?)');
        $statement->execute([$data['staff_id'], $data['template_id'], $data['assigned_date'], $data['note']]);
    }

    public function salaryPayments(array $filters = []): array
    {
        $where = [];
        $params = [];

        if (!empty($filters['payment_month'])) {
            $where[] = 'sp.payment_month = ?';
            $params[] = $filters['payment_month'];
        }

        if (!empty($filters['status'])) {
            $where[] = 'sp.status = ?';
            $params[] = $filters['status'];
        }

        $sql = "SELECT sp.*, s.employee_no, s.name, s.middle_name, s.surname, s.designation, s.mobile_no
            FROM salary_payments sp
            JOIN staff s ON s.id = sp.staff_id";

        if ($where) {
            $sql .= ' WHERE ' . implode(' AND ', $where);
        }

        $sql .= ' ORDER BY sp.id DESC';
        $statement = $this->pdo->prepare($sql);
        $statement->execute($params);

        return $statement->fetchAll();
    }

    private function teacherPayrollRows(int $staffId, ?int $payslipId = null): array
    {
        if ($staffId <= 0) {
            return [];
        }

        $sql = "SELECT
                sp.id AS payslip_id,
                sp.staff_id,
                sp.template_id,
                sp.payment_month AS pay_period,
                sp.net_payment AS net_pay,
                sp.status AS payment_status,
                sp.paid_at AS payment_date,
                sp.created_at AS payment_created_at,
                st.basic_salary,
                st.overtime,
                st.bonus,
                st.allowance_name,
                st.allowance_amount,
                st.total_allowance,
                st.total_deduction,
                st.gross_pay,
                st.net_salary,
                s.employee_no,
                s.name,
                s.middle_name,
                s.surname,
                s.designation,
                s.department,
                s.mobile_no,
                s.bank_name,
                s.account_name,
                s.account_number
            FROM salary_payments sp
            JOIN salary_templates st ON st.id = sp.template_id AND st.staff_id = sp.staff_id
            JOIN staff s ON s.id = sp.staff_id
            WHERE sp.staff_id = ?";
        $params = [$staffId];

        if ($payslipId !== null && $payslipId > 0) {
            $sql .= ' AND sp.id = ?';
            $params[] = $payslipId;
        }

        $sql .= ' ORDER BY sp.payment_month DESC, sp.id DESC';
        $statement = $this->pdo->prepare($sql);
        $statement->execute($params);

        return $statement->fetchAll();
    }

    public function getTeacherPayslips(int $staffId): array
    {
        return $this->teacherPayrollRows($staffId);
    }

    public function getTeacherLatestPayslip(int $staffId): ?array
    {
        $rows = $this->getTeacherPayslips($staffId);

        return $rows[0] ?? null;
    }

    public function getTeacherPayslip(int $staffId, int $payslipId): ?array
    {
        $rows = $this->teacherPayrollRows($staffId, $payslipId);

        return $rows[0] ?? null;
    }

    public function getTeacherAllowances(int $staffId): array
    {
        $rows = [];
        foreach ($this->teacherPayrollRows($staffId) as $row) {
            $allowanceTotal = (float) ($row['total_allowance'] ?? 0);
            $allowanceAmount = (float) ($row['allowance_amount'] ?? 0);
            if ($allowanceTotal <= 0 && $allowanceAmount <= 0) {
                continue;
            }

            $rows[] = [
                'payslip_id' => (int) ($row['payslip_id'] ?? 0),
                'pay_period' => $row['pay_period'] ?? '',
                'allowance_name' => trim((string) ($row['allowance_name'] ?? '')) ?: 'Allowance',
                'allowance_amount' => $allowanceAmount,
                'total_allowance' => $allowanceTotal,
                'payment_status' => $row['payment_status'] ?? '',
                'payment_date' => $row['payment_date'] ?? '',
                'net_pay' => (float) ($row['net_pay'] ?? 0),
                'basic_salary' => (float) ($row['basic_salary'] ?? 0),
            ];
        }

        return $rows;
    }

    public function getTeacherDeductions(int $staffId): array
    {
        $rows = [];
        foreach ($this->teacherPayrollRows($staffId) as $row) {
            $deductionTotal = (float) ($row['total_deduction'] ?? 0);
            if ($deductionTotal <= 0) {
                continue;
            }

            $rows[] = [
                'payslip_id' => (int) ($row['payslip_id'] ?? 0),
                'pay_period' => $row['pay_period'] ?? '',
                'deduction_name' => 'Salary Deduction',
                'deduction_amount' => $deductionTotal,
                'payment_status' => $row['payment_status'] ?? '',
                'payment_date' => $row['payment_date'] ?? '',
                'net_pay' => (float) ($row['net_pay'] ?? 0),
                'basic_salary' => (float) ($row['basic_salary'] ?? 0),
            ];
        }

        return $rows;
    }

    public function getTeacherIncrements(int $staffId): array
    {
        if ($staffId <= 0) {
            return [];
        }

        $statement = $this->pdo->prepare(
            'SELECT id, staff_id, basic_salary, overtime, bonus, allowance_name, allowance_amount, total_allowance, total_deduction, gross_pay, net_salary, created_at
            FROM salary_templates
            WHERE staff_id = ?
            ORDER BY created_at ASC, id ASC'
        );
        $statement->execute([$staffId]);
        $templates = $statement->fetchAll();

        $increments = [];
        $previousSalary = null;
        foreach ($templates as $template) {
            $currentSalary = (float) ($template['basic_salary'] ?? 0);
            if ($previousSalary !== null && $currentSalary > $previousSalary) {
                $increments[] = [
                    'template_id' => (int) ($template['id'] ?? 0),
                    'effective_date' => $template['created_at'] ?? '',
                    'previous_basic_salary' => (float) $previousSalary,
                    'current_basic_salary' => $currentSalary,
                    'increment_amount' => round($currentSalary - $previousSalary, 2),
                    'allowance_name' => trim((string) ($template['allowance_name'] ?? '')),
                    'allowance_amount' => (float) ($template['allowance_amount'] ?? 0),
                    'total_allowance' => (float) ($template['total_allowance'] ?? 0),
                    'total_deduction' => (float) ($template['total_deduction'] ?? 0),
                    'gross_pay' => (float) ($template['gross_pay'] ?? 0),
                    'net_salary' => (float) ($template['net_salary'] ?? 0),
                ];
            }
            $previousSalary = $currentSalary;
        }

        return $increments;
    }

    public function teacherCanViewPayslip(int $staffId, int $payslipId): bool
    {
        return $this->getTeacherPayslip($staffId, $payslipId) !== null;
    }

    public function humanResourceOverview(): array
    {
        $roles = $this->pdo->query(
            "SELECT COALESCE(NULLIF(role, ''), 'Unassigned') AS role_name, COUNT(*) AS total
            FROM staff
            GROUP BY COALESCE(NULLIF(role, ''), 'Unassigned')
            ORDER BY total DESC, role_name ASC"
        )->fetchAll();

        $totals = $this->pdo->query(
            "SELECT
                COALESCE(SUM(CASE WHEN sp.status = 'Paid' THEN sp.net_payment ELSE 0 END), 0) AS salary_paid,
                COALESCE(SUM(CASE WHEN sp.status = 'Paid' THEN st.allowance_amount + st.total_allowance ELSE 0 END), 0) AS allowance_paid,
                COALESCE(SUM(CASE WHEN sp.status = 'Paid' THEN st.total_deduction ELSE 0 END), 0) AS deduction_total,
                COALESCE(SUM(CASE WHEN sp.status = 'Paid' THEN st.gross_pay ELSE 0 END), 0) AS gross_paid
            FROM salary_payments sp
            JOIN salary_templates st ON st.id = sp.template_id"
        )->fetch() ?: [];

        $templateTotals = $this->pdo->query(
            "SELECT
                COALESCE(SUM(net_salary), 0) AS expected_salary,
                COALESCE(SUM(allowance_amount + total_allowance), 0) AS expected_allowance,
                COALESCE(SUM(total_deduction), 0) AS expected_deduction
            FROM salary_templates"
        )->fetch() ?: [];

        return [
            'roles' => $roles,
            'totals' => array_merge($templateTotals, $totals),
        ];
    }

    public function salaryPaymentById(int $id): ?array
    {
        $statement = $this->pdo->prepare(
            "SELECT sp.*, st.basic_salary, st.overtime, st.bonus, st.total_allowance, st.total_deduction, st.gross_pay, st.net_salary,
            s.employee_no, s.name, s.middle_name, s.surname, s.designation, s.mobile_no, s.bank_name, s.account_name, s.account_number
            FROM salary_payments sp
            JOIN salary_templates st ON st.id = sp.template_id
            JOIN staff s ON s.id = sp.staff_id
            WHERE sp.id = ? LIMIT 1"
        );
        $statement->execute([$id]);
        $row = $statement->fetch();

        return $row ?: null;
    }

    public function saveSalaryPayment(array $data): void
    {
        $template = $this->salaryTemplateById((int) $data['template_id']);

        if (!$template) {
            return;
        }

        $statement = $this->pdo->prepare(
            'INSERT INTO salary_payments (staff_id, template_id, payment_month, net_payment, status, paid_at, created_at)
            VALUES (?, ?, ?, ?, ?, ?, ?)'
        );
        $status = $data['status'] ?: 'Pending';
        $statement->execute([
            $template['staff_id'],
            $template['id'],
            $data['payment_month'],
            $template['net_salary'],
            $status,
            $status === 'Paid' ? date('Y-m-d') : '',
            date('Y-m-d'),
        ]);
    }

