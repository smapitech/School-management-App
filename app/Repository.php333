    public function saveWebsiteReview(array $data): void
    {
        if (($data['parent_name'] ?? '') === '' || ($data['review_text'] ?? '') === '') {
            return;
        }
        $statement = $this->pdo->prepare(
            'INSERT INTO website_reviews (parent_name, parent_title, review_text, parent_image, rating, is_featured, is_published, sort_order, created_by, created_at)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)'
        );
        $statement->execute([
            $data['parent_name'],
            $data['parent_title'] ?? '',
            $data['review_text'],
            $data['parent_image'] ?? '',
            max(1, min(5, (int) ($data['rating'] ?? 5))),
            (int) ($data['is_featured'] ?? 0),
            (int) ($data['is_published'] ?? 1),
            (int) ($data['sort_order'] ?? 0),
            (int) ($data['created_by'] ?? 0),
            date('Y-m-d H:i:s'),
        ]);
    }

