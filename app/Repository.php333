    public function examMarks(int $settingId): array
    {
        $statement = $this->pdo->prepare('SELECT * FROM exam_marks WHERE exam_setting_id = ?');
        $statement->execute([$settingId]);
        $marks = [];

        foreach ($statement->fetchAll() as $row) {
            $studentId = (int) ($row['student_id'] ?? 0);
            $distributionId = (int) ($row['distribution_id'] ?? 0);
            if ($studentId <= 0 || $distributionId <= 0) {
                continue;
            }

            $marks[$studentId][$distributionId] = (string) ($row['mark'] ?? '');
        }

        return $marks;
    }

    public function examComments(int $settingId): array
    {
        $statement = $this->pdo->prepare('SELECT * FROM exam_comments WHERE exam_setting_id = ?');
        $statement->execute([$settingId]);
        $comments = [];

        foreach ($statement->fetchAll() as $row) {
            $studentId = (int) ($row['student_id'] ?? 0);
            if ($studentId <= 0) {
                continue;
            }

            $comments[$studentId] = [
                'id' => (int) ($row['id'] ?? 0),
                'exam_setting_id' => (int) ($row['exam_setting_id'] ?? 0),
                'student_id' => $studentId,
                'teacher_remark' => (string) ($row['teacher_remark'] ?? ''),
                'teacher_comment' => (string) ($row['teacher_comment'] ?? ''),
                'created_at' => (string) ($row['created_at'] ?? ''),
            ];
        }

        return $comments;
    }

    public function examMarksForStudent(int $settingId, int $studentId): array
    {
        $statement = $this->pdo->prepare('SELECT distribution_id, mark FROM exam_marks WHERE exam_setting_id = ? AND student_id = ?');
        $statement->execute([$settingId, $studentId]);
        $marks = [];

        foreach ($statement->fetchAll() as $row) {
            $distributionId = (int) ($row['distribution_id'] ?? 0);
            if ($distributionId <= 0) {
                continue;
            }

            $marks[$distributionId] = (string) ($row['mark'] ?? '');
        }

        return $marks;
    }

    public function saveExamMarks(int $settingId, array $marks, int $teacherId = 0, int $editStudentId = 0, array $comments = []): int
    {
        $insert = $this->pdo->prepare('INSERT INTO exam_marks (exam_setting_id, student_id, distribution_id, mark, teacher_id, created_at) VALUES (?, ?, ?, ?, ?, ?)');
        $update = $this->pdo->prepare('UPDATE exam_marks SET mark = ?, teacher_id = ?, created_at = ? WHERE exam_setting_id = ? AND student_id = ? AND distribution_id = ?');
        $exists = $this->pdo->prepare('SELECT COUNT(*) FROM exam_marks WHERE exam_setting_id = ? AND student_id = ? AND distribution_id = ?');
        $commentStatement = $this->pdo->prepare(
            'REPLACE INTO exam_comments (exam_setting_id, student_id, teacher_remark, teacher_comment, created_at) VALUES (?, ?, ?, ?, ?)'
        );
        $blocked = 0;

        foreach ($marks as $studentId => $studentMarks) {
            $studentId = (int) $studentId;

            foreach ((array) $studentMarks as $distributionId => $mark) {
                $distributionId = (int) $distributionId;
                $exists->execute([$settingId, $studentId, $distributionId]);
                $hasMark = (int) $exists->fetchColumn() > 0;

                if ($hasMark && $editStudentId !== $studentId) {
                    $blocked++;
                    continue;
                }

                if ($hasMark) {
                    $update->execute([(float) $mark, $teacherId, date('Y-m-d'), $settingId, $studentId, $distributionId]);
                    continue;
                }

                $insert->execute([$settingId, $studentId, $distributionId, (float) $mark, $teacherId, date('Y-m-d')]);
            }
        }

        foreach ($comments as $studentId => $comment) {
            $studentId = (int) $studentId;
            if ($studentId <= 0) {
                continue;
            }

            $commentStatement->execute([
                $settingId,
                $studentId,
                trim($comment['teacher_remark'] ?? ''),
                trim($comment['teacher_comment'] ?? ''),
                date('Y-m-d'),
            ]);
        }

        return $blocked;
    }

    public function deleteExamMarksForStudent(int $settingId, int $studentId): void
    {
        if ($settingId <= 0 || $studentId <= 0) {
            return;
        }

        $statement = $this->pdo->prepare('DELETE FROM exam_marks WHERE exam_setting_id = ? AND student_id = ?');
        $statement->execute([$settingId, $studentId]);
    }

    public function saveExamSchedule(array $data): void
    {
        if ((int) ($data['exam_setting_id'] ?? 0) <= 0) {
            return;
        }

        if (!empty($data['id'])) {
            $statement = $this->pdo->prepare('UPDATE exam_schedules SET exam_setting_id = ?, exam_date = ?, start_time = ?, end_time = ? WHERE id = ?');
            $statement->execute([$data['exam_setting_id'], $data['exam_date'], $data['start_time'], $data['end_time'], $data['id']]);
            return;
        }

        $statement = $this->pdo->prepare('INSERT INTO exam_schedules (exam_setting_id, exam_date, start_time, end_time, created_at) VALUES (?, ?, ?, ?, ?)');
        $statement->execute([$data['exam_setting_id'], $data['exam_date'], $data['start_time'], $data['end_time'], date('Y-m-d')]);
    }

    public function examSchedules(array $user, array $filters = []): array
    {
        if (!empty($filters['student_id'])) {
            $student = $this->admissionById((int) $filters['student_id']);
            if ($student) {
                $filters['class_name'] = $student['class_name'];
                $filters['section'] = $student['section'];
            }
        }

        $settingIds = array_map(fn (array $setting): int => (int) $setting['id'], $this->examSettings($user));

        if (!$settingIds) {
            return [];
        }

        $placeholders = implode(', ', array_fill(0, count($settingIds), '?'));
        $where = ["sc.exam_setting_id IN ({$placeholders})"];
        $params = $settingIds;

        if (!empty($filters['class_name'])) {
            $where[] = 'es.class_name = ?';
            $params[] = $filters['class_name'];
        }

        if (!empty($filters['section'])) {
            $where[] = 'es.section = ?';
            $params[] = $filters['section'];
        }

        $statement = $this->pdo->prepare(
            "SELECT sc.*, es.class_name, es.section, es.school_term, es.school_session, es.exam_name, sub.subject_name
            FROM exam_schedules sc
            JOIN exam_settings es ON es.id = sc.exam_setting_id
            JOIN subjects sub ON sub.id = es.subject_id
            WHERE " . implode(' AND ', $where) . "
            ORDER BY sc.exam_date ASC, sc.start_time ASC"
        );
        $statement->execute($params);

        return $statement->fetchAll();
    }

    public function admissionById(int $id): ?array
    {
        $statement = $this->pdo->prepare('SELECT * FROM admissions WHERE id = ? LIMIT 1');
        $statement->execute([$id]);
        $row = $statement->fetch();

        return $row ?: null;
    }

    public function updateAdmission(int $id, array $data): void
    {
        $existing = $this->admissionById($id);
        if (!$existing) {
            return;
        }

        $applicant = trim($data['first_name'] . ' ' . ($data['middle_name'] ?? '') . ' ' . $data['last_name']);
        $guardian = $data['guardian_full_name'] ?: ($data['father_name'] ?: $data['mother_name']);
        $password = (string) ($data['password'] ?? '');
        $passwordHash = $password !== '' ? password_hash($password, PASSWORD_DEFAULT) : (string) ($existing['password'] ?? '');
        $parentPasswordHash = $passwordHash;

        $statement = $this->pdo->prepare(
            'UPDATE admissions SET academic_year = ?, school_term = ?, registration_no = ?, admission_date = ?, applicant = ?, class_name = ?, section = ?, first_name = ?, middle_name = ?, last_name = ?, date_of_birth = ?, gender = ?, religion = ?, address = ?, email = ?, city = ?, state = ?, profile_picture = ?, username = ?, password = ?, parent_username = ?, parent_password = ?, mother_tongue = ?, guardian = ?, guardian_full_name = ?, guardian_relationship = ?, father_name = ?, mother_name = ?, guardian_occupation = ?, guardian_address = ?, guardian_city = ?, guardian_state = ?, guardian_mobile = ?, guardian_picture = ? WHERE id = ?'
        );
        $statement->execute([
            $data['academic_year'],
            $data['school_term'],
            $data['registration_no'],
            $data['admission_date'],
            $applicant,
            $data['class_name'],
            $data['section'],
            $data['first_name'],
            $data['middle_name'],
            $data['last_name'],
            $data['date_of_birth'],
            $data['gender'],
            $data['religion'],
            $data['address'],
            $data['email'],
            $data['city'],
            $data['state'],
            $data['profile_picture'],
            $data['username'],
            $passwordHash,
            $data['guardian_mobile'],
            $parentPasswordHash,
            $data['mother_tongue'],
            $guardian,
            $data['guardian_full_name'],
            $data['guardian_relationship'],
            $data['father_name'],
            $data['mother_name'],
            $data['guardian_occupation'],
            $data['guardian_address'],
            $data['guardian_city'],
            $data['guardian_state'],
            $data['guardian_mobile'],
            $data['guardian_picture'],
            $id,
        ]);

        $this->deleteUserByEmail((string) ($existing['username'] ?? ''));
        if (($existing['username'] ?? '') === '') {
            $this->deleteUserByEmail((string) ($existing['email'] ?? ''));
        }

        if (($data['username'] ?? '') !== '' && $passwordHash !== '') {
            $user = $this->pdo->prepare('REPLACE INTO users (name, email, password, role, status, created_at) VALUES (?, ?, ?, ?, ?, ?)');
            $user->execute([$applicant, $data['username'], $passwordHash, 'student', 'Active', date('Y-m-d')]);
        }

        $this->deleteUserByEmail((string) ($existing['parent_username'] ?? ''));
        if (($existing['parent_username'] ?? '') === '') {
            $this->deleteUserByEmail((string) ($existing['guardian_mobile'] ?? ''));
        }

        if (($data['guardian_mobile'] ?? '') !== '' && $parentPasswordHash !== '') {
            $parent = $this->pdo->prepare('REPLACE INTO users (name, email, password, role, status, created_at) VALUES (?, ?, ?, ?, ?, ?)');
            $parent->execute([$guardian ?: 'Parent', $data['guardian_mobile'], $parentPasswordHash, 'parent', 'Active', date('Y-m-d')]);
        }
    }

    public function deleteAdmission(int $id): void
    {
        $student = $this->admissionById($id);
        if (!$student) {
            return;
        }

        $this->deleteUserByEmail((string) ($student['username'] ?? ''));
        if (($student['username'] ?? '') === '') {
            $this->deleteUserByEmail((string) ($student['email'] ?? ''));
        }

        $this->deleteUserByEmail((string) ($student['parent_username'] ?? ''));
        if (($student['parent_username'] ?? '') === '') {
            $this->deleteUserByEmail((string) ($student['guardian_mobile'] ?? ''));
        }

        $statement = $this->pdo->prepare('DELETE FROM admissions WHERE id = ?');
        $statement->execute([$id]);
    }

    public function examOverviewSubjects(array $filters, array $user): array
    {
        $settings = array_filter($this->examSettings($user), function (array $setting) use ($filters): bool {
            foreach (['class_name', 'section', 'school_term', 'school_session'] as $field) {
                if (!empty($filters[$field]) && $setting[$field] !== $filters[$field]) {
                    return false;
                }
            }

            return true;
        });
        $totalMark = array_sum(array_map(fn (array $row): float => (float) $row['max_mark'], $this->markDistributions()));
        $passMark = $this->passMark();

        return array_map(function (array $setting) use ($totalMark, $passMark): array {
            $setting['total_mark'] = $totalMark;
            $setting['pass_mark'] = $passMark;

            return $setting;
        }, array_values($settings));
    }

    public function examStudentsForUser(array $user, array $filters = []): array
    {
        $effectiveFilters = [];

        if (!empty($filters['class_name'])) {
            $effectiveFilters['class_name'] = $filters['class_name'];
        }

        if (!empty($filters['section'])) {
            $effectiveFilters['section'] = $filters['section'];
        }

        if (($user['role'] ?? '') === 'teacher') {
            $students = [];
            foreach ($this->teacherAssignmentsForUser($user) as $assignment) {
                if (!empty($filters['class_name']) && $filters['class_name'] !== $assignment['class_name']) {
                    continue;
                }
                if (!empty($filters['section']) && $filters['section'] !== $assignment['section']) {
                    continue;
                }

                $students = array_merge($students, $this->admittedStudents([
                    'class_name' => $assignment['class_name'],
                    'section' => $assignment['section'],
                ]));
            }

            return $students;
        }

        return $this->admittedStudents($effectiveFilters);
    }

    public function studentExamResults(int $studentId, array $filters, array $user): array
    {
        $student = null;
        foreach ($this->examStudentsForUser($user, $filters) as $row) {
            if ((int) $row['id'] === $studentId) {
                $student = $row;
                break;
            }
        }

        if (!$student) {
            return [];
        }

        $settings = $this->examOverviewSubjects($filters, $user);
        $rows = [];
        foreach ($settings as $setting) {
            if ($setting['class_name'] !== $student['class_name'] || $setting['section'] !== $student['section']) {
                continue;
            }

            $statement = $this->pdo->prepare('SELECT COALESCE(SUM(mark), 0) FROM exam_marks WHERE exam_setting_id = ? AND student_id = ?');
            $statement->execute([(int) $setting['id'], $studentId]);
            $score = (float) $statement->fetchColumn();
            $setting['student_score'] = $score;
            $setting['grade'] = $this->gradeForMark($score);
            $rows[] = $setting;
        }

        return $rows;
    }

    public function studentForPortal(array $user, int $previewStudentId = 0): ?array
    {
        if ($previewStudentId > 0 && in_array($user['role'] ?? '', ['superadmin', 'admin'], true)) {
            return $this->admissionById($previewStudentId);
        }

        if (($user['role'] ?? '') !== 'student') {
            return null;
        }

        $login = $user['email'] ?? '';
        $statement = $this->pdo->prepare('SELECT * FROM admissions WHERE username = ? OR email = ? OR id = ? ORDER BY id DESC LIMIT 1');
        $statement->execute([$login, $login, (int) ($user['id'] ?? 0)]);
        $student = $statement->fetch();

        if ($student) {
            return $student;
        }

        return null;
    }

    public function parentPortalChildren(array $user): array
    {
        if (in_array($user['role'] ?? '', ['superadmin', 'admin'], true)) {
            return $this->pdo->query('SELECT * FROM admissions ORDER BY id ASC LIMIT 25')->fetchAll();
        }

        if (($user['role'] ?? '') !== 'parent') {
            return [];
        }

        $login = $user['email'] ?? '';
        $statement = $this->pdo->prepare(
            'SELECT * FROM admissions
            WHERE parent_username = ? OR guardian_mobile = ? OR email = ? OR guardian_full_name = ?
            ORDER BY class_name ASC, applicant ASC'
        );
        $statement->execute([$login, $login, $login, $user['name'] ?? '']);
        $children = $statement->fetchAll();

        return $children;
    }

    public function parentPortalChildById(array $user, int $studentId): ?array
    {
        if ($studentId > 0 && in_array($user['role'] ?? '', ['superadmin', 'admin'], true)) {
            return $this->admissionById($studentId);
        }

        foreach ($this->parentPortalChildren($user) as $child) {
            if ((int) $child['id'] === $studentId) {
                return $child;
            }
        }

        return null;
    }

    public function parentPortalMessages(array $user): array
    {
        $statement = $this->pdo->prepare(
            "SELECT * FROM communication_messages
            WHERE audience IN ('Parents', 'Parents and Students', 'All Users')
            OR recipient_role = 'parent'
            OR recipient_contact = ?
            ORDER BY id DESC LIMIT 12"
        );
        $statement->execute([$user['email'] ?? '']);

        return $statement->fetchAll();
    }

    public function studentPortalAttendance(int $studentId): array
    {
        $statement = $this->pdo->prepare('SELECT * FROM student_attendance WHERE student_id = ? ORDER BY attendance_date DESC LIMIT 12');
        $statement->execute([$studentId]);

        return $statement->fetchAll();
    }

    public function studentPortalAttendanceByMonth(int $studentId, string $month): array
    {
        if (!preg_match('/^\d{4}-\d{2}$/', $month)) {
            $month = date('Y-m');
        }

        $statement = $this->pdo->prepare(
            "SELECT * FROM student_attendance
            WHERE student_id = ? AND attendance_date LIKE ?
            ORDER BY attendance_date ASC"
        );
        $statement->execute([$studentId, $month . '%']);

        return $statement->fetchAll();
    }

    public function studentPortalFees(array $student): array
    {
        return $this->fees(['class_name' => $student['class_name'] ?? '']);
    }

    public function studentPortalFeeSummary(array $student): array
    {
        $summary = ['Paid' => 0.0, 'Partial' => 0.0, 'Unpaid' => 0.0];

        foreach ($this->studentPortalFees($student) as $fee) {
            $status = $fee['status'] ?? 'Unpaid';
            $summary[$status] = ($summary[$status] ?? 0) + (float) ($fee['amount'] ?? 0);
        }

        return $summary;
    }

