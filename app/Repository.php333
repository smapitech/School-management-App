    public function saveClassAssignment(array $data, ?int $id = null): void
    {
        if ($id) {
            $statement = $this->pdo->prepare('UPDATE class_assignments SET class_name = ?, section = ?, teacher_id = ?, number_of_students = ? WHERE id = ?');
            $statement->execute([$data['class_name'], $data['section'], $data['teacher_id'], $data['number_of_students'], $id]);
            return;
        }

        $statement = $this->pdo->prepare('INSERT INTO class_assignments (class_name, section, teacher_id, number_of_students, created_at) VALUES (?, ?, ?, ?, ?)');
        $statement->execute([$data['class_name'], $data['section'], $data['teacher_id'], $data['number_of_students'], date('Y-m-d')]);
    }

