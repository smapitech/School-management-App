    {
        return $this->pdo->query(
            "SELECT employee_no, name, middle_name, surname, role, designation, email, mobile_no, staff_photo
            FROM staff
            WHERE status = 'Active'
            ORDER BY role ASC, name ASC"
        )->fetchAll();
    }

