    }

    public function markDistributionById(int $id): ?array
    {
        $statement = $this->pdo->prepare('SELECT * FROM mark_distributions WHERE id = ? LIMIT 1');
        $statement->execute([$id]);
        $row = $statement->fetch();

        return $row ?: null;
    }

    public function saveMarkDistribution(array $data): void
    {
        if (($data['name'] ?? '') === '') {
            return;
        }

        if (!empty($data['id'])) {
            $statement = $this->pdo->prepare('UPDATE mark_distributions SET name = ?, max_mark = ?, sort_order = ? WHERE id = ?');
            $statement->execute([$data['name'], $data['max_mark'], $data['sort_order'], (int) $data['id']]);
            return;
        }

        $statement = $this->pdo->prepare('INSERT INTO mark_distributions (name, max_mark, sort_order, created_at) VALUES (?, ?, ?, ?)');
        $statement->execute([$data['name'], $data['max_mark'], $data['sort_order'], date('Y-m-d')]);
    }

    public function deleteMarkDistribution(int $id): void
    {
        if ($id <= 0) {
            return;
        }

        $statement = $this->pdo->prepare('DELETE FROM mark_distributions WHERE id = ?');
        $statement->execute([$id]);
    }

