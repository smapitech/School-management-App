        $statement->execute([$data['photo_path'] ?? '', $data['full_name'], $data['role_title'] ?? '', $data['subject'] ?? '', $data['phone'] ?? '', $data['email'] ?? '', $data['biography'] ?? '', $data['social_link'] ?? '', (int) ($data['is_featured'] ?? 0), (int) ($data['is_published'] ?? 1), (int) ($data['sort_order'] ?? 0), (int) ($data['created_by'] ?? 0), date('Y-m-d H:i:s')]);
