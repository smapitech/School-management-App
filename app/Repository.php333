    public function studentPortalMessages(array $student): array
    {
        $statement = $this->pdo->prepare(
            "SELECT * FROM communication_messages
            WHERE audience IN ('Students', 'All Users', 'Parents and Students')
            OR recipient_role = 'student'
            OR recipient_name = ?
            ORDER BY id DESC LIMIT 10"
        );
        $statement->execute([$student['applicant'] ?? '']);

        return $statement->fetchAll();
    }

    public function studentPortalAssignments(array $student): array
    {
        $statement = $this->pdo->prepare(
            "SELECT ha.*, hs.id AS submission_id, hs.status AS submission_status, hs.submitted_at, hs.attachment_name,
                hs.submission_text, hs.submission_link, hs.is_late, hs.score, hs.feedback, hs.correction_file_path, hs.correction_file_name,
                st.name AS teacher_name, st.surname AS teacher_surname
            FROM homework_assignments ha
            LEFT JOIN homework_submissions hs ON hs.assignment_id = ha.id AND hs.student_id = ? AND hs.deleted_at = ''
            LEFT JOIN staff st ON st.id = ha.teacher_id
            WHERE ha.class_name = ? AND (ha.section = '' OR ha.section = ?)
            AND ha.status IN ('published', 'closed') AND ha.deleted_at = ''
            ORDER BY ha.due_at ASC, ha.id DESC"
        );
        $statement->execute([(int) $student['id'], $student['class_name'], $student['section']]);

        return array_map(fn (array $row): array => $this->withHomeworkStudentStatus($row), $statement->fetchAll());
    }

    public function submitHomework(array $data): void
    {
        if ((int) ($data['assignment_id'] ?? 0) <= 0 || (int) ($data['student_id'] ?? 0) <= 0) {
            return;
        }

        $homework = $this->homeworkById((int) $data['assignment_id']);
        if (!$homework || !in_array($homework['status'], ['published', 'closed'], true)) {
            return;
        }

        $now = date('Y-m-d H:i:s');
        $isLate = strtotime($now) > strtotime($homework['due_at'] ?: $homework['due_date']);
        if ($isLate && (int) $homework['allow_late_submission'] !== 1) {
            return;
        }

        $existing = $this->homeworkSubmissionForStudent((int) $data['assignment_id'], (int) $data['student_id']);
        if ($existing && !in_array($existing['status'], ['pending', 'submitted', 'late', 'resubmission_required'], true)) {
            return;
        }

        $status = $isLate ? 'late' : 'submitted';
        $payload = [
            (int) $data['assignment_id'],
            (int) $data['student_id'],
            trim($data['submission_text'] ?? ''),
            $data['attachment_path'] ?? ($existing['attachment_path'] ?? ''),
            $data['attachment_name'] ?? ($existing['attachment_name'] ?? ''),
            trim($data['submission_link'] ?? ''),
            $isLate ? 1 : 0,
            $status,
            $now,
        ];

        if ($existing) {
            $statement = $this->pdo->prepare(
                'UPDATE homework_submissions SET submission_text = ?, attachment_path = ?, attachment_name = ?, submission_link = ?, is_late = ?, status = ?, submitted_at = ? WHERE id = ?'
            );
            $statement->execute(array_merge(array_slice($payload, 2), [(int) $existing['id']]));
            $this->logHomeworkSubmission((int) $existing['id'], (int) $data['student_id'], 'resubmitted', 'Student updated homework submission.');
            return;
        }

        $statement = $this->pdo->prepare(
            'INSERT INTO homework_submissions (assignment_id, student_id, submission_text, attachment_path, attachment_name, submission_link, is_late, status, submitted_at)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)'
        );
        $statement->execute($payload);
        $submissionId = (int) $this->pdo->lastInsertId();
        $this->logHomeworkSubmission($submissionId, (int) $data['student_id'], $status, 'Student submitted homework.');
        $this->createHomeworkNotification('teacher', (int) $homework['teacher_id'], 'Homework submitted', 'A student submitted ' . $homework['title'], (int) $homework['id']);
    }

    public function homeworksForUser(array $user, array $filters = []): array
    {
        $where = ["ha.deleted_at = ''"];
        $params = [];

        if (($user['role'] ?? '') === 'teacher') {
            $assignments = $this->teacherAssignmentsForUser($user);
            if (!$assignments) {
                return [];
            }

            $pairs = [];
            foreach ($assignments as $assignment) {
                $pairs[] = '(ha.class_name = ? AND ha.section = ?)';
                $params[] = $assignment['class_name'];
                $params[] = $assignment['section'];
            }
            $where[] = '(' . implode(' OR ', $pairs) . ')';
        }

        foreach (['class_name', 'section', 'status'] as $field) {
            if (!empty($filters[$field])) {
                $where[] = "ha.{$field} = ?";
                $params[] = $filters[$field];
            }
        }
        if (!empty($filters['teacher_id'])) {
            $where[] = 'ha.teacher_id = ?';
            $params[] = (int) $filters['teacher_id'];
        }
        if (!empty($filters['subject_id'])) {
            $where[] = 'ha.subject_id = ?';
            $params[] = (int) $filters['subject_id'];
        }

        $statement = $this->pdo->prepare(
            "SELECT ha.*, st.name AS teacher_name, st.surname AS teacher_surname, sub.subject_name,
                COUNT(hs.id) AS submissions_count,
                SUM(CASE WHEN hs.status = 'marked' THEN 1 ELSE 0 END) AS marked_count,
                SUM(CASE WHEN hs.status = 'late' THEN 1 ELSE 0 END) AS late_count
            FROM homework_assignments ha
            LEFT JOIN staff st ON st.id = ha.teacher_id
            LEFT JOIN subjects sub ON sub.id = ha.subject_id
            LEFT JOIN homework_submissions hs ON hs.assignment_id = ha.id AND hs.deleted_at = ''
            WHERE " . implode(' AND ', $where) . "
            GROUP BY ha.id
            ORDER BY ha.due_at ASC, ha.id DESC"
        );
        $statement->execute($params);

        return $statement->fetchAll();
    }

    public function homeworkById(int $id): ?array
    {
        $statement = $this->pdo->prepare(
            "SELECT ha.*, st.name AS teacher_name, st.surname AS teacher_surname, sub.subject_name
            FROM homework_assignments ha
            LEFT JOIN staff st ON st.id = ha.teacher_id
            LEFT JOIN subjects sub ON sub.id = ha.subject_id
            WHERE ha.id = ? AND ha.deleted_at = ''
            LIMIT 1"
        );
        $statement->execute([$id]);
        $row = $statement->fetch();

        return $row ?: null;
    }

    public function saveHomework(array $data, ?int $id = null): void
    {
        if ($id) {
            $current = $this->homeworkById($id);
            $statement = $this->pdo->prepare(
                'UPDATE homework_assignments SET teacher_id = ?, class_name = ?, section = ?, subject_id = ?, subject = ?, title = ?, topic = ?, description = ?, due_date = ?, due_at = ?, total_marks = ?, submission_type = ?, attachment_path = ?, attachment_name = ?, resource_link = ?, allow_late_submission = ?, status = ?, updated_by = ? WHERE id = ?'
            );
            $statement->execute([
                $data['teacher_id'], $data['class_name'], $data['section'], $data['subject_id'], $data['subject'], $data['title'],
                $data['topic'], $data['description'], $data['due_date'], str_replace('T', ' ', $data['due_at']), $data['total_marks'],
                $data['submission_type'], $data['attachment_path'] ?: ($current['attachment_path'] ?? ''), $data['attachment_name'] ?: ($current['attachment_name'] ?? ''),
                $data['resource_link'], $data['allow_late_submission'], $data['status'], $data['updated_by'], $id,
            ]);
            return;
        }

        $statement = $this->pdo->prepare(
            'INSERT INTO homework_assignments (teacher_id, class_name, section, subject_id, subject, title, topic, description, due_date, due_at, total_marks, submission_type, attachment_path, attachment_name, resource_link, allow_late_submission, status, created_by, updated_by, created_at)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)'
        );
        $statement->execute([
            $data['teacher_id'], $data['class_name'], $data['section'], $data['subject_id'], $data['subject'], $data['title'],
            $data['topic'], $data['description'], $data['due_date'], str_replace('T', ' ', $data['due_at']), $data['total_marks'],
            $data['submission_type'], $data['attachment_path'] ?? '', $data['attachment_name'] ?? '', $data['resource_link'],
            $data['allow_late_submission'], $data['status'], $data['created_by'], $data['updated_by'], date('Y-m-d'),
        ]);

        if ($data['status'] === 'published') {
            $this->createHomeworkNotification('student', 0, 'New homework published', $data['title'], (int) $this->pdo->lastInsertId());
            $this->createHomeworkNotification('parent', 0, 'New homework assigned', $data['title'], (int) $this->pdo->lastInsertId());
        }
    }

    public function updateHomeworkStatus(int $id, string $status): void
    {
        if (!in_array($status, ['draft', 'published', 'closed', 'archived'], true)) {
            $status = 'closed';
        }
        $statement = $this->pdo->prepare('UPDATE homework_assignments SET status = ? WHERE id = ?');
        $statement->execute([$status, $id]);
    }

    public function deleteHomework(int $id): void
    {
        $statement = $this->pdo->prepare("UPDATE homework_assignments SET deleted_at = ? WHERE id = ?");
        $statement->execute([date('Y-m-d H:i:s'), $id]);
    }

    public function homeworkSubmissions(int $homeworkId, string $status = ''): array
    {
        $homework = $this->homeworkById($homeworkId);
        if (!$homework) {
            return [];
        }

        $students = $this->admittedStudents(['class_name' => $homework['class_name'], 'section' => $homework['section']]);
        $statement = $this->pdo->prepare(
            "SELECT hs.*, a.applicant, a.first_name, a.middle_name, a.last_name, a.registration_no, a.profile_picture
            FROM homework_submissions hs
            JOIN admissions a ON a.id = hs.student_id
            WHERE hs.assignment_id = ? AND hs.deleted_at = ''"
        );
        $statement->execute([$homeworkId]);
        $submitted = [];
        foreach ($statement->fetchAll() as $row) {
            $submitted[(int) $row['student_id']] = $row;
        }

        $rows = [];
        foreach ($students as $student) {
            $row = $submitted[(int) $student['id']] ?? [
                'id' => 0,
                'assignment_id' => $homeworkId,
                'student_id' => $student['id'],
                'status' => strtotime($homework['due_at'] ?: $homework['due_date']) < time() ? 'missed' : 'pending',
                'submitted_at' => '',
                'score' => null,
                'feedback' => '',
                'private_note' => '',
                'attachment_path' => '',
                'attachment_name' => '',
                'submission_link' => '',
            ];
            $row['applicant'] = $student['applicant'];
            $row['first_name'] = $student['first_name'];
            $row['middle_name'] = $student['middle_name'];
            $row['last_name'] = $student['last_name'];
            $row['registration_no'] = $student['registration_no'];
            $row['profile_picture'] = $student['profile_picture'];
            if ($status === '' || $row['status'] === $status) {
                $rows[] = $row;
            }
        }

        return $rows;
    }

    public function homeworkSubmissionById(int $id): ?array
    {
        $statement = $this->pdo->prepare('SELECT * FROM homework_submissions WHERE id = ? AND deleted_at = ? LIMIT 1');
        $statement->execute([$id, '']);
        $row = $statement->fetch();

        return $row ?: null;
    }

    public function homeworkSubmissionForStudent(int $homeworkId, int $studentId): ?array
    {
        $statement = $this->pdo->prepare('SELECT * FROM homework_submissions WHERE assignment_id = ? AND student_id = ? AND deleted_at = ? ORDER BY id DESC LIMIT 1');
        $statement->execute([$homeworkId, $studentId, '']);
        $row = $statement->fetch();

        return $row ?: null;
    }

    public function markHomeworkSubmission(array $data): void
    {
        $submission = $this->homeworkSubmissionById((int) $data['submission_id']);
        if (!$submission) {
            return;
        }

        $homework = $this->homeworkById((int) $submission['assignment_id']);
        $score = min((float) ($homework['total_marks'] ?? 100), max(0, (float) $data['score']));
        $statement = $this->pdo->prepare(
            'UPDATE homework_submissions SET score = ?, feedback = ?, correction_file_path = ?, correction_file_name = ?, private_note = ?, status = ?, marked_by = ?, marked_at = ? WHERE id = ?'
        );
        $statement->execute([
            $score, $data['feedback'], $data['correction_file_path'] ?: ($submission['correction_file_path'] ?? ''),
            $data['correction_file_name'] ?: ($submission['correction_file_name'] ?? ''), $data['private_note'],
            in_array($data['status'], ['marked', 'resubmission_required'], true) ? $data['status'] : 'marked',
            $data['marked_by'], date('Y-m-d H:i:s'), $data['submission_id'],
        ]);
        $this->logHomeworkSubmission((int) $data['submission_id'], (int) $data['marked_by'], $data['status'], 'Teacher marked submission.');
    }

    public function homeworkSummary(array $user): array
    {
        $homeworks = $this->homeworksForUser($user, []);
        $ids = array_map(fn (array $row): int => (int) $row['id'], $homeworks);
        $submissions = $this->homeworkSubmissionCounts($ids);
        $total = count($homeworks);
        $submitted = ($submissions['submitted'] ?? 0) + ($submissions['late'] ?? 0) + ($submissions['marked'] ?? 0) + ($submissions['resubmission_required'] ?? 0);
        $expected = 0;
        foreach ($homeworks as $homework) {
            $expected += count($this->admittedStudents(['class_name' => $homework['class_name'], 'section' => $homework['section']]));
        }

        return [
            'total_homework' => $total,
            'published' => count(array_filter($homeworks, fn ($row) => $row['status'] === 'published')),
            'pending_submissions' => max(0, $expected - $submitted),
            'marked' => $submissions['marked'] ?? 0,
            'late' => $submissions['late'] ?? 0,
            'missed' => max(0, $expected - $submitted),
            'completion_rate' => $expected > 0 ? round(($submitted / $expected) * 100) : 0,
        ];
    }

    public function homeworkTeacherSummary(array $user): array
    {
        $homeworks = $this->homeworksForUser($user, []);
        $summary = [];
        foreach ($homeworks as $row) {
            $teacher = trim(($row['teacher_name'] ?? 'Unassigned') . ' ' . ($row['teacher_surname'] ?? ''));
            $summary[$teacher]['teacher'] = $teacher;
            $summary[$teacher]['homework'] = ($summary[$teacher]['homework'] ?? 0) + 1;
            $summary[$teacher]['submissions'] = ($summary[$teacher]['submissions'] ?? 0) + (int) ($row['submissions_count'] ?? 0);
            $summary[$teacher]['marked'] = ($summary[$teacher]['marked'] ?? 0) + (int) ($row['marked_count'] ?? 0);
        }
        return array_values($summary);
    }

    public function homeworkClassSummary(array $user): array
    {
        $summary = [];
        foreach ($this->homeworksForUser($user, []) as $row) {
            $key = $row['class_name'] . ' ' . $row['section'];
            $summary[$key]['class'] = $key;
            $summary[$key]['homework'] = ($summary[$key]['homework'] ?? 0) + 1;
            $summary[$key]['submissions'] = ($summary[$key]['submissions'] ?? 0) + (int) ($row['submissions_count'] ?? 0);
            $summary[$key]['late'] = ($summary[$key]['late'] ?? 0) + (int) ($row['late_count'] ?? 0);
        }
        return array_values($summary);
    }

    public function homeworkSubjectSummary(array $user): array
    {
        $summary = [];
        foreach ($this->homeworksForUser($user, []) as $row) {
            $subject = $row['subject_name'] ?: $row['subject'];
            $summary[$subject]['subject'] = $subject;
            $summary[$subject]['homework'] = ($summary[$subject]['homework'] ?? 0) + 1;
            $summary[$subject]['submissions'] = ($summary[$subject]['submissions'] ?? 0) + (int) ($row['submissions_count'] ?? 0);
        }
        return array_values($summary);
    }

    public function homeworkStudentSummary(array $user): array
    {
        $homeworks = $this->homeworksForUser($user, []);
        $rows = [];
        foreach ($homeworks as $homework) {
            foreach ($this->homeworkSubmissions((int) $homework['id']) as $submission) {
                $name = trim(($submission['first_name'] ?: $submission['applicant']) . ' ' . $submission['last_name']);
                $rows[$submission['student_id']]['student'] = $name;
                $rows[$submission['student_id']]['assigned'] = ($rows[$submission['student_id']]['assigned'] ?? 0) + 1;
                $rows[$submission['student_id']][$submission['status']] = ($rows[$submission['student_id']][$submission['status']] ?? 0) + 1;
                if ($submission['score'] !== null) {
                    $rows[$submission['student_id']]['score_total'] = ($rows[$submission['student_id']]['score_total'] ?? 0) + (float) $submission['score'];
                    $rows[$submission['student_id']]['score_count'] = ($rows[$submission['student_id']]['score_count'] ?? 0) + 1;
                }
            }
        }
        foreach ($rows as &$row) {
            $row['average_score'] = ($row['score_count'] ?? 0) > 0 ? round($row['score_total'] / $row['score_count'], 1) : 0;
        }
        return array_values($rows);
    }

    public function canDownloadHomeworkFile(string $path, array $user): bool
    {
        if ($path === '' || !str_starts_with($path, '/uploads/homework/')) {
            return false;
        }
        if (in_array($user['role'] ?? '', ['superadmin', 'admin'], true)) {
            return true;
        }
        if (($user['role'] ?? '') === 'teacher') {
            return true;
        }
        if (($user['role'] ?? '') === 'student') {
            return true;
        }
        return ($user['role'] ?? '') === 'parent';
    }

    private function homeworkSubmissionCounts(array $homeworkIds): array
    {
        if (!$homeworkIds) {
            return [];
        }
        $placeholders = implode(',', array_fill(0, count($homeworkIds), '?'));
        $statement = $this->pdo->prepare("SELECT status, COUNT(*) AS total FROM homework_submissions WHERE assignment_id IN ({$placeholders}) AND deleted_at = '' GROUP BY status");
        $statement->execute($homeworkIds);
        $counts = [];
        foreach ($statement->fetchAll() as $row) {
            $counts[$row['status']] = (int) $row['total'];
        }
        return $counts;
    }

    private function withHomeworkStudentStatus(array $row): array
    {
        if (!empty($row['submission_status'])) {
            $row['submission_status'] = strtolower((string) $row['submission_status']);
        }
        if (!empty($row['submission_status'])) {
            return $row;
        }
        $row['submission_status'] = strtotime($row['due_at'] ?: $row['due_date']) < time() ? 'missed' : 'pending';
        return $row;
    }

    private function logHomeworkSubmission(int $submissionId, int $userId, string $action, string $note = ''): void
    {
        if ($submissionId <= 0) {
            return;
        }
        $statement = $this->pdo->prepare('INSERT INTO homework_submission_logs (homework_submission_id, user_id, action, note, created_at) VALUES (?, ?, ?, ?, ?)');
        $statement->execute([$submissionId, $userId, $action, $note, date('Y-m-d H:i:s')]);
    }

    private function createHomeworkNotification(string $role, int $userId, string $title, string $message, int $homeworkId): void
    {
        $statement = $this->pdo->prepare('INSERT INTO homework_notifications (recipient_role, recipient_user_id, title, message, homework_id, created_at) VALUES (?, ?, ?, ?, ?, ?)');
        $statement->execute([$role, $userId, $title, $message, $homeworkId, date('Y-m-d H:i:s')]);
    }

    public function studentLoginAccounts(array $filters = []): array
    {
        return $this->admittedStudents($filters);
    }

    public function updateStudentPortalAccount(int $id, string $username, string $password = ''): void
    {
        $student = $this->admissionById($id);
        if (!$student) {
            return;
        }

        if ($password !== '') {
            $hash = password_hash($password, PASSWORD_DEFAULT);
            $statement = $this->pdo->prepare('UPDATE admissions SET username = ?, password = ? WHERE id = ?');
            $statement->execute([$username, $hash, $id]);
        } else {
            $hash = $student['password'];
            $statement = $this->pdo->prepare('UPDATE admissions SET username = ? WHERE id = ?');
            $statement->execute([$username, $id]);
        }

        $this->deleteUserByEmail($student['username']);
        if (($student['username'] ?? '') === '') {
            $this->deleteUserByEmail($student['email']);
        }

        if ($username !== '' && $hash !== '') {
            $statement = $this->pdo->prepare('REPLACE INTO users (name, email, password, role, status, created_at) VALUES (?, ?, ?, ?, ?, ?)');
            $statement->execute([$student['applicant'], $username, $hash, 'student', 'Active', date('Y-m-d')]);
        }
    }

    public function deleteStudentPortalAccount(int $id): void
    {
        $student = $this->admissionById($id);
        if (!$student) {
            return;
        }

        $this->deleteUserByEmail($student['username']);
        $this->deleteUserByEmail($student['email']);
        $statement = $this->pdo->prepare("UPDATE admissions SET username = '', password = '' WHERE id = ?");
        $statement->execute([$id]);
    }

    public function updateParentPortalAccount(int $id, string $username, string $password = ''): void
    {
        $student = $this->admissionById($id);
        if (!$student) {
            return;
        }

        if ($password !== '') {
            $hash = password_hash($password, PASSWORD_DEFAULT);
            $statement = $this->pdo->prepare('UPDATE admissions SET parent_username = ?, parent_password = ? WHERE id = ?');
            $statement->execute([$username, $hash, $id]);
        } else {
            $hash = $student['parent_password'] ?? '';
            $statement = $this->pdo->prepare('UPDATE admissions SET parent_username = ? WHERE id = ?');
            $statement->execute([$username, $id]);
        }

        $this->deleteUserByEmail($student['parent_username'] ?? '');
        if (($student['parent_username'] ?? '') === '') {
            $this->deleteUserByEmail($student['guardian_mobile']);
        }

        if ($username !== '' && $hash !== '') {
            $statement = $this->pdo->prepare('REPLACE INTO users (name, email, password, role, status, created_at) VALUES (?, ?, ?, ?, ?, ?)');
            $statement->execute([$student['guardian_full_name'] ?: $student['guardian'], $username, $hash, 'parent', 'Active', date('Y-m-d')]);
        }
    }

    public function deleteParentPortalAccount(int $id): void
    {
        $student = $this->admissionById($id);
        if (!$student) {
            return;
        }

        $this->deleteUserByEmail($student['parent_username'] ?? '');
        $this->deleteUserByEmail($student['guardian_mobile']);
        $statement = $this->pdo->prepare("UPDATE admissions SET parent_username = '', parent_password = '' WHERE id = ?");
        $statement->execute([$id]);
    }

    private function deleteUserByEmail(string $email): void
    {
        if ($email === '') {
            return;
        }

        $statement = $this->pdo->prepare('DELETE FROM users WHERE email = ?');
        $statement->execute([$email]);
    }

    private function passMark(): float
    {
        $statement = $this->pdo->query("SELECT COALESCE(MIN(min_mark), 40) FROM exam_grades WHERE grade_name <> 'F' AND min_mark > 0");

        return (float) $statement->fetchColumn();
    }

    private function gradeForMark(float $mark): string
    {
        foreach ($this->examGrades() as $grade) {
            if ($mark >= (float) $grade['min_mark'] && $mark <= (float) $grade['max_mark']) {
                return $grade['grade_name'];
            }
        }

        return '';
    }

    public function examScheduleById(int $id, array $user): ?array
    {
        foreach ($this->examSchedules($user) as $schedule) {
            if ((int) $schedule['id'] === $id) {
                return $schedule;
            }
        }

        return null;
    }

    public function deleteExamSchedule(int $id): void
    {
        if ($id <= 0) {
            return;
        }

        $statement = $this->pdo->prepare('DELETE FROM exam_schedules WHERE id = ?');
        $statement->execute([$id]);
    }

    public function marksheetTemplates(): array
    {
        return $this->pdo->query('SELECT * FROM marksheet_templates ORDER BY id DESC')->fetchAll();
    }

    public function marksheetTemplateById(int $id): ?array
    {
        $statement = $this->pdo->prepare('SELECT * FROM marksheet_templates WHERE id = ? LIMIT 1');
        $statement->execute([$id]);
        $row = $statement->fetch();

        return $row ?: null;
    }

    public function saveMarksheetTemplate(array $data, ?int $id = null): void
    {
        if (($data['name'] ?? '') === '') {
            return;
        }

        $fields = [
            'name', 'page_layout', 'photo_style', 'photo_size', 'top_space', 'bottom_space', 'right_space',
            'left_space', 'logo', 'background', 'left_signature', 'middle_signature', 'right_signature',
            'header_content', 'footer_content', 'attendance_percentage', 'grading_scale', 'position',
            'cumulative_average', 'class_average', 'subject_position', 'remark', 'result',
        ];

        if ($id) {
            $assignments = implode(', ', array_map(fn (string $field): string => "{$field} = ?", $fields));
            $statement = $this->pdo->prepare("UPDATE marksheet_templates SET {$assignments} WHERE id = ?");
            $values = array_map(fn (string $field) => $data[$field] ?? '', $fields);
            $values[] = $id;
            $statement->execute($values);
            return;
        }

        $fields[] = 'created_at';
        $data['created_at'] = date('Y-m-d');
        $placeholders = implode(', ', array_fill(0, count($fields), '?'));
        $statement = $this->pdo->prepare('INSERT INTO marksheet_templates (' . implode(', ', $fields) . ") VALUES ({$placeholders})");
        $statement->execute(array_map(fn (string $field) => $data[$field] ?? '', $fields));
    }

    public function deleteMarksheetTemplate(int $id): void
    {
        if ($id <= 0) {
            return;
        }

        $statement = $this->pdo->prepare('DELETE FROM marksheet_templates WHERE id = ?');
        $statement->execute([$id]);
    }

    public function moduleStats(string $key): array
    {
        return match ($key) {
            'students' => ['Total students' => $this->count('students'), 'Active' => $this->countWhere('students', 'status', 'Active')],
            'admissions' => ['Applications' => $this->count('admissions'), 'Accepted' => $this->countWhere('admissions', 'stage', 'Accepted')],
            'staff' => ['Team members' => $this->count('staff'), 'Active' => $this->countWhere('staff', 'status', 'Active')],
            'classes' => ['Classes' => $this->count('classes'), 'Capacity' => $this->sum('classes', 'capacity')],
            'attendance' => ['Present today' => $this->sum('attendance', 'present'), 'Absent today' => $this->sum('attendance', 'absent')],
            'fees' => ['Invoices' => $this->count('fees'), 'Revenue' => $this->sum('fees', 'amount')],
            'exams' => ['Exam plans' => $this->count('exams'), 'Scheduled' => $this->countWhere('exams', 'status', 'Scheduled')],
            'library' => ['Books' => $this->count('library_books'), 'Copies' => $this->sum('library_books', 'copies')],
            'transport' => ['Routes' => $this->count('transport_routes'), 'Assigned students' => $this->sum('transport_routes', 'students')],
            'hostel' => ['Rooms' => $this->count('hostel_rooms'), 'Occupied beds' => $this->sum('hostel_rooms', 'occupied')],
            default => [],
        };
    }

    public function createStudent(array $data): void
    {
        if ($data['name'] === '' || $data['student_no'] === '') {
            return;
        }

        $statement = $this->pdo->prepare('INSERT INTO students (student_no, name, class_name, guardian, status, created_at) VALUES (?, ?, ?, ?, ?, ?)');
        $statement->execute([$data['student_no'], $data['name'], $data['class_name'], $data['guardian'], $data['status'], date('Y-m-d')]);
    }

    public function createAdmission(array $data): void
    {
        if (($data['first_name'] ?? '') === '' || ($data['last_name'] ?? '') === '') {
            return;
        }

        $applicant = trim($data['first_name'] . ' ' . ($data['middle_name'] ?? '') . ' ' . $data['last_name']);
        $guardian = $data['guardian_full_name'] ?: ($data['father_name'] ?: $data['mother_name']);
        $password = $data['password'] !== '' ? password_hash($data['password'], PASSWORD_DEFAULT) : '';

        $fields = [
            'academic_year', 'school_term', 'registration_no', 'admission_date', 'applicant', 'class_name', 'section',
            'first_name', 'middle_name', 'last_name', 'date_of_birth', 'gender', 'religion', 'address', 'email', 'city', 'state',
            'profile_picture', 'username', 'password', 'parent_username', 'parent_password', 'mother_tongue', 'guardian', 'guardian_full_name',
            'guardian_relationship', 'father_name', 'mother_name', 'guardian_occupation', 'guardian_address',
            'guardian_city', 'guardian_state', 'guardian_mobile', 'guardian_picture', 'stage', 'created_at',
        ];
        $placeholders = implode(', ', array_fill(0, count($fields), '?'));
        $statement = $this->pdo->prepare('INSERT INTO admissions (' . implode(', ', $fields) . ") VALUES ({$placeholders})");
        $statement->execute([
            $data['academic_year'],
            $data['school_term'],
            $data['registration_no'],
            $data['admission_date'],
            $applicant,
            $data['class_name'],
            $data['section'],
            $data['first_name'],
            $data['middle_name'],
            $data['last_name'],
            $data['date_of_birth'],
            $data['gender'],
            $data['religion'],
            $data['address'],
            $data['email'],
            $data['city'],
            $data['state'],
            $data['profile_picture'],
            $data['username'],
            $password,
            $data['guardian_mobile'],
            $password,
            $data['mother_tongue'],
            $guardian,
            $data['guardian_full_name'],
            $data['guardian_relationship'],
            $data['father_name'],
            $data['mother_name'],
            $data['guardian_occupation'],
            $data['guardian_address'],
            $data['guardian_city'],
            $data['guardian_state'],
            $data['guardian_mobile'],
            $data['guardian_picture'],
            'Accepted',
            date('Y-m-d'),
        ]);

        $login = $data['username'] ?: $data['email'];
        if ($login !== '' && $password !== '') {
            $user = $this->pdo->prepare('REPLACE INTO users (name, email, password, role, status, created_at) VALUES (?, ?, ?, ?, ?, ?)');
            $user->execute([$applicant, $login, $password, 'student', 'Active', date('Y-m-d')]);
        }

        if (($data['guardian_mobile'] ?? '') !== '' && $password !== '') {
            $parent = $this->pdo->prepare('REPLACE INTO users (name, email, password, role, status, created_at) VALUES (?, ?, ?, ?, ?, ?)');
            $parent->execute([$guardian ?: 'Parent', $data['guardian_mobile'], $password, 'parent', 'Active', date('Y-m-d')]);
        }
    }

    public function createFee(array $data): void
    {
        if (($data['class_name'] ?? '') === '' || ($data['invoice_no'] ?? '') === '') {
            return;
        }

        $statement = $this->pdo->prepare(
            'INSERT INTO fees (invoice_no, student_name, class_name, school_term, school_session, amount, status, created_at)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?)'
        );
        $statement->execute([
            $data['invoice_no'],
            $data['class_name'],
            $data['class_name'],
            $data['school_term'],
            $data['school_session'],
            $data['amount'],
            $data['status'],
            date('Y-m-d'),
        ]);
    }

    public function createFeeReminder(array $data): void
    {
        if (($data['class_name'] ?? '') === '' || ($data['message'] ?? '') === '') {
            return;
        }

        $statement = $this->pdo->prepare(
            'INSERT INTO fee_reminders (class_name, school_term, school_session, due_date, audience, message, communication_status, created_at)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?)'
        );
        $statement->execute([
            $data['class_name'],
            $data['school_term'],
            $data['school_session'],
            $data['due_date'],
            $data['audience'] ?: 'Parents',
            $data['message'],
            $data['communication_status'] ?: 'Draft',
            date('Y-m-d'),
        ]);

        $announcement = $this->pdo->prepare('INSERT INTO announcements (title, audience, publish_date) VALUES (?, ?, ?)');
        $announcement->execute([
            'Fee reminder draft: ' . $data['class_name'] . ' ' . $data['school_term'],
            'Communication Draft',
            date('Y-m-d'),
        ]);
    }

    public function createOfficeTransaction(array $data): void
    {
        if (($data['title'] ?? '') === '' || (float) ($data['amount'] ?? 0) <= 0) {
            return;
        }

        $type = in_array($data['type'] ?? '', ['Income', 'Expenditure'], true) ? $data['type'] : 'Income';
        $statement = $this->pdo->prepare(
            'INSERT INTO office_transactions (type, account_name, category, title, amount, payment_method, reference_no, transaction_date, note, created_at)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)'
        );
        $statement->execute([
            $type,
            $data['account_name'] ?: 'Main Account',
            $data['category'],
            $data['title'],
            (float) $data['amount'],
            $data['payment_method'],
            $data['reference_no'],
            $data['transaction_date'] ?: date('Y-m-d'),
            $data['note'],
            date('Y-m-d'),
        ]);
    }

    public function deleteOfficeTransaction(int $id): void
    {
        if ($id <= 0) {
            return;
        }

        $statement = $this->pdo->prepare('DELETE FROM office_transactions WHERE id = ?');
        $statement->execute([$id]);
    }

    private function count(string $table): int
    {
        return (int) $this->pdo->query("SELECT COUNT(*) FROM {$table}")->fetchColumn();
    }

    private function countWhere(string $table, string $column, string $value): int
    {
        $statement = $this->pdo->prepare("SELECT COUNT(*) FROM {$table} WHERE {$column} = ?");
        $statement->execute([$value]);

        return (int) $statement->fetchColumn();
    }

    private function sum(string $table, string $column): float
    {
        return (float) $this->pdo->query("SELECT COALESCE(SUM({$column}), 0) FROM {$table}")->fetchColumn();
    }

    private function sumOfficeTransactions(string $type): float
    {
        $statement = $this->pdo->prepare('SELECT COALESCE(SUM(amount), 0) FROM office_transactions WHERE type = ?');
        $statement->execute([$type]);

        return (float) $statement->fetchColumn();
    }
}
