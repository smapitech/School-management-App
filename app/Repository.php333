    {
        return $this->settings();
    }

    public function getUiThemeSettings(): array
    {
        return ui_theme_from_settings($this->settings());
    }

    public function saveUiThemeSettings(array $data): void
    {
        $settings = [];
        foreach (ui_theme_default_colors() as $key => $fallback) {
            $settings['ui_' . $key] = normalize_hex_color($data[$key] ?? $fallback, $fallback);
        }
        $preset = (string) ($data['theme_preset'] ?? 'custom');
        $settings['ui_theme_preset'] = array_key_exists($preset, ui_theme_presets()) ? $preset : 'custom';
        $this->updateSettings($settings);
    }

    public function resetUiThemeSettingsToDefault(): void
    {
        $settings = ['ui_theme_preset' => 'gmail_material'];
        foreach (ui_theme_default_colors() as $key => $value) {
            $settings['ui_' . $key] = $value;
        }
        $this->updateSettings($settings);
    }

    public function getWebsiteSettings(): array
    {
        $this->ensureWebsiteSettings();
        $row = $this->pdo->query('SELECT * FROM website_settings ORDER BY id ASC LIMIT 1')->fetch() ?: [];
        $row['active_template'] = array_key_exists($row['active_template'] ?? '', getAvailableWebsiteTemplates()) ? $row['active_template'] : 'classic';

        return $row;
    }

    public function ensureWebsiteSettings(): void
    {
        if ((int) $this->pdo->query('SELECT COUNT(*) FROM website_settings')->fetchColumn() === 0) {
            $statement = $this->pdo->prepare('INSERT INTO website_settings (active_template, site_title, footer_text, created_at) VALUES (?, ?, ?, ?)');
            $statement->execute(['classic', 'Smapis School Portal', 'Building knowledge, character, and confidence.', date('Y-m-d H:i:s')]);
        }
    }

    public function updateWebsiteSettings(array $data): void
    {
        $this->ensureWebsiteSettings();
        $current = $this->getWebsiteSettings();
        $statement = $this->pdo->prepare(
            'UPDATE website_settings SET active_template = ?, site_title = ?, meta_description = ?, meta_keywords = ?, og_title = ?, og_description = ?, og_image = ?, school_logo = ?, favicon = ?, footer_text = ?, show_teacher_phone = ?, show_teacher_email = ?, updated_at = ? WHERE id = ?'
        );
        $statement->execute([
            array_key_exists($data['active_template'] ?? ($current['active_template'] ?? 'classic'), getAvailableWebsiteTemplates()) ? ($data['active_template'] ?? $current['active_template']) : 'classic',
            $data['site_title'] ?? ($current['site_title'] ?? ''),
            $data['meta_description'] ?? ($current['meta_description'] ?? ''),
            $data['meta_keywords'] ?? ($current['meta_keywords'] ?? ''),
            $data['og_title'] ?? ($current['og_title'] ?? ''),
            $data['og_description'] ?? ($current['og_description'] ?? ''),
            $data['og_image'] ?? ($current['og_image'] ?? ''),
            $data['school_logo'] ?? ($current['school_logo'] ?? ''),
            $data['favicon'] ?? ($current['favicon'] ?? ''),
            $data['footer_text'] ?? ($current['footer_text'] ?? ''),
            (int) ($data['show_teacher_phone'] ?? $current['show_teacher_phone'] ?? 0),
            (int) ($data['show_teacher_email'] ?? $current['show_teacher_email'] ?? 1),
            date('Y-m-d H:i:s'),
            (int) $current['id'],
        ]);
    }

