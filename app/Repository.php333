    public function feeSummary(): array
    {
        $rows = $this->pdo->query('SELECT status, SUM(amount) AS total FROM fees GROUP BY status')->fetchAll();
        $summary = ['Paid' => 0, 'Partial' => 0, 'Unpaid' => 0];

        foreach ($rows as $row) {
            $summary[$row['status']] = (float) $row['total'];
        }

        return $summary;
    }

    public function fees(array $filters = []): array
    {
        $where = [];
        $params = [];

        if (!empty($filters['status'])) {
            $where[] = 'status = ?';
            $params[] = $filters['status'];
        }

        if (!empty($filters['class_name'])) {
            $where[] = 'class_name = ?';
            $params[] = $filters['class_name'];
        }

        if (!empty($filters['school_term'])) {
            $where[] = 'school_term = ?';
            $params[] = $filters['school_term'];
        }

        if (!empty($filters['school_session'])) {
            $where[] = 'school_session = ?';
            $params[] = $filters['school_session'];
        }

        $sql = 'SELECT * FROM fees';
        if ($where) {
            $sql .= ' WHERE ' . implode(' AND ', $where);
        }
        $sql .= ' ORDER BY id DESC';

        $statement = $this->pdo->prepare($sql);
        $statement->execute($params);

        return $statement->fetchAll();
    }

    public function accountingSummary(): array
    {
        $studentIncome = (float) $this->pdo->query("SELECT COALESCE(SUM(amount), 0) FROM fees WHERE status IN ('Paid', 'Partial')")->fetchColumn();
        $officeIncome = $this->sumOfficeTransactions('Income');
        $expenditure = $this->sumOfficeTransactions('Expenditure');
        $totalIncome = $studentIncome + $officeIncome;

        return [
            'student_income' => $studentIncome,
            'office_income' => $officeIncome,
            'total_income' => $totalIncome,
            'expenditure' => $expenditure,
            'net_balance' => $totalIncome - $expenditure,
        ];
    }

    public function officeTransactions(array $filters = [], int $limit = 0): array
    {
        $where = [];
        $params = [];

        if (!empty($filters['type'])) {
            $where[] = 'type = ?';
            $params[] = $filters['type'];
        }

        if (!empty($filters['category'])) {
            $where[] = 'category LIKE ?';
            $params[] = '%' . $filters['category'] . '%';
        }

        $sql = 'SELECT * FROM office_transactions';
        if ($where) {
            $sql .= ' WHERE ' . implode(' AND ', $where);
        }
        $sql .= ' ORDER BY transaction_date DESC, id DESC';

        if ($limit > 0) {
            $sql .= ' LIMIT ' . $limit;
        }

        $statement = $this->pdo->prepare($sql);
        $statement->execute($params);

        return $statement->fetchAll();
    }

    public function feeReminders(): array
    {
        return $this->pdo->query('SELECT * FROM fee_reminders ORDER BY id DESC LIMIT 8')->fetchAll();
    }

    public function attendanceSummary(): array
    {
        $row = $this->pdo->query(
            "SELECT
                SUM(CASE WHEN status = 'Present' THEN 1 ELSE 0 END) AS present,
                SUM(CASE WHEN status = 'Absent' THEN 1 ELSE 0 END) AS absent
            FROM student_attendance"
        )->fetch();
        $present = (int) ($row['present'] ?? 0);
        $absent = (int) ($row['absent'] ?? 0);
        $total = max(1, $present + $absent);

        return [
            'present' => $present,
            'absent' => $absent,
            'rate' => round(($present / $total) * 100),
        ];
    }

    public function attendanceOverview(): array
    {
        $student = $this->attendanceStatusCounts('student_attendance');
        $staff = $this->attendanceStatusCounts('staff_attendance');

        return [
            'student' => $student,
            'staff' => $staff,
            'student_total' => array_sum($student),
            'staff_total' => array_sum($staff),
        ];
    }

    private function attendanceStatusCounts(string $table): array
    {
        $rows = $this->pdo->query("SELECT status, COUNT(*) AS total FROM {$table} GROUP BY status")->fetchAll();
        $counts = ['Present' => 0, 'Absent' => 0, 'Late' => 0, 'Half Day' => 0, 'Excused' => 0];

        foreach ($rows as $row) {
            $counts[$row['status']] = (int) $row['total'];
        }

        return $counts;
    }

    public function studentAttendanceRecords(string $date, array $studentIds): array
    {
        if ($date === '' || !$studentIds) {
            return [];
        }

        $placeholders = implode(',', array_fill(0, count($studentIds), '?'));
        $statement = $this->pdo->prepare("SELECT * FROM student_attendance WHERE attendance_date = ? AND student_id IN ({$placeholders})");
        $statement->execute(array_merge([$date], array_map('intval', $studentIds)));
        $records = [];

        foreach ($statement->fetchAll() as $row) {
            $records[(int) $row['student_id']] = $row;
        }

        return $records;
    }

    public function saveStudentAttendance(array $data): void
    {
        $statement = $this->pdo->prepare(
            'REPLACE INTO student_attendance (student_id, class_name, section, attendance_date, status, remark, created_at)
            VALUES (?, ?, ?, ?, ?, ?, ?)'
        );

        if (!isset($data['rows']) && !empty($data['student_id'])) {
            $statement->execute([
                (int) $data['student_id'],
                trim((string) ($data['class_name'] ?? '')),
                trim((string) ($data['section'] ?? '')),
                trim((string) ($data['attendance_date'] ?? date('Y-m-d'))),
                $this->normalizeAttendanceStatus((string) ($data['status'] ?? 'Present')),
                trim((string) ($data['remark'] ?? '')),
                date('Y-m-d'),
            ]);

            return;
        }

        foreach ((array) ($data['rows'] ?? []) as $studentId => $row) {
            $statement->execute([
                (int) $studentId,
                $data['class_name'],
                $data['section'],
                $data['attendance_date'],
                $this->normalizeAttendanceStatus($row['status'] ?? 'Present'),
                trim($row['remark'] ?? ''),
                date('Y-m-d'),
            ]);
        }
    }

    public function staffAttendanceRecords(string $date, array $staffIds): array
    {
        if ($date === '' || !$staffIds) {
            return [];
        }

        $placeholders = implode(',', array_fill(0, count($staffIds), '?'));
        $statement = $this->pdo->prepare("SELECT * FROM staff_attendance WHERE attendance_date = ? AND staff_id IN ({$placeholders})");
        $statement->execute(array_merge([$date], array_map('intval', $staffIds)));
        $records = [];

        foreach ($statement->fetchAll() as $row) {
            $records[(int) $row['staff_id']] = $row;
        }

        return $records;
    }

    public function saveStaffAttendance(array $data): void
    {
        $statement = $this->pdo->prepare(
            'REPLACE INTO staff_attendance (staff_id, role, attendance_date, clock_in, clock_out, status, remark, note, marked_by, created_at, updated_at)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)'
        );

        foreach ((array) ($data['rows'] ?? []) as $staffId => $row) {
            $remark = trim((string) ($row['remark'] ?? $row['note'] ?? ''));
            $note = trim((string) ($row['note'] ?? $row['remark'] ?? ''));
            $clockIn = trim((string) ($row['clock_in'] ?? ''));
            $clockOut = trim((string) ($row['clock_out'] ?? ''));

            $statement->execute([
                (int) $staffId,
                $data['role'],
                $data['attendance_date'],
                $clockIn !== '' ? $clockIn : null,
                $clockOut !== '' ? $clockOut : null,
                $this->normalizeAttendanceStatus($row['status'] ?? 'Present'),
                $remark,
                $note !== '' ? $note : $remark,
                !empty($data['marked_by']) ? (int) $data['marked_by'] : null,
                date('Y-m-d'),
                date('Y-m-d H:i:s'),
            ]);
        }
    }

    public function getTeacherStaffAttendance(int $staffId, array $filters = []): array
    {
        if ($staffId <= 0) {
            return [];
        }

        $where = ['staff_id = ?'];
        $params = [$staffId];
        $attendanceDate = trim((string) ($filters['attendance_date'] ?? ''));
        $month = trim((string) ($filters['month'] ?? ''));
        $status = trim((string) ($filters['status'] ?? ''));

        if ($attendanceDate !== '' && preg_match('/^\d{4}-\d{2}-\d{2}$/', $attendanceDate)) {
            $where[] = 'attendance_date = ?';
            $params[] = $attendanceDate;
        } else {
            if ($month === '' || !preg_match('/^\d{4}-\d{2}$/', $month)) {
                $month = date('Y-m');
            }

            $where[] = 'attendance_date LIKE ?';
            $params[] = $month . '%';
        }

        if ($status !== '') {
            $where[] = 'LOWER(status) = LOWER(?)';
            $params[] = $status;
        }

        $statement = $this->pdo->prepare(
            'SELECT id, staff_id, attendance_date, clock_in, clock_out, status, remark, note, COALESCE(NULLIF(note, \'\'), remark) AS note_text, marked_by, created_at, updated_at
            FROM staff_attendance
            WHERE ' . implode(' AND ', $where) . '
            ORDER BY attendance_date DESC, id DESC'
        );
        $statement->execute($params);

        return $statement->fetchAll();
    }

    public function getTeacherStaffAttendanceSummary(int $staffId): array
    {
        $month = date('Y-m');
        $summary = [
            'month' => $month,
            'total' => 0,
            'Present' => 0,
            'Absent' => 0,
            'Late' => 0,
            'Excused' => 0,
            'Leave' => 0,
            'Half Day' => 0,
            'Other' => 0,
        ];

        if ($staffId <= 0) {
            return $summary;
        }

        $statement = $this->pdo->prepare(
            'SELECT LOWER(status) AS status_key, COUNT(*) AS total
            FROM staff_attendance
            WHERE staff_id = ? AND attendance_date LIKE ?
            GROUP BY LOWER(status)'
        );
        $statement->execute([$staffId, $month . '%']);

        foreach ($statement->fetchAll() as $row) {
            $count = (int) ($row['total'] ?? 0);
            $summary['total'] += $count;

            switch ((string) ($row['status_key'] ?? '')) {
                case 'present':
                    $summary['Present'] += $count;
                    break;
                case 'absent':
                    $summary['Absent'] += $count;
                    break;
                case 'late':
                    $summary['Late'] += $count;
                    break;
                case 'excused':
                    $summary['Excused'] += $count;
                    break;
                case 'leave':
                    $summary['Leave'] += $count;
                    break;
                case 'half day':
                case 'half-day':
                case 'halfday':
                    $summary['Half Day'] += $count;
                    break;
                default:
                    $summary['Other'] += $count;
                    break;
            }
        }

        return $summary;
    }

    public function getTeacherAttendanceSummary(int $staffId): array
    {
        return $this->getTeacherStaffAttendanceSummary($staffId);
    }

    public function getTeacherAttendanceClasses(int $teacherId): array
    {
        if ($teacherId <= 0) {
            return [];
        }

        $classes = [];
        foreach ($this->getTeacherAssignedClasses($teacherId) as $row) {
            $classId = (int) ($row['class_id'] ?? 0);
            $className = trim((string) ($row['class_name'] ?? ''));
            if ($classId <= 0 || $className === '') {
                continue;
            }

            if (!isset($classes[$classId])) {
                $classes[$classId] = [
                    'class_id' => $classId,
                    'class_name' => $className,
                    'sections' => [],
                    'allow_all_sections' => false,
                    'subject_count' => 0,
                    'student_count' => 0,
                ];
            }

            $section = trim((string) ($row['section'] ?? ''));
            if ($section === '') {
                $classes[$classId]['allow_all_sections'] = true;
            } else {
                $classes[$classId]['sections'][$section] = $section;
            }
        }

        $subjectCounts = [];
        foreach ($this->getTeacherAssignedSubjects($teacherId) as $subject) {
            $classId = (int) ($subject['class_id'] ?? 0);
            $subjectId = (int) ($subject['subject_id'] ?? 0);
            if ($classId > 0 && $subjectId > 0) {
                $subjectCounts[$classId][$subjectId] = true;
            }
        }

        foreach ($classes as $classId => $row) {
            $classes[$classId]['sections'] = array_values($row['sections']);
            sort($classes[$classId]['sections']);
            $classes[$classId]['subject_count'] = count($subjectCounts[$classId] ?? []);
            $classes[$classId]['student_count'] = count($this->getStudentsForTeacherAttendance($teacherId, $classId));
        }

        return array_values($classes);
    }

    public function getStudentsForTeacherAttendance(int $teacherId, int $classId): array
    {
        if ($teacherId <= 0 || $classId <= 0) {
            return [];
        }

        return array_values($this->teacherAttendanceStudentMap($teacherId, $classId));
    }

    public function teacherCanMarkStudentAttendance(int $teacherId, int $studentId): bool
    {
        return $this->teacherCanAccessStudent($teacherId, $studentId);
    }

    public function saveTeacherStudentAttendance(int $teacherId, int $classId, string $date, array $attendanceData): void
    {
        if ($teacherId <= 0) {
            throw new \RuntimeException('Teacher access could not be resolved.');
        }

        if ($classId <= 0) {
            throw new \InvalidArgumentException('Class is required.');
        }

        if (!$this->teacherCanAccessClass($teacherId, $classId)) {
            throw new \RuntimeException('You can only mark attendance for assigned classes.');
        }

        if (!$this->isValidAttendanceDate($date)) {
            throw new \InvalidArgumentException('A valid attendance date is required.');
        }

        $students = $this->teacherAttendanceStudentMap($teacherId, $classId);
        if (!$students) {
            throw new \RuntimeException('No assigned students were found for the selected class.');
        }

        if (!$attendanceData) {
            throw new \InvalidArgumentException('Load students before saving attendance.');
        }

        $statement = $this->pdo->prepare(
            'REPLACE INTO student_attendance (student_id, class_name, section, attendance_date, status, remark, created_at)
            VALUES (?, ?, ?, ?, ?, ?, ?)'
        );

        $ownsTransaction = !$this->pdo->inTransaction();
        if ($ownsTransaction) {
            $this->pdo->beginTransaction();
        }

        try {
            foreach ($attendanceData as $studentId => $row) {
                $studentId = (int) $studentId;
                if ($studentId <= 0 || !isset($students[$studentId])) {
                    throw new \RuntimeException('You can only mark attendance for students assigned to your class.');
                }

                $rawStatus = (string) ($row['status'] ?? '');
                if (!$this->isRecognizedAttendanceStatus($rawStatus, ['Present', 'Absent', 'Late', 'Excused'])) {
                    throw new \InvalidArgumentException('Attendance status is invalid.');
                }

                $student = $students[$studentId];
                $statement->execute([
                    $studentId,
                    trim((string) ($student['class_name'] ?? '')),
                    trim((string) ($student['section'] ?? '')),
                    $date,
                    $this->normalizeAttendanceStatus($rawStatus),
                    trim((string) ($row['remark'] ?? $row['note'] ?? '')),
                    date('Y-m-d'),
                ]);
            }

            if ($ownsTransaction && $this->pdo->inTransaction()) {
                $this->pdo->commit();
            }
        } catch (\Throwable $exception) {
            if ($ownsTransaction && $this->pdo->inTransaction()) {
                $this->pdo->rollBack();
            }

            throw $exception;
        }
    }

    public function getTeacherAttendanceHistory(int $teacherId, array $filters = []): array
    {
        if ($teacherId <= 0) {
            return [];
        }

        $studentIds = $this->getTeacherAssignedStudentIds($teacherId);
        if (!$studentIds) {
            return [];
        }

        $placeholders = implode(',', array_fill(0, count($studentIds), '?'));
        $sql = "SELECT sa.*, a.applicant, a.first_name, a.middle_name, a.last_name, a.registration_no, a.profile_picture
            FROM student_attendance sa
            INNER JOIN admissions a ON a.id = sa.student_id
            WHERE sa.student_id IN ({$placeholders})";
        $params = array_map('intval', $studentIds);

        $classId = (int) ($filters['class_id'] ?? 0);
        if ($classId > 0) {
            $scope = $this->teacherAttendanceClassScope($teacherId, $classId);
            if (!$scope) {
                return [];
            }

            $sql .= ' AND sa.class_name = ?';
            $params[] = $scope['class_name'];

            if (!$scope['allow_all_sections'] && !empty($scope['sections'])) {
                $sectionPlaceholders = implode(',', array_fill(0, count($scope['sections']), '?'));
                $sql .= " AND sa.section IN ({$sectionPlaceholders})";
                $params = array_merge($params, $scope['sections']);
            }
        }

        $attendanceDate = trim((string) ($filters['attendance_date'] ?? ''));
        if ($attendanceDate !== '') {
            if (!$this->isValidAttendanceDate($attendanceDate)) {
                return [];
            }
            $sql .= ' AND sa.attendance_date = ?';
            $params[] = $attendanceDate;
        }

        $status = trim((string) ($filters['status'] ?? ''));
        if ($status !== '') {
            if (!$this->isRecognizedAttendanceStatus($status)) {
                return [];
            }
            $sql .= ' AND sa.status = ?';
            $params[] = $this->normalizeAttendanceStatus($status);
        }

        $sql .= ' ORDER BY sa.attendance_date DESC, sa.class_name ASC, sa.section ASC, a.applicant ASC, a.first_name ASC, a.last_name ASC';
        $statement = $this->pdo->prepare($sql);
        $statement->execute($params);

        return $statement->fetchAll();
    }

    public function getStudentAttendanceForTeacher(int $teacherId, int $studentId): array
    {
        if (!$this->teacherCanAccessStudent($teacherId, $studentId)) {
            return [];
        }

        $statement = $this->pdo->prepare(
            'SELECT * FROM student_attendance WHERE student_id = ? ORDER BY attendance_date DESC, id DESC'
        );
        $statement->execute([$studentId]);

        return $statement->fetchAll();
    }

    private function teacherAttendanceClassScope(int $teacherId, int $classId): ?array
    {
        if ($teacherId <= 0 || $classId <= 0) {
            return null;
        }

        $assignments = array_values(array_filter(
            $this->getTeacherAssignedClasses($teacherId),
            fn (array $row): bool => (int) ($row['class_id'] ?? 0) === $classId
        ));

        if (!$assignments) {
            return null;
        }

        $scope = [
            'class_id' => $classId,
            'class_name' => trim((string) ($assignments[0]['class_name'] ?? '')),
            'sections' => [],
            'allow_all_sections' => false,
        ];

        foreach ($assignments as $assignment) {
            $section = trim((string) ($assignment['section'] ?? ''));
            if ($section === '') {
                $scope['allow_all_sections'] = true;
                continue;
            }

            $scope['sections'][$section] = $section;
        }

        $scope['sections'] = array_values($scope['sections']);
        sort($scope['sections']);

        if ($scope['class_name'] === '') {
            $class = $this->classById($classId);
            $scope['class_name'] = trim((string) ($class['name'] ?? ''));
        }

        return $scope['class_name'] !== '' ? $scope : null;
    }

    private function teacherAttendanceStudentMap(int $teacherId, int $classId): array
    {
        $scope = $this->teacherAttendanceClassScope($teacherId, $classId);
        if (!$scope) {
            return [];
        }

        $students = [];
        foreach ($this->getTeacherAssignedStudents($teacherId) as $student) {
            if (($student['class_name'] ?? '') !== $scope['class_name']) {
                continue;
            }

            $section = trim((string) ($student['section'] ?? ''));
            if (!$scope['allow_all_sections'] && $scope['sections'] && !in_array($section, $scope['sections'], true)) {
                continue;
            }

            $students[(int) $student['id']] = $student;
        }

        uasort($students, function (array $left, array $right): int {
            return strcasecmp($this->attendanceDisplayName($left), $this->attendanceDisplayName($right));
        });

        return $students;
    }

    private function normalizeAttendanceStatus(string $status): string
    {
        $key = strtolower(trim($status));

        return $this->attendanceStatusLookup()[$key] ?? 'Present';
    }

    private function isRecognizedAttendanceStatus(string $status, array $allowed = []): bool
    {
        $key = strtolower(trim($status));
        if (!isset($this->attendanceStatusLookup()[$key])) {
            return false;
        }

        if (!$allowed) {
            return true;
        }

        return in_array($this->attendanceStatusLookup()[$key], $allowed, true);
    }

    private function attendanceStatusLookup(): array
    {
        return [
            'present' => 'Present',
            'absent' => 'Absent',
            'late' => 'Late',
            'half day' => 'Half Day',
            'half-day' => 'Half Day',
            'halfday' => 'Half Day',
            'excused' => 'Excused',
        ];
    }

    private function attendanceDisplayName(array $student): string
    {
        $firstName = trim((string) ($student['first_name'] ?? ''));
        if ($firstName === '') {
            $firstName = trim((string) ($student['applicant'] ?? ''));
        }

        return trim($firstName . ' ' . ($student['middle_name'] ?? '') . ' ' . ($student['last_name'] ?? ''));
    }

    private function isValidAttendanceDate(string $date): bool
    {
        if (!preg_match('/^\d{4}-\d{2}-\d{2}$/', $date)) {
            return false;
        }

        $parsed = \DateTime::createFromFormat('Y-m-d', $date);

        return $parsed instanceof \DateTime && $parsed->format('Y-m-d') === $date;
    }

    public function moduleRows(string $key): array
    {
        return match ($key) {
            'students' => $this->students(),
            'admissions' => $this->pdo->query('SELECT * FROM admissions ORDER BY id DESC')->fetchAll(),
            'staff' => $this->pdo->query('SELECT * FROM staff ORDER BY id DESC')->fetchAll(),
            'classes' => $this->pdo->query('SELECT * FROM classes ORDER BY id DESC')->fetchAll(),
            'attendance' => $this->pdo->query('SELECT * FROM attendance ORDER BY date DESC')->fetchAll(),
            'fees' => $this->pdo->query('SELECT * FROM fees ORDER BY id DESC')->fetchAll(),
            'exams' => $this->pdo->query('SELECT * FROM exams ORDER BY exam_date DESC')->fetchAll(),
            'library' => $this->pdo->query('SELECT * FROM library_books ORDER BY id DESC')->fetchAll(),
            'transport' => $this->pdo->query('SELECT * FROM transport_routes ORDER BY id DESC')->fetchAll(),
            'hostel' => $this->pdo->query('SELECT * FROM hostel_rooms ORDER BY id DESC')->fetchAll(),
            'communication' => $this->announcements(),
            default => [],
        };
    }

    public function admissions(?string $className = null): array
    {
        if ($className) {
            $statement = $this->pdo->prepare('SELECT * FROM admissions WHERE class_name = ? ORDER BY id DESC');
            $statement->execute([$className]);

            return $statement->fetchAll();
        }

        return $this->pdo->query('SELECT * FROM admissions ORDER BY id DESC')->fetchAll();
    }

    public function admittedStudents(array $filters = []): array
    {
        $where = [];
        $params = [];

        if (!empty($filters['class_name'])) {
            $where[] = 'class_name = ?';
            $params[] = $filters['class_name'];
        }

        if (!empty($filters['section'])) {
            $where[] = 'section = ?';
            $params[] = $filters['section'];
        }

        if (!empty($filters['name'])) {
            $where[] = '(first_name LIKE ? OR middle_name LIKE ? OR last_name LIKE ? OR applicant LIKE ?)';
            $name = '%' . $filters['name'] . '%';
            array_push($params, $name, $name, $name, $name);
        }

        if (!empty($filters['registration_no'])) {
            $where[] = 'registration_no LIKE ?';
            $params[] = '%' . $filters['registration_no'] . '%';
        }

        $sql = 'SELECT * FROM admissions';

        if ($where) {
            $sql .= ' WHERE ' . implode(' AND ', $where);
        }

        $sql .= ' ORDER BY class_name ASC, section ASC, last_name ASC, first_name ASC';
        $statement = $this->pdo->prepare($sql);
        $statement->execute($params);

        return $statement->fetchAll();
    }

    public function nextAdmissionNumber(): string
    {
        $next = ((int) $this->pdo->query('SELECT COUNT(*) FROM admissions')->fetchColumn()) + 1;

        return 'ADM-' . date('Y') . '-' . str_pad((string) $next, 5, '0', STR_PAD_LEFT);
    }

    public function staffRoles(): array
    {
        return ['Admin', 'Teacher', 'Asst Teacher', 'Accountant', 'Receptionist'];
    }

    public function attendanceStaffRoles(): array
    {
        $roles = $this->staffRoles();
        $rows = $this->pdo->query("SELECT DISTINCT role FROM staff WHERE role <> '' ORDER BY role ASC")->fetchAll();

        foreach ($rows as $row) {
            if (!in_array($row['role'], $roles, true)) {
                $roles[] = $row['role'];
            }
        }

        return $roles;
    }

    public function staff(array $filters = []): array
    {
        $where = [];
        $params = [];

        if (!empty($filters['role'])) {
            $where[] = 'role = ?';
            $params[] = $filters['role'];
        }

        if (!empty($filters['employee_no'])) {
            $where[] = 'employee_no LIKE ?';
            $params[] = '%' . $filters['employee_no'] . '%';
        }

        $sql = 'SELECT * FROM staff';
        if ($where) {
            $sql .= ' WHERE ' . implode(' AND ', $where);
        }
        $sql .= ' ORDER BY role ASC, name ASC';

        $statement = $this->pdo->prepare($sql);
        $statement->execute($params);

        return $statement->fetchAll();
    }

    public function staffById(int $id): ?array
    {
        $statement = $this->pdo->prepare('SELECT * FROM staff WHERE id = ? LIMIT 1');
        $statement->execute([$id]);
        $row = $statement->fetch();

        return $row ?: null;
    }

    public function nextStaffId(): string
    {
        $next = ((int) $this->pdo->query('SELECT COUNT(*) FROM staff')->fetchColumn()) + 1;

        return 'STF-' . date('Y') . '-' . str_pad((string) $next, 4, '0', STR_PAD_LEFT);
    }

    public function designations(): array
    {
        return $this->pdo->query('SELECT * FROM designations ORDER BY name ASC')->fetchAll();
    }

    public function designationById(int $id): ?array
    {
        $statement = $this->pdo->prepare('SELECT * FROM designations WHERE id = ? LIMIT 1');
        $statement->execute([$id]);
        $row = $statement->fetch();

        return $row ?: null;
    }

    public function saveDesignation(string $name, ?int $id = null): void
    {
        if ($name === '') {
            return;
        }

        if ($id) {
            $statement = $this->pdo->prepare('UPDATE designations SET name = ? WHERE id = ?');
            $statement->execute([$name, $id]);
            return;
        }

        $statement = $this->pdo->prepare('INSERT INTO designations (name, created_at) VALUES (?, ?)');
        $statement->execute([$name, date('Y-m-d')]);
    }

    public function deleteDesignation(int $id): void
    {
        $statement = $this->pdo->prepare('DELETE FROM designations WHERE id = ?');
        $statement->execute([$id]);
    }

    public function saveStaff(array $data, ?int $id = null): void
    {
        if (($data['name'] ?? '') === '' || ($data['employee_no'] ?? '') === '') {
            return;
        }

        $fields = [
            'employee_no', 'name', 'middle_name', 'surname', 'role', 'joining_date', 'designation',
            'qualification', 'experience_details', 'gender', 'religion', 'date_of_birth', 'mobile_no',
            'address', 'email', 'staff_photo', 'username', 'password', 'bank_name', 'account_name',
            'account_number', 'department', 'status',
        ];

        if ($id) {
            $assignments = implode(', ', array_map(fn (string $field): string => "{$field} = ?", $fields));
            $statement = $this->pdo->prepare("UPDATE staff SET {$assignments} WHERE id = ?");
            $values = array_map(fn (string $field) => $data[$field] ?? '', $fields);
            $values[] = $id;
            $statement->execute($values);
            return;
        }

        $placeholders = implode(', ', array_fill(0, count($fields), '?'));
        $statement = $this->pdo->prepare('INSERT INTO staff (' . implode(', ', $fields) . ") VALUES ({$placeholders})");
        $statement->execute(array_map(fn (string $field) => $data[$field] ?? '', $fields));
    }

    public function deleteStaff(int $id): void
    {
        $statement = $this->pdo->prepare('DELETE FROM staff WHERE id = ?');
        $statement->execute([$id]);
    }

    public function updateStaffAccount(int $id, string $username, string $password = ''): void
    {
        if ($password !== '') {
            $statement = $this->pdo->prepare('UPDATE staff SET username = ?, password = ? WHERE id = ?');
            $statement->execute([$username, password_hash($password, PASSWORD_DEFAULT), $id]);
            return;
        }

        $statement = $this->pdo->prepare('UPDATE staff SET username = ? WHERE id = ?');
        $statement->execute([$username, $id]);
    }

    public function deleteStaffAccount(int $id): void
    {
        $statement = $this->pdo->prepare("UPDATE staff SET username = '', password = '' WHERE id = ?");
        $statement->execute([$id]);
    }

