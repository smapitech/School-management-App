    }

    public function getCurrentTeacherIdFromUser(int $userId): int
    {
        if ($userId <= 0) {
            return 0;
        }

        $statement = $this->pdo->prepare("SELECT * FROM staff WHERE id = ? AND status = 'Active' LIMIT 1");
        $statement->execute([$userId]);
        $staff = $statement->fetch();

        if ($staff && in_array(strtolower($staff['role'] ?? ''), ['teacher', 'asst teacher', 'assistant teacher'], true)) {
            return (int) $staff['id'];
        }

        $statement = $this->pdo->prepare('SELECT id, email, role FROM users WHERE id = ? LIMIT 1');
        $statement->execute([$userId]);
        $user = $statement->fetch();

        if (!$user || ($user['role'] ?? '') !== 'teacher' || empty($user['email'])) {
            return 0;
        }

        $staff = $this->staffByEmail((string) $user['email']);
        if ($staff && in_array(strtolower($staff['role'] ?? ''), ['teacher', 'asst teacher', 'assistant teacher'], true)) {
            return (int) $staff['id'];
        }

        return 0;
    }

    public function getTeacherAssignedClasses(int $teacherId): array
    {
        $rows = $this->teacherAssignmentRows($teacherId);
        if (!$rows) {
            return [];
        }

        $classes = [];
        foreach ($rows as $row) {
            $classId = (int) ($row['class_id'] ?? 0);
            $className = trim((string) ($row['class_name'] ?? ''));
            $section = trim((string) ($row['section'] ?? ''));
            if ($className === '' && $classId <= 0) {
                continue;
            }

            $key = $classId > 0 ? 'id:' . $classId : 'name:' . $className;
            if ($section !== '') {
                $key .= '|section:' . $section;
            }

            if (!isset($classes[$key])) {
                $classes[$key] = [
                    'class_id' => $classId,
                    'class_name' => $className,
                    'section' => $section,
                    'teacher_id' => (int) ($row['teacher_id'] ?? 0),
                    'teacher_name' => trim(($row['teacher_name'] ?? '') . ' ' . ($row['middle_name'] ?? '') . ' ' . ($row['surname'] ?? '')),
                    'is_class_teacher' => (int) ($row['is_class_teacher'] ?? 0),
                    'subject_ids' => [],
                    'student_count' => 0,
                    'number_of_students' => 0,
                    'subject_count' => 0,
                ];
            }

            if (!empty($row['subject_id'])) {
                $classes[$key]['subject_ids'][(int) $row['subject_id']] = true;
            }
            if ((int) ($row['is_class_teacher'] ?? 0) === 1) {
                $classes[$key]['is_class_teacher'] = 1;
            }
        }

        foreach ($classes as $key => $class) {
            $classes[$key]['student_count'] = $this->teacherClassStudentCount($class['class_name'], $class['section']);
            $classes[$key]['number_of_students'] = $classes[$key]['student_count'];
            $classes[$key]['subject_count'] = $this->teacherClassSubjectCount($class['class_name'], $class['section'], array_keys($class['subject_ids']), (bool) $class['is_class_teacher']);
            $classes[$key]['subject_ids'] = array_keys($class['subject_ids']);
        }

        return array_values($classes);
    }

    public function getTeacherAssignedSubjects(int $teacherId): array
    {
        $classRows = $this->getTeacherAssignedClasses($teacherId);
        if (!$classRows) {
            return [];
        }

        $subjects = [];
        foreach ($classRows as $classRow) {
            $className = $classRow['class_name'] ?? '';
            $section = $classRow['section'] ?? '';
            $classId = (int) ($classRow['class_id'] ?? 0);
            $subjectIds = $classRow['subject_ids'] ?? [];

            if ((int) ($classRow['is_class_teacher'] ?? 0) === 1 || empty($subjectIds)) {
                foreach ($this->subjectsForClass($className, $section) as $subjectRow) {
                    $subjectId = (int) ($subjectRow['subject_id'] ?? 0);
                    $key = $classId . ':' . $subjectId;
                    if ($subjectId <= 0 || isset($subjects[$key])) {
                        continue;
                    }
                    $subjects[$key] = [
                        'class_id' => $classId,
                        'class_name' => $className,
                        'section' => $section,
                        'subject_id' => $subjectId,
                        'subject_name' => $subjectRow['subject_name'] ?? '',
                        'subject_type' => $subjectRow['subject_type'] ?? '',
                        'subject_code' => $subjectRow['subject_code'] ?? '',
                        'is_class_teacher' => (int) ($classRow['is_class_teacher'] ?? 0),
                    ];
                }
                continue;
            }

            foreach ($subjectIds as $subjectId) {
                $subject = $this->subjectById((int) $subjectId);
                if (!$subject) {
                    continue;
                }
                $key = $classId . ':' . (int) $subjectId;
                if (isset($subjects[$key])) {
                    continue;
                }
                $subjects[$key] = [
                    'class_id' => $classId,
                    'class_name' => $className,
                    'section' => $section,
                    'subject_id' => (int) $subjectId,
                    'subject_name' => $subject['subject_name'] ?? '',
                    'subject_type' => $subject['subject_type'] ?? '',
                    'subject_code' => $subject['subject_code'] ?? '',
                    'is_class_teacher' => (int) ($classRow['is_class_teacher'] ?? 0),
                ];
            }
        }

        return array_values($subjects);
    }

    public function getTeacherAssignedStudents(int $teacherId): array
    {
        $classRows = $this->getTeacherAssignedClasses($teacherId);
        if (!$classRows) {
            return [];
        }

        $students = [];
        foreach ($classRows as $classRow) {
            $className = trim((string) ($classRow['class_name'] ?? ''));
            $section = trim((string) ($classRow['section'] ?? ''));
            if ($className === '') {
                continue;
            }

            $rows = $section !== ''
                ? $this->admittedStudents(['class_name' => $className, 'section' => $section])
                : $this->admittedStudents(['class_name' => $className]);

            foreach ($rows as $row) {
                $students[(int) $row['id']] = $row;
            }
        }

        return array_values($students);
    }

    public function getTeacherAssignedStudentIds(int $teacherId): array
    {
        return array_map(
            fn (array $student): int => (int) $student['id'],
            $this->getTeacherAssignedStudents($teacherId)
        );
    }

    public function teacherCanAccessClass(int $teacherId, int $classId): bool
    {
        if ($teacherId <= 0 || $classId <= 0) {
            return false;
        }

        foreach ($this->getTeacherAssignedClasses($teacherId) as $class) {
            if ((int) ($class['class_id'] ?? 0) === $classId) {
                return true;
            }
        }

        return false;
    }

    public function teacherCanAccessSubject(int $teacherId, int $subjectId): bool
    {
        if ($teacherId <= 0 || $subjectId <= 0) {
            return false;
        }

        foreach ($this->getTeacherAssignedSubjects($teacherId) as $subject) {
            if ((int) ($subject['subject_id'] ?? 0) === $subjectId) {
                return true;
            }
        }

        return false;
    }

    public function teacherCanAccessStudent(int $teacherId, int $studentId): bool
    {
        if ($teacherId <= 0 || $studentId <= 0) {
            return false;
        }

        return in_array($studentId, $this->getTeacherAssignedStudentIds($teacherId), true);
    }

    private function teacherParentRowsIndexed(int $teacherId): array
    {
        $rows = [];

        foreach ($this->getTeacherAssignedStudents($teacherId) as $student) {
            $parentAccount = $this->parentLoginAccountForStudent($student);
            if (!$parentAccount || ($parentAccount['role'] ?? '') !== 'parent') {
                continue;
            }

            $studentId = (int) ($student['id'] ?? 0);
            $parentId = (int) ($parentAccount['id'] ?? 0);
            if ($studentId <= 0 || $parentId <= 0) {
                continue;
            }

            $firstName = trim((string) ($student['first_name'] ?? ''));
            if ($firstName === '') {
                $firstName = trim((string) ($student['applicant'] ?? ''));
            }

            $rows[$parentId . ':' . $studentId] = [
                'parent_id' => $parentId,
                'parent_name' => trim((string) (($student['guardian_full_name'] ?? '') ?: ($parentAccount['name'] ?? '') ?: ($student['guardian'] ?? 'Parent'))),
                'parent_login' => (string) ($parentAccount['email'] ?? ''),
                'parent_contact' => trim((string) (($student['parent_username'] ?? '') ?: ($student['guardian_mobile'] ?? ''))),
                'student_id' => $studentId,
                'student_name' => trim($firstName . ' ' . ($student['middle_name'] ?? '') . ' ' . ($student['last_name'] ?? '')),
                'registration_no' => $student['registration_no'] ?? '',
                'class_name' => $student['class_name'] ?? '',
                'section' => $student['section'] ?? '',
                'guardian_relationship' => $student['guardian_relationship'] ?? '',
                'guardian_mobile' => $student['guardian_mobile'] ?? '',
                'student' => $student,
            ];
        }

        return $rows;
    }

    private function parentLoginAccountForStudent(array $student): ?array
    {
        $contact = trim((string) (($student['parent_username'] ?? '') ?: ($student['guardian_mobile'] ?? '')));
        if ($contact === '') {
            return null;
        }

        $account = $this->findUserByEmail($contact);

        return $account && ($account['role'] ?? '') === 'parent' ? $account : null;
    }

    private function teacherLoginAccountForStaff(int $staffId, ?array $staff = null): ?array
    {
        if ($staffId <= 0) {
            return null;
        }

        $staff ??= $this->staffById($staffId);
        if (!$staff) {
            return null;
        }

        $candidates = array_values(array_filter([
            trim((string) ($staff['username'] ?? '')),
            trim((string) ($staff['email'] ?? '')),
        ]));

        foreach ($candidates as $candidate) {
            $account = $this->findUserByEmail($candidate);
            if ($account && ($account['role'] ?? '') === 'teacher') {
                return $account;
            }
        }

        return null;
    }

    private function teacherConversationRow(int $conversationId): ?array
    {
        $statement = $this->pdo->prepare(
            'SELECT * FROM teacher_conversations WHERE id = ? LIMIT 1'
        );
        $statement->execute([$conversationId]);
        $row = $statement->fetch();

        return $row ?: null;
    }

    private function teacherConversationSummaries(int $teacherId, ?int $conversationId = null): array
    {
        $sql = "SELECT tc.*,
                origin.name AS origin_name, origin.middle_name AS origin_middle_name, origin.surname AS origin_surname,
                origin.email AS origin_email, origin.username AS origin_username,
                peer.name AS peer_name, peer.middle_name AS peer_middle_name, peer.surname AS peer_surname,
                peer.email AS peer_email, peer.username AS peer_username,
                a.applicant, a.first_name, a.middle_name, a.last_name, a.class_name, a.section,
                a.guardian, a.guardian_full_name, a.guardian_relationship, a.parent_username, a.guardian_mobile,
                lm.message AS last_message, lm.sender_id AS last_sender_id, lm.sender_role AS last_sender_role,
                lm.attachment_path AS last_attachment_path, lm.attachment_name AS last_attachment_name, lm.created_at AS last_message_created_at
            FROM teacher_conversations tc
            LEFT JOIN staff origin ON origin.id = tc.teacher_id
            LEFT JOIN staff peer ON peer.id = tc.other_teacher_id
            LEFT JOIN admissions a ON a.id = tc.student_id
            LEFT JOIN teacher_conversation_messages lm ON lm.id = (
                SELECT tcm.id
                FROM teacher_conversation_messages tcm
                WHERE tcm.conversation_id = tc.id
                ORDER BY tcm.id DESC
                LIMIT 1
            )
            WHERE (tc.teacher_id = ? OR tc.other_teacher_id = ?)";
        $params = [$teacherId, $teacherId];

        if ($conversationId !== null) {
            $sql .= ' AND tc.id = ?';
            $params[] = $conversationId;
        }

        $sql .= ' ORDER BY COALESCE(tc.last_message_at, tc.created_at) DESC, tc.id DESC';
        $statement = $this->pdo->prepare($sql);
        $statement->execute($params);
        $rows = [];

        foreach ($statement->fetchAll() as $row) {
            $participantName = '';
            $participantType = '';
            $participantTeacherId = 0;

            if (($row['conversation_type'] ?? '') === 'teacher_parent') {
                $participantType = 'parent';
                $participantName = trim((string) (($row['guardian_full_name'] ?? '') ?: ($row['guardian'] ?? '') ?: 'Parent'));
            } else {
                $participantType = 'teacher';
                if ((int) ($row['teacher_id'] ?? 0) === $teacherId) {
                    $participantTeacherId = (int) ($row['other_teacher_id'] ?? 0);
                    $participantName = trim(($row['peer_name'] ?? '') . ' ' . ($row['peer_middle_name'] ?? '') . ' ' . ($row['peer_surname'] ?? ''));
                } else {
                    $participantTeacherId = (int) ($row['teacher_id'] ?? 0);
                    $participantName = trim(($row['origin_name'] ?? '') . ' ' . ($row['origin_middle_name'] ?? '') . ' ' . ($row['origin_surname'] ?? ''));
                }
            }

            $firstName = trim((string) ($row['first_name'] ?? ''));
            if ($firstName === '') {
                $firstName = trim((string) ($row['applicant'] ?? ''));
            }

            $row['participant_type'] = $participantType;
            $row['participant_name'] = $participantName !== '' ? $participantName : ucfirst($participantType);
            $row['participant_teacher_id'] = $participantTeacherId;
            $row['student_name'] = trim($firstName . ' ' . ($row['middle_name'] ?? '') . ' ' . ($row['last_name'] ?? ''));
            $row['last_message_preview'] = mb_substr(trim(strip_tags((string) ($row['last_message'] ?? ''))), 0, 160);
            $row['last_activity_at'] = $row['last_message_created_at'] ?? $row['last_message_at'] ?? $row['created_at'];
            $rows[] = $row;
        }

        return $rows;
    }

    private function teacherConversationSenderName(array $message, array $conversation): string
    {
        $senderRole = (string) ($message['sender_role'] ?? '');
        $senderId = (int) ($message['sender_id'] ?? 0);

        if ($senderRole === 'teacher') {
            $staff = $this->staffById($senderId);
            if ($staff) {
                return trim(($staff['name'] ?? '') . ' ' . ($staff['middle_name'] ?? '') . ' ' . ($staff['surname'] ?? ''));
            }

            return 'Teacher';
        }

        if ($senderRole === 'parent') {
            $student = !empty($conversation['student_id']) ? $this->admissionById((int) $conversation['student_id']) : null;
            if ($student) {
                return trim((string) (($student['guardian_full_name'] ?? '') ?: ($student['guardian'] ?? '') ?: 'Parent'));
            }

            $account = $this->userByRoleAndId($senderId, 'parent');
            if ($account) {
                return $account['name'] ?? 'Parent';
            }

            return 'Parent';
        }

        return ucfirst($senderRole ?: 'User');
    }

    private function insertTeacherConversationMessage(int $conversationId, int $senderId, string $senderRole, string $message, array $attachment): void
    {
        $statement = $this->pdo->prepare(
            'INSERT INTO teacher_conversation_messages (conversation_id, sender_id, sender_role, message, attachment_path, attachment_name, is_read, read_at, created_at)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)'
        );
        $createdAt = date('Y-m-d H:i:s');
        $statement->execute([
            $conversationId,
            $senderId,
            $senderRole,
            $message,
            trim((string) ($attachment['attachment_path'] ?? '')),
            trim((string) ($attachment['attachment_name'] ?? '')),
            0,
            null,
            $createdAt,
        ]);

        $update = $this->pdo->prepare('UPDATE teacher_conversations SET last_message_at = ?, updated_at = ? WHERE id = ?');
        $update->execute([$createdAt, $createdAt, $conversationId]);
    }

    private function findTeacherConversationByParticipants(string $type, array $filters): ?array
    {
        if ($type === 'teacher_parent') {
            $statement = $this->pdo->prepare(
                'SELECT * FROM teacher_conversations
                WHERE conversation_type = ? AND teacher_id = ? AND parent_id = ? AND student_id = ? AND subject = ? AND status = ?
                ORDER BY id DESC LIMIT 1'
            );
            $statement->execute([$type, (int) ($filters['teacher_id'] ?? 0), (int) ($filters['parent_id'] ?? 0), (int) ($filters['student_id'] ?? 0), $filters['subject'] ?? '', 'open']);

            $row = $statement->fetch();
            return $row ?: null;
        }

        $statement = $this->pdo->prepare(
            'SELECT * FROM teacher_conversations
            WHERE conversation_type = ? AND subject = ? AND status = ?
            AND ((teacher_id = ? AND other_teacher_id = ?) OR (teacher_id = ? AND other_teacher_id = ?))
            ORDER BY id DESC LIMIT 1'
        );
        $teacherId = (int) ($filters['teacher_id'] ?? 0);
        $otherTeacherId = (int) ($filters['other_teacher_id'] ?? 0);
        $statement->execute([$type, $filters['subject'] ?? '', 'open', $teacherId, $otherTeacherId, $otherTeacherId, $teacherId]);
        $row = $statement->fetch();

        return $row ?: null;
    }

    public function subjects(): array
    {
        return $this->pdo->query('SELECT * FROM subjects ORDER BY subject_name ASC')->fetchAll();
    }

    public function subjectById(int $id): ?array
    {
        $statement = $this->pdo->prepare('SELECT * FROM subjects WHERE id = ? LIMIT 1');
        $statement->execute([$id]);
        $row = $statement->fetch();

        return $row ?: null;
    }

    public function subjectCodeExists(string $subjectCode, int $excludeId = 0): bool
    {
        $sql = 'SELECT COUNT(*) FROM subjects WHERE subject_code = ?';
        $params = [$subjectCode];

        if ($excludeId > 0) {
            $sql .= ' AND id <> ?';
            $params[] = $excludeId;
        }

        $statement = $this->pdo->prepare($sql);
        $statement->execute($params);

        return (int) $statement->fetchColumn() > 0;
    }

    public function subjectsForClass(string $className = '', string $section = ''): array
    {
        $where = [];
        $params = [];
        $orderBy = 'ORDER BY sa.class_name ASC, sa.section ASC, sub.subject_name ASC, sa.id ASC';

        if ($className !== '') {
            $where[] = 'sa.class_name = ?';
            $params[] = $className;

            if ($section !== '') {
                $where[] = "(sa.section = ? OR sa.section = '')";
                $params[] = $section;
                $orderBy = "ORDER BY CASE WHEN sa.section = ? THEN 0 WHEN sa.section = '' THEN 1 ELSE 2 END, sub.subject_name ASC, sa.id ASC";
                $params[] = $section;
            }
        } elseif ($section !== '') {
            $where[] = 'sa.section = ?';
            $params[] = $section;
        }

        $sql = "SELECT sa.*, sub.subject_name, sub.subject_type, sub.subject_code
            FROM subject_assignments sa
            JOIN subjects sub ON sub.id = sa.subject_id";

        if ($where) {
            $sql .= ' WHERE ' . implode(' AND ', $where);
        }

        $sql .= ' ' . $orderBy;
        $statement = $this->pdo->prepare($sql);
        $statement->execute($params);

        $rows = $statement->fetchAll();
        $uniqueRows = [];

        foreach ($rows as $row) {
            $subjectId = (int) ($row['subject_id'] ?? 0);
            if ($subjectId <= 0 || isset($uniqueRows[$subjectId])) {
                continue;
            }

            $uniqueRows[$subjectId] = $row;
        }

        return array_values($uniqueRows);
    }

    public function subjectsForTeacher(array $user): array
    {
        $rows = [];
        foreach ($this->teacherAssignmentsForUser($user) as $assignment) {
            foreach ($this->subjectsForClass($assignment['class_name'], $assignment['section']) as $subjectRow) {
                $className = trim((string) ($subjectRow['class_name'] ?? $assignment['class_name'] ?? ''));
                $subjectId = (int) ($subjectRow['subject_id'] ?? 0);
                if ($className === '' || $subjectId <= 0) {
                    continue;
                }

                $key = $className . '|' . $subjectId;
                if (isset($rows[$key])) {
                    continue;
                }

                $rows[$key] = $subjectRow;
            }
        }

        return array_values($rows);
    }

    public function saveSubject(array $data): void
    {
        $statement = $this->pdo->prepare('INSERT INTO subjects (subject_name, subject_type, subject_code, created_at) VALUES (?, ?, ?, ?)');
        $statement->execute([$data['subject_name'], $data['subject_type'], $data['subject_code'], date('Y-m-d')]);
    }

    public function updateSubject(int $id, array $data): void
    {
        $statement = $this->pdo->prepare('UPDATE subjects SET subject_name = ?, subject_type = ?, subject_code = ? WHERE id = ?');
        $statement->execute([$data['subject_name'], $data['subject_type'], $data['subject_code'], $id]);
    }

    public function deleteSubject(int $id): void
    {
        $statement = $this->pdo->prepare('DELETE FROM subjects WHERE id = ?');
        $statement->execute([$id]);
    }

    public function subjectUsageSummary(int $subjectId): array
    {
        $summary = [
            'subject_assignments' => 0,
            'timetables' => 0,
            'exam_settings' => 0,
            'homework_assignments' => 0,
            'teacher_assignments' => 0,
        ];

        $queries = [
            'subject_assignments' => 'SELECT COUNT(*) FROM subject_assignments WHERE subject_id = ?',
            'timetables' => 'SELECT COUNT(*) FROM timetables WHERE subject_id = ?',
            'exam_settings' => 'SELECT COUNT(*) FROM exam_settings WHERE subject_id = ?',
            'homework_assignments' => 'SELECT COUNT(*) FROM homework_assignments WHERE subject_id = ? AND deleted_at IS NULL',
            'teacher_assignments' => 'SELECT COUNT(*) FROM teacher_assignments WHERE subject_id = ?',
        ];

        foreach ($queries as $key => $sql) {
            $statement = $this->pdo->prepare($sql);
            $statement->execute([$subjectId]);
            $summary[$key] = (int) $statement->fetchColumn();
        }

        return $summary;
    }

    public function subjectAssignments(): array
    {
        return $this->pdo->query(
            "SELECT sa.*, sub.subject_name, sub.subject_type, sub.subject_code
            FROM subject_assignments sa
            JOIN subjects sub ON sub.id = sa.subject_id
            ORDER BY sa.class_name ASC, sa.section ASC, sub.subject_name ASC, sa.id ASC"
        )->fetchAll();
    }

    public function saveSubjectAssignment(array $data): void
    {
        $statement = $this->pdo->prepare('INSERT INTO subject_assignments (class_name, section, subject_id, created_at) VALUES (?, ?, ?, ?)');
        $statement->execute([$data['class_name'], $data['section'], $data['subject_id'], date('Y-m-d')]);
    }

    public function syncSubjectAssignments(string $className, array $subjectIds): void
    {
        $className = trim($className);
        $subjectIds = array_values(array_unique(array_filter(array_map(
            static fn (mixed $subjectId): int => (int) $subjectId,
            $subjectIds
        ), static fn (int $subjectId): bool => $subjectId > 0)));

        if ($className === '' || empty($subjectIds)) {
            return;
        }

        $this->pdo->beginTransaction();

        try {
            $statement = $this->pdo->prepare(
                'SELECT id, subject_id, section, created_at
                FROM subject_assignments
                WHERE class_name = ?
                ORDER BY created_at ASC, id ASC'
            );
            $statement->execute([$className]);
            $existingRows = $statement->fetchAll();

            $rowsBySubject = [];
            foreach ($existingRows as $row) {
                $subjectId = (int) ($row['subject_id'] ?? 0);
                if ($subjectId <= 0) {
                    continue;
                }

                $rowsBySubject[$subjectId][] = $row;
            }

            $update = $this->pdo->prepare('UPDATE subject_assignments SET section = ? WHERE id = ?');
            $delete = $this->pdo->prepare('DELETE FROM subject_assignments WHERE id = ?');
            $insert = $this->pdo->prepare('INSERT INTO subject_assignments (class_name, section, subject_id, created_at) VALUES (?, ?, ?, ?)');
            $today = date('Y-m-d');

            foreach ($subjectIds as $subjectId) {
                if (!empty($rowsBySubject[$subjectId])) {
                    $keptRow = array_shift($rowsBySubject[$subjectId]);
                    if (($keptRow['section'] ?? '') !== '') {
                        $update->execute(['', (int) $keptRow['id']]);
                    }

                    foreach ($rowsBySubject[$subjectId] as $duplicateRow) {
                        $delete->execute([(int) $duplicateRow['id']]);
                    }

                    unset($rowsBySubject[$subjectId]);
                    continue;
                }

                $insert->execute([$className, '', $subjectId, $today]);
            }

            foreach ($rowsBySubject as $subjectRows) {
                foreach ($subjectRows as $row) {
                    $delete->execute([(int) $row['id']]);
                }
            }

            $this->pdo->commit();
        } catch (\Throwable $throwable) {
            if ($this->pdo->inTransaction()) {
                $this->pdo->rollBack();
            }

            throw $throwable;
        }
    }

    private function teacherAssignmentRows(int $teacherId): array
    {
        if ($teacherId <= 0) {
            return [];
        }

        $statement = $this->pdo->prepare(
            'SELECT ta.id, ta.teacher_id, ta.class_id, ta.subject_id, ta.section_id, ta.is_class_teacher, ta.status,
                c.name AS class_name, COALESCE(ca.section, "") AS section,
                sub.subject_name, sub.subject_type, sub.subject_code,
                st.name AS teacher_name, st.middle_name, st.surname
            FROM teacher_assignments ta
            INNER JOIN classes c ON c.id = ta.class_id
            LEFT JOIN subjects sub ON sub.id = ta.subject_id
            LEFT JOIN staff st ON st.id = ta.teacher_id
            LEFT JOIN class_assignments ca ON ca.teacher_id = ta.teacher_id AND ca.class_name = c.name
            WHERE ta.teacher_id = ? AND ta.status = ?
            ORDER BY c.name ASC, COALESCE(ca.section, "") ASC, ta.id ASC'
        );
        $statement->execute([$teacherId, 'active']);
        $rows = $statement->fetchAll();
        if (!empty($rows)) {
            return $rows;
        }

        $statement = $this->pdo->prepare(
            'SELECT ca.id, ca.teacher_id, COALESCE(c.id, 0) AS class_id, NULL AS subject_id, NULL AS section_id, 1 AS is_class_teacher, "active" AS status,
                ca.class_name, ca.section,
                NULL AS subject_name, NULL AS subject_type, NULL AS subject_code,
                st.name AS teacher_name, st.middle_name, st.surname
            FROM class_assignments ca
            LEFT JOIN classes c ON c.name = ca.class_name
            LEFT JOIN staff st ON st.id = ca.teacher_id
            WHERE ca.teacher_id = ?
            ORDER BY ca.class_name ASC, ca.section ASC, ca.id ASC'
        );
        $statement->execute([$teacherId]);

        return $statement->fetchAll();
    }

    private function teacherTimetableScope(array $assignments): array
    {
        $clauses = [];
        $params = [];

        foreach ($assignments as $assignment) {
            $className = trim((string) ($assignment['class_name'] ?? ''));
            if ($className === '') {
                continue;
            }

            $clause = ['tt.class_name = ?'];
            $clauseParams = [$className];
            $section = trim((string) ($assignment['section'] ?? ''));

            if ($section !== '') {
                $clause[] = 'tt.section = ?';
                $clauseParams[] = $section;
            }

            $subjectIds = array_values(array_filter(
                array_map('intval', (array) ($assignment['subject_ids'] ?? [])),
                static fn (int $value): bool => $value > 0
            ));

            if ($subjectIds && (int) ($assignment['is_class_teacher'] ?? 0) !== 1) {
                $clause[] = 'tt.subject_id IN (' . implode(', ', array_fill(0, count($subjectIds), '?')) . ')';
                array_push($clauseParams, ...$subjectIds);
            }

            $clauses[] = '(' . implode(' AND ', $clause) . ')';
            array_push($params, ...$clauseParams);
        }

        return [$clauses, $params];
    }

    private function timetableById(int $id): ?array
    {
        $rows = $this->timetables(['id' => $id]);

        return $rows[0] ?? null;
    }

    private function prepareTeacherTimetablePayload(int $teacherId, array $data, ?int $excludeId = null): array
    {
        $classId = (int) ($data['class_id'] ?? 0);
        $section = trim((string) ($data['section'] ?? ''));
        $subjectId = (int) ($data['subject_id'] ?? 0);
        $dayOfWeek = trim((string) ($data['day_of_week'] ?? ''));
        $startTime = trim((string) ($data['start_time'] ?? ''));
        $endTime = trim((string) ($data['end_time'] ?? ''));
        $room = trim((string) ($data['room'] ?? ''));
        $note = trim((string) ($data['note'] ?? ''));
        $createdBy = !empty($data['created_by']) ? (int) $data['created_by'] : null;

        if ($classId <= 0) {
            throw new \InvalidArgumentException('Class is required.');
        }

        if ($subjectId <= 0) {
            throw new \InvalidArgumentException('Subject is required.');
        }

        if ($dayOfWeek === '') {
            throw new \InvalidArgumentException('Day of week is required.');
        }

        if (!in_array($dayOfWeek, ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'], true)) {
            throw new \InvalidArgumentException('Please select a valid day of week.');
        }

        if ($startTime === '') {
            throw new \InvalidArgumentException('Start time is required.');
        }

        if ($endTime === '') {
            throw new \InvalidArgumentException('End time is required.');
        }

        if ($startTime >= $endTime) {
            throw new \InvalidArgumentException('Start time must be earlier than end time.');
        }

        $class = $this->classById($classId);
        if (!$class) {
            throw new \RuntimeException('The selected class could not be found.');
        }

        if (!$this->teacherAssignedClassRow($teacherId, $classId, $section)) {
            throw new \RuntimeException('You can only use classes assigned to your teacher profile.');
        }

        if (!$this->teacherCanUseSubjectForClass($teacherId, $classId, $section, $subjectId)) {
            throw new \RuntimeException('You can only use subjects assigned to the selected class.');
        }

        if ($this->teacherHasTimetableClash($teacherId, $dayOfWeek, $startTime, $endTime, $excludeId)) {
            throw new \RuntimeException('This lesson overlaps with another timetable already assigned to you.');
        }

        if ($this->classHasTimetableClash($classId, $section, $dayOfWeek, $startTime, $endTime, $excludeId)) {
            throw new \RuntimeException('This class already has a timetable entry in the selected time range.');
        }

        return [
            'class_name' => $class['name'],
            'section' => $section,
            'subject_id' => $subjectId,
            'day_of_week' => $dayOfWeek,
            'start_time' => $startTime,
            'end_time' => $endTime,
            'room' => $room,
            'note' => $note,
            'created_by' => $createdBy,
        ];
    }

    private function teacherAssignedClassRow(int $teacherId, int $classId, string $section): ?array
    {
        foreach ($this->getTeacherAssignedClasses($teacherId) as $assignment) {
            if ((int) ($assignment['class_id'] ?? 0) !== $classId) {
                continue;
            }

            if (trim((string) ($assignment['section'] ?? '')) === $section) {
                return $assignment;
            }
        }

        return null;
    }

    private function teacherCanUseSubjectForClass(int $teacherId, int $classId, string $section, int $subjectId): bool
    {
        if ($subjectId <= 0) {
            return false;
        }

        $assignment = $this->teacherAssignedClassRow($teacherId, $classId, $section);
        if (!$assignment) {
            return false;
        }

        if ((int) ($assignment['is_class_teacher'] ?? 0) === 1) {
            foreach ($this->subjectsForClass((string) ($assignment['class_name'] ?? ''), $section) as $subject) {
                if ((int) ($subject['subject_id'] ?? 0) === $subjectId) {
                    return true;
                }
            }

            return false;
        }

        return in_array($subjectId, array_map('intval', (array) ($assignment['subject_ids'] ?? [])), true);
    }

    private function teacherClassStudentCount(string $className, string $section = ''): int
    {
        if ($className === '') {
            return 0;
        }

        if ($section !== '') {
            $statement = $this->pdo->prepare('SELECT COUNT(*) FROM admissions WHERE class_name = ? AND section = ?');
            $statement->execute([$className, $section]);

            return (int) $statement->fetchColumn();
        }

        $statement = $this->pdo->prepare('SELECT COUNT(*) FROM admissions WHERE class_name = ?');
        $statement->execute([$className]);

        return (int) $statement->fetchColumn();
    }

    private function teacherClassSubjectCount(string $className, string $section = '', array $subjectIds = [], bool $isClassTeacher = false): int
    {
        if ($className === '') {
            return 0;
        }

        if ($isClassTeacher || empty($subjectIds)) {
            return count($this->subjectsForClass($className, $section));
        }

        return count(array_unique(array_map('intval', $subjectIds)));
    }

    public function timetables(array $filters = []): array
    {
        $where = [];
        $params = [];

        if (!empty($filters['id'])) {
            $where[] = 'tt.id = ?';
            $params[] = (int) $filters['id'];
        }

        if (!empty($filters['class_name'])) {
            $where[] = 'tt.class_name = ?';
            $params[] = $filters['class_name'];
        }

        if (!empty($filters['class_id'])) {
            $where[] = 'c.id = ?';
            $params[] = (int) $filters['class_id'];
        }

        if (!empty($filters['section'])) {
            $where[] = 'tt.section = ?';
            $params[] = $filters['section'];
        }

        if (!empty($filters['subject_id'])) {
            $where[] = 'tt.subject_id = ?';
            $params[] = (int) $filters['subject_id'];
        }

        if (!empty($filters['day_of_week'])) {
            $where[] = 'tt.day_of_week = ?';
            $params[] = $filters['day_of_week'];
        }

        $sql = "SELECT tt.*, COALESCE(c.id, 0) AS class_id, sub.subject_name, sub.subject_type, sub.subject_code, s.name, s.middle_name, s.surname
            FROM timetables tt
            JOIN subjects sub ON sub.id = tt.subject_id
            JOIN staff s ON s.id = tt.teacher_id
            LEFT JOIN classes c ON c.name = tt.class_name";
        if ($where) {
            $sql .= ' WHERE ' . implode(' AND ', $where);
        }
        $sql .= " ORDER BY tt.class_name ASC, tt.section ASC,
            CASE tt.day_of_week
                WHEN 'Monday' THEN 1
                WHEN 'Tuesday' THEN 2
                WHEN 'Wednesday' THEN 3
                WHEN 'Thursday' THEN 4
                WHEN 'Friday' THEN 5
                WHEN 'Saturday' THEN 6
                WHEN 'Sunday' THEN 7
                ELSE 99
            END ASC,
            tt.start_time ASC";
        $statement = $this->pdo->prepare($sql);
        $statement->execute($params);

        return $statement->fetchAll();
    }

    public function timetablesForTeacher(array $user, array $filters = []): array
    {
        if (($user['role'] ?? '') !== 'teacher') {
            return $this->timetables($filters);
        }

        $teacherId = $this->getCurrentTeacherIdFromUser((int) ($user['id'] ?? 0));
        if ($teacherId <= 0) {
            return [];
        }

        return $this->getTeacherTimetable($teacherId, $filters);
    }

    public function saveTimetable(array $data): void
    {
        $statement = $this->pdo->prepare('INSERT INTO timetables (class_name, section, subject_id, teacher_id, day_of_week, start_time, end_time, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)');
        $statement->execute([$data['class_name'], $data['section'], $data['subject_id'], $data['teacher_id'], $data['day_of_week'], $data['start_time'], $data['end_time'], date('Y-m-d')]);
    }

    public function getTeacherTimetable(int $teacherId, array $filters = []): array
    {
        $assignments = $this->getTeacherAssignedClasses($teacherId);
        if (!$assignments) {
            return [];
        }

        [$scopeClauses, $scopeParams] = $this->teacherTimetableScope($assignments);
        if (!$scopeClauses) {
            return [];
        }

        $where = ['(' . implode(' OR ', $scopeClauses) . ')'];
        $params = $scopeParams;

        if (!empty($filters['id'])) {
            $where[] = 'tt.id = ?';
            $params[] = (int) $filters['id'];
        }

        if (!empty($filters['class_id'])) {
            $where[] = 'c.id = ?';
            $params[] = (int) $filters['class_id'];
        }

        if (!empty($filters['class_name'])) {
            $where[] = 'tt.class_name = ?';
            $params[] = $filters['class_name'];
        }

        if (!empty($filters['section'])) {
            $where[] = 'tt.section = ?';
            $params[] = $filters['section'];
        }

        if (!empty($filters['subject_id'])) {
            $where[] = 'tt.subject_id = ?';
            $params[] = (int) $filters['subject_id'];
        }

        if (!empty($filters['day_of_week'])) {
            $where[] = 'tt.day_of_week = ?';
            $params[] = $filters['day_of_week'];
        }

        $statement = $this->pdo->prepare(
            "SELECT tt.*, COALESCE(c.id, 0) AS class_id, sub.subject_name, sub.subject_type, sub.subject_code, s.name, s.middle_name, s.surname
            FROM timetables tt
            JOIN subjects sub ON sub.id = tt.subject_id
            JOIN staff s ON s.id = tt.teacher_id
            LEFT JOIN classes c ON c.name = tt.class_name
            WHERE " . implode(' AND ', $where) . "
            ORDER BY tt.class_name ASC, tt.section ASC,
                CASE tt.day_of_week
                    WHEN 'Monday' THEN 1
                    WHEN 'Tuesday' THEN 2
                    WHEN 'Wednesday' THEN 3
                    WHEN 'Thursday' THEN 4
                    WHEN 'Friday' THEN 5
                    WHEN 'Saturday' THEN 6
                    WHEN 'Sunday' THEN 7
                    ELSE 99
                END ASC,
                tt.start_time ASC"
        );
        $statement->execute($params);

        return $statement->fetchAll();
    }

    public function getClassTimetableForTeacher(int $teacherId, int $classId): array
    {
        if (!$this->teacherCanAccessClass($teacherId, $classId)) {
            return [];
        }

        return $this->getTeacherTimetable($teacherId, ['class_id' => $classId]);
    }

    public function createTeacherTimetable(int $teacherId, array $data): void
    {
        $payload = $this->prepareTeacherTimetablePayload($teacherId, $data);
        $statement = $this->pdo->prepare(
            'INSERT INTO timetables (class_name, section, subject_id, teacher_id, day_of_week, start_time, end_time, room, note, created_by, created_at, updated_at)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)'
        );
        $statement->execute([
            $payload['class_name'],
            $payload['section'],
            $payload['subject_id'],
            $teacherId,
            $payload['day_of_week'],
            $payload['start_time'],
            $payload['end_time'],
            $payload['room'],
            $payload['note'],
            $payload['created_by'],
            date('Y-m-d'),
            date('Y-m-d H:i:s'),
        ]);
    }

    public function updateTeacherTimetable(int $teacherId, int $timetableId, array $data): void
    {
        $row = $this->timetableById($timetableId);
        if (!$row || !$this->teacherCanAccessTimetable($teacherId, $timetableId) || (int) ($row['teacher_id'] ?? 0) !== $teacherId) {
            throw new \RuntimeException('You can only edit timetable rows you created for your assigned classes.');
        }

        $payload = $this->prepareTeacherTimetablePayload($teacherId, $data, $timetableId);
        $statement = $this->pdo->prepare(
            'UPDATE timetables
            SET class_name = ?, section = ?, subject_id = ?, day_of_week = ?, start_time = ?, end_time = ?, room = ?, note = ?, updated_at = ?
            WHERE id = ? AND teacher_id = ?'
        );
        $statement->execute([
            $payload['class_name'],
            $payload['section'],
            $payload['subject_id'],
            $payload['day_of_week'],
            $payload['start_time'],
            $payload['end_time'],
            $payload['room'],
            $payload['note'],
            date('Y-m-d H:i:s'),
            $timetableId,
            $teacherId,
        ]);
    }

    public function deleteTeacherTimetable(int $teacherId, int $timetableId): void
    {
        $row = $this->timetableById($timetableId);
        if (!$row || !$this->teacherCanAccessTimetable($teacherId, $timetableId) || (int) ($row['teacher_id'] ?? 0) !== $teacherId) {
            throw new \RuntimeException('You can only delete timetable rows you created for your assigned classes.');
        }

        $statement = $this->pdo->prepare('DELETE FROM timetables WHERE id = ? AND teacher_id = ?');
        $statement->execute([$timetableId, $teacherId]);
    }

    public function teacherCanAccessTimetable(int $teacherId, int $timetableId): bool
    {
        if ($teacherId <= 0 || $timetableId <= 0) {
            return false;
        }

        return !empty($this->getTeacherTimetable($teacherId, ['id' => $timetableId]));
    }

    public function teacherHasTimetableClash(int $teacherId, string $dayOfWeek, string $startTime, string $endTime, ?int $excludeId = null): bool
    {
        if ($teacherId <= 0 || $dayOfWeek === '' || $startTime === '' || $endTime === '') {
            return false;
        }

        $sql = 'SELECT COUNT(*) FROM timetables WHERE teacher_id = ? AND day_of_week = ? AND start_time < ? AND end_time > ?';
        $params = [$teacherId, $dayOfWeek, $endTime, $startTime];

        if ($excludeId !== null && $excludeId > 0) {
            $sql .= ' AND id <> ?';
            $params[] = $excludeId;
        }

        $statement = $this->pdo->prepare($sql);
        $statement->execute($params);

        return (int) $statement->fetchColumn() > 0;
    }

    public function classHasTimetableClash(int $classId, mixed $sectionId, string $dayOfWeek, string $startTime, string $endTime, ?int $excludeId = null): bool
    {
        $class = $this->classById($classId);
        if (!$class || $dayOfWeek === '' || $startTime === '' || $endTime === '') {
            return false;
        }

        $sql = 'SELECT COUNT(*) FROM timetables WHERE class_name = ? AND day_of_week = ? AND start_time < ? AND end_time > ?';
        $params = [$class['name'], $dayOfWeek, $endTime, $startTime];
        $section = trim((string) $sectionId);

        if ($section !== '') {
            $sql .= ' AND section = ?';
            $params[] = $section;
        }

        if ($excludeId !== null && $excludeId > 0) {
            $sql .= ' AND id <> ?';
            $params[] = $excludeId;
        }

        $statement = $this->pdo->prepare($sql);
        $statement->execute($params);

        return (int) $statement->fetchColumn() > 0;
    }

    public function staffByEmail(string $email): ?array
    {
        if ($email === '') {
            return null;
        }

        $statement = $this->pdo->prepare('SELECT * FROM staff WHERE email = ? OR username = ? LIMIT 1');
        $statement->execute([$email, $email]);
        $row = $statement->fetch();

        return $row ?: null;
    }

    public function profilePhotoForUser(?array $user): string
    {
        if (!$user || in_array($user['role'] ?? '', ['superadmin', 'admin'], true)) {
            return '';
        }

        if (($user['role'] ?? '') === 'student') {
            $student = $this->studentForPortal($user);
            return $student['profile_picture'] ?? '';
        }

        if (($user['role'] ?? '') === 'parent') {
            $children = $this->parentPortalChildren($user);
            return $children[0]['guardian_picture'] ?? '';
        }

        $staff = $this->staffByEmail($user['email'] ?? '');

        return $staff['staff_photo'] ?? '';
    }

    public function teacherAssignmentsForUser(array $user): array
    {
        if (($user['role'] ?? '') !== 'teacher') {
            return [];
        }

        $teacherId = $this->getCurrentTeacherIdFromUser((int) ($user['id'] ?? 0));
        if ($teacherId <= 0 && !empty($user['email'])) {
            $staff = $this->staffByEmail((string) $user['email']);
            if ($staff && in_array(strtolower($staff['role'] ?? ''), ['teacher', 'asst teacher', 'assistant teacher'], true)) {
                $teacherId = (int) $staff['id'];
            }
        }

        if ($teacherId <= 0) {
            return [];
        }

        return array_map(static function (array $assignment): array {
            return [
                'id' => (int) ($assignment['class_id'] ?? 0),
                'class_name' => $assignment['class_name'] ?? '',
                'section' => $assignment['section'] ?? '',
                'teacher_id' => (int) ($assignment['teacher_id'] ?? 0),
                'number_of_students' => (int) ($assignment['number_of_students'] ?? 0),
                'is_class_teacher' => (int) ($assignment['is_class_teacher'] ?? 0),
                'subject_count' => (int) ($assignment['subject_count'] ?? 0),
            ];
        }, $this->getTeacherAssignedClasses($teacherId));
    }

    private function examSettingLookup(array $filters): ?array
    {
        $statement = $this->pdo->prepare(
            'SELECT es.*, sub.subject_name, sub.subject_code
            FROM exam_settings es
            LEFT JOIN subjects sub ON sub.id = es.subject_id
            WHERE es.class_name = ? AND es.section = ? AND es.school_term = ? AND es.school_session = ? AND es.subject_id = ?
            ORDER BY es.id ASC
            LIMIT 1'
        );
        $statement->execute([
            $filters['class_name'],
            $filters['section'],
            $filters['school_term'],
            $filters['school_session'],
            $filters['subject_id'],
        ]);
        $row = $statement->fetch();

        return $row ? $this->normalizeExamSettingRow($row) : null;
    }

    private function normalizeExamSettingRow(array $row): array
    {
        $subjectId = (int) ($row['subject_id'] ?? 0);
        $subjectName = trim((string) ($row['subject_name'] ?? ''));
        if ($subjectName === '' && $subjectId > 0) {
            $subjectName = 'Subject #' . $subjectId;
        }

        $row['subject_name'] = $subjectName;
        $row['subject_code'] = trim((string) ($row['subject_code'] ?? ''));

        return $row;
    }

    private function canUseExamSettingForUser(array $user, string $className, string $section, int $subjectId): bool
    {
        if (($user['role'] ?? '') !== 'teacher') {
            return true;
        }

        foreach ($this->subjectsForTeacher($user) as $subject) {
            if (
                ($subject['class_name'] ?? '') === $className
                && trim((string) ($subject['section'] ?? '')) === $section
                && (int) ($subject['subject_id'] ?? 0) === $subjectId
            ) {
                return true;
            }
        }

        return false;
    }

    public function examSettings(array $user): array
    {
        $params = [];
        $where = [];

        if (($user['role'] ?? '') === 'teacher') {
            $assignments = $this->teacherAssignmentsForUser($user);
            if (!$assignments) {
                return [];
            }

            $pairs = [];
            foreach ($assignments as $assignment) {
                $pairs[] = '(es.class_name = ? AND es.section = ?)';
                $params[] = $assignment['class_name'];
                $params[] = $assignment['section'];
            }
            $where[] = '(' . implode(' OR ', $pairs) . ')';
        }

        $sql = "SELECT es.*, sub.subject_name, sub.subject_code
            FROM exam_settings es
            LEFT JOIN subjects sub ON sub.id = es.subject_id";

        if ($where) {
            $sql .= ' WHERE ' . implode(' AND ', $where);
        }

        $sql .= ' ORDER BY es.school_session DESC, es.school_term ASC, es.class_name ASC, es.section ASC';
        $statement = $this->pdo->prepare($sql);
        $statement->execute($params);

        return array_map([$this, 'normalizeExamSettingRow'], $statement->fetchAll());
    }

    public function examSettingByFilter(array $filters, array $user): ?array
    {
        $className = trim((string) ($filters['class_name'] ?? ''));
        $section = trim((string) ($filters['section'] ?? ''));
        $schoolTerm = trim((string) ($filters['school_term'] ?? ''));
        $schoolSession = trim((string) ($filters['school_session'] ?? ''));
        $subjectId = (int) ($filters['subject_id'] ?? 0);

        if ($className === '' || $section === '' || $schoolTerm === '' || $schoolSession === '' || $subjectId <= 0) {
            return null;
        }

        if (!$this->canUseExamSettingForUser($user, $className, $section, $subjectId)) {
            return null;
        }

        return $this->examSettingLookup([
            'class_name' => $className,
            'section' => $section,
            'school_term' => $schoolTerm,
            'school_session' => $schoolSession,
            'subject_id' => $subjectId,
        ]);
    }

    public function findOrCreateExamSetting(array $filters, array $user): ?array
    {
        $className = trim((string) ($filters['class_name'] ?? ''));
        $section = trim((string) ($filters['section'] ?? ''));
        $schoolTerm = trim((string) ($filters['school_term'] ?? ''));
        $schoolSession = trim((string) ($filters['school_session'] ?? ''));
        $subjectId = (int) ($filters['subject_id'] ?? 0);
        $examName = trim((string) ($filters['exam_name'] ?? '')) ?: 'Term Examination';
        $createdBy = (int) ($filters['created_by'] ?? ($user['id'] ?? 0));
        $lookup = [
            'class_name' => $className,
            'section' => $section,
            'school_term' => $schoolTerm,
            'school_session' => $schoolSession,
            'subject_id' => $subjectId,
        ];

        try {
            if ($className === '' || $section === '' || $schoolTerm === '' || $schoolSession === '' || $subjectId <= 0) {
                return null;
            }

            $existing = $this->examSettingLookup($lookup);
            if ($existing) {
                return $existing;
            }

            if (!$this->subjectById($subjectId)) {
                return null;
            }

            if (!$this->canUseExamSettingForUser($user, $className, $section, $subjectId)) {
                return null;
            }

            $startedTransaction = false;

            if (!$this->pdo->inTransaction()) {
                if (($this->pdo->getAttribute(PDO::ATTR_DRIVER_NAME) ?? '') === 'sqlite') {
                    $this->pdo->exec('BEGIN IMMEDIATE TRANSACTION');
                } else {
                    $this->pdo->beginTransaction();
                }
                $startedTransaction = true;
            }

            $existing = $this->examSettingLookup($lookup);
            if ($existing) {
                if ($startedTransaction && $this->pdo->inTransaction()) {
                    $this->pdo->commit();
                }
                return $existing;
            }

            $statement = $this->pdo->prepare(
                'INSERT INTO exam_settings (class_name, section, school_term, school_session, subject_id, exam_name, created_by, created_at)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?)'
            );
            $statement->execute([
                $className,
                $section,
                $schoolTerm,
                $schoolSession,
                $subjectId,
                $examName,
                $createdBy,
                date('Y-m-d'),
            ]);

            if ($startedTransaction && $this->pdo->inTransaction()) {
                $this->pdo->commit();
            }

            return $this->examSettingLookup($lookup);
        } catch (\Throwable $exception) {
            if (isset($startedTransaction) && $startedTransaction && $this->pdo->inTransaction()) {
                $this->pdo->rollBack();
            }

            error_log('[Exam setting auto-create failed] ' . $exception->getMessage());

            return null;
        }
    }

    public function saveExamSetting(array $data): void
    {
        if (($data['class_name'] ?? '') === '' || (int) ($data['subject_id'] ?? 0) <= 0) {
            return;
        }

        $statement = $this->pdo->prepare(
            'INSERT INTO exam_settings (class_name, section, school_term, school_session, subject_id, exam_name, created_by, created_at)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?)'
        );
        $statement->execute([
            $data['class_name'],
            $data['section'],
            $data['school_term'],
            $data['school_session'],
            $data['subject_id'],
            $data['exam_name'] ?: 'Term Examination',
            $data['created_by'],
            date('Y-m-d'),
        ]);
    }

    public function examSettingById(int $id, array $user): ?array
    {
        foreach ($this->examSettings($user) as $setting) {
            if ((int) $setting['id'] === $id) {
                return $setting;
            }
        }

        return null;
    }

    public function markDistributions(): array
    {
