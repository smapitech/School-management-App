        $certificates = [];

        if (str_contains($className, 'Primary 5') || str_contains($className, 'SSS')) {
            $certificates[] = [
                'title' => 'Completion Certificate',
                'status' => 'Ready',
                'issued_at' => date('Y-m-d'),
                'download' => '/student_portal/report-card',
            ];
        }

        return $certificates;
