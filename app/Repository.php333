    private function groupGalleryItems(array $items): array
    {
        $groups = [];
        foreach ($items as $item) {
            $category = trim((string) ($item['category'] ?? '')) ?: 'General';
            if (!isset($groups[$category])) {
                $groups[$category] = [
                    'category' => $category,
                    'items' => [],
                ];
            }
            $groups[$category]['items'][] = $item;
        }

        return array_values($groups);
    }

