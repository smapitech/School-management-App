<?php

declare(strict_types=1);

namespace App;

use PDO;

final class Repository
{
    public function __construct(private PDO $pdo)
    {
    }

    public function stats(): array
    {
        return [
            ['label' => 'Students', 'value' => $this->count('students'), 'detail' => 'active enrollment'],
            ['label' => 'Staff', 'value' => $this->count('staff'), 'detail' => 'academic and admin'],
            ['label' => 'Classes', 'value' => $this->count('classes'), 'detail' => 'configured sections'],
            ['label' => 'Admissions', 'value' => $this->count('admissions'), 'detail' => 'open applications'],
        ];
    }

    public function students(int $limit = 20): array
    {
        $statement = $this->pdo->prepare('SELECT * FROM students ORDER BY id DESC LIMIT :limit');
        $statement->bindValue(':limit', $limit, PDO::PARAM_INT);
        $statement->execute();

        return $statement->fetchAll();
    }

    public function announcements(): array
    {
        return $this->pdo->query('SELECT * FROM announcements ORDER BY id DESC LIMIT 4')->fetchAll();
    }

    public function createAnnouncement(array $data): void
    {
        $title = trim($data['title'] ?? '');
        if ($title === '') {
            return;
        }

        $statement = $this->pdo->prepare('INSERT INTO announcements (title, audience, publish_date) VALUES (?, ?, ?)');
        $statement->execute([
            $title,
            trim($data['audience'] ?? 'All Users') ?: 'All Users',
            trim($data['publish_date'] ?? date('Y-m-d')) ?: date('Y-m-d'),
        ]);
    }

    public function classesList(): array
    {
        return $this->pdo->query('SELECT * FROM classes ORDER BY name ASC')->fetchAll();
    }

    public function parentsList(int $limit = 100): array
    {
        $statement = $this->pdo->prepare(
            "SELECT id, guardian_full_name, guardian, guardian_relationship, guardian_mobile, parent_username, class_name, section, applicant
            FROM admissions
            WHERE parent_username <> '' OR guardian_mobile <> ''
            ORDER BY guardian_full_name ASC, guardian ASC
            LIMIT :limit"
        );
        $statement->bindValue(':limit', $limit, PDO::PARAM_INT);
        $statement->execute();

        return $statement->fetchAll();
    }

    public function communicationMessages(int $limit = 20): array
    {
        $sql = 'SELECT * FROM communication_messages ORDER BY id DESC';
        if ($limit > 0) {
            $sql .= ' LIMIT ' . $limit;
        }

        return $this->pdo->query($sql)->fetchAll();
    }

    public function createCommunicationMessage(array $data): void
    {
        if (($data['message'] ?? '') === '') {
            return;
        }

        $statement = $this->pdo->prepare(
            'INSERT INTO communication_messages (message_type, channel, audience, recipient_role, recipient_name, recipient_contact, subject, message, attachment_path, attachment_name, related_id, status, created_at)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)'
        );
        $statement->execute([
            $data['message_type'] ?? 'Internal',
            $data['channel'] ?? 'Internal',
            $data['audience'] ?? '',
            $data['recipient_role'] ?? '',
            $data['recipient_name'] ?? '',
            $data['recipient_contact'] ?? '',
            $data['subject'] ?? '',
            $data['message'],
            $data['attachment_path'] ?? '',
            $data['attachment_name'] ?? '',
            (int) ($data['related_id'] ?? 0),
            $data['status'] ?? 'Queued',
            date('Y-m-d'),
        ]);
    }

    public function deleteCommunicationMessage(int $id): void
    {
        if ($id <= 0) {
            return;
        }

        $statement = $this->pdo->prepare('DELETE FROM communication_messages WHERE id = ?');
        $statement->execute([$id]);
    }

    public function getParentsOfTeacherAssignedStudents(int $teacherId): array
    {
        if ($teacherId <= 0) {
            return [];
        }

        $parents = [];
        foreach ($this->teacherParentRowsIndexed($teacherId) as $key => $row) {
            $parents[$key] = $row;
        }

        uasort($parents, static function (array $left, array $right): int {
            $parentCompare = strcasecmp((string) ($left['parent_name'] ?? ''), (string) ($right['parent_name'] ?? ''));
            if ($parentCompare !== 0) {
                return $parentCompare;
            }

            return strcasecmp((string) ($left['student_name'] ?? ''), (string) ($right['student_name'] ?? ''));
        });

        return array_values($parents);
    }

    public function teacherCanMessageParent(int $teacherId, int $parentId): bool
    {
        if ($teacherId <= 0 || $parentId <= 0) {
            return false;
        }

        foreach ($this->getParentsOfTeacherAssignedStudents($teacherId) as $row) {
            if ((int) ($row['parent_id'] ?? 0) === $parentId) {
                return true;
            }
        }

        return false;
    }

    public function getFellowTeachers(int $teacherId): array
    {
        if ($teacherId <= 0) {
            return [];
        }

        $statement = $this->pdo->prepare(
            "SELECT id, employee_no, name, middle_name, surname, role, designation, department, status, email, username, mobile_no, staff_photo
            FROM staff
            WHERE status = ? AND LOWER(role) LIKE ?
            AND id <> ?
            ORDER BY name ASC, surname ASC"
        );
        $statement->execute(['Active', '%teacher%', $teacherId]);
        $rows = [];

        foreach ($statement->fetchAll() as $row) {
            $login = $this->teacherLoginAccountForStaff((int) ($row['id'] ?? 0), $row);
            $rows[] = [
                'teacher_id' => (int) ($row['id'] ?? 0),
                'employee_no' => $row['employee_no'] ?? '',
                'name' => trim(($row['name'] ?? '') . ' ' . ($row['middle_name'] ?? '') . ' ' . ($row['surname'] ?? '')),
                'role' => $row['role'] ?? '',
                'designation' => $row['designation'] ?? '',
                'department' => $row['department'] ?? '',
                'email' => $row['email'] ?? '',
                'username' => $row['username'] ?? '',
                'mobile_no' => $row['mobile_no'] ?? '',
                'staff_photo' => $row['staff_photo'] ?? '',
                'login_user_id' => (int) ($login['id'] ?? 0),
                'login_email' => $login['email'] ?? '',
            ];
        }

        return $rows;
    }

    public function teacherCanMessageTeacher(int $teacherId, int $otherTeacherId): bool
    {
        if ($teacherId <= 0 || $otherTeacherId <= 0 || $teacherId === $otherTeacherId) {
            return false;
        }

        foreach ($this->getFellowTeachers($teacherId) as $teacher) {
            if ((int) ($teacher['teacher_id'] ?? 0) === $otherTeacherId) {
                return true;
            }
        }

        return false;
    }

    public function getTeacherConversations(int $teacherId): array
    {
        if ($teacherId <= 0) {
            return [];
        }

        return $this->teacherConversationSummaries($teacherId);
    }

    public function getTeacherTodayTimetable(int $teacherId): array
    {
        if ($teacherId <= 0) {
            return [];
        }

        return $this->getTeacherTimetable($teacherId, [
            'day_of_week' => date('l'),
        ]);
    }

    public function getTeacherRecentMessages(int $teacherId): array
    {
        if ($teacherId <= 0) {
            return [
                'parent_messages' => [],
                'teacher_messages' => [],
            ];
        }

        $parentMessages = [];
        $teacherMessages = [];
        foreach ($this->getTeacherConversations($teacherId) as $conversation) {
            if (($conversation['conversation_type'] ?? '') === 'teacher_parent') {
                $parentMessages[] = $conversation;
                continue;
            }
            if (($conversation['conversation_type'] ?? '') === 'teacher_teacher') {
                $teacherMessages[] = $conversation;
            }
        }

        return [
            'parent_messages' => array_slice($parentMessages, 0, 3),
            'teacher_messages' => array_slice($teacherMessages, 0, 3),
        ];
    }

    public function getTeacherDashboardSummary(int $teacherId): array
    {
        $classes = $this->getTeacherAssignedClasses($teacherId);
        $subjects = $this->getTeacherAssignedSubjects($teacherId);
        $students = $this->getTeacherAssignedStudents($teacherId);
        $today = date('Y-m-d');
        $todayTimetable = $this->getTeacherTodayTimetable($teacherId);
        $recentMessages = $this->getTeacherRecentMessages($teacherId);
        $latestPayslip = $this->getTeacherLatestPayslip($teacherId);
        $attendanceSummary = $this->getTeacherAttendanceSummary($teacherId);
        $studentIds = array_map(static fn (array $student): int => (int) ($student['id'] ?? 0), $students);
        $markedAttendance = $studentIds ? $this->studentAttendanceRecords($today, $studentIds) : [];

        return [
            'teacher_id' => $teacherId,
            'today_date' => $today,
            'today_label' => date('l, d F Y'),
            'assigned_classes_count' => count($classes),
            'assigned_subjects_count' => count($subjects),
            'assigned_students_count' => count($students),
            'today_timetable_count' => count($todayTimetable),
            'pending_attendance_count' => max(0, count($studentIds) - count($markedAttendance)),
            'classes' => $classes,
            'subjects' => $subjects,
            'students' => $students,
            'today_timetable' => $todayTimetable,
            'recent_parent_messages' => $recentMessages['parent_messages'] ?? [],
            'recent_teacher_messages' => $recentMessages['teacher_messages'] ?? [],
            'latest_payslip' => $latestPayslip,
            'attendance_summary' => $attendanceSummary,
        ];
    }

    public function createTeacherParentConversation(int $teacherId, int $parentId, int $studentId, string $subject, string $message): int
    {
        $subject = trim($subject);
        $message = trim($message);

        if ($teacherId <= 0) {
            throw new \RuntimeException('Teacher access could not be resolved.');
        }
        if ($parentId <= 0 || $studentId <= 0) {
            throw new \InvalidArgumentException('Parent and student are required.');
        }
        if ($subject === '' || $message === '') {
            throw new \InvalidArgumentException('Subject and message are required.');
        }

        $parentRows = $this->teacherParentRowsIndexed($teacherId);
        $pairKey = $parentId . ':' . $studentId;
        if (!isset($parentRows[$pairKey])) {
            throw new \RuntimeException('You can only message parents linked to your assigned students.');
        }

        $existing = $this->findTeacherConversationByParticipants('teacher_parent', [
            'teacher_id' => $teacherId,
            'parent_id' => $parentId,
            'student_id' => $studentId,
            'subject' => $subject,
        ]);
        if ($existing) {
            $this->sendTeacherConversationMessage($teacherId, (int) $existing['id'], $message);
            return (int) $existing['id'];
        }

        $createdAt = date('Y-m-d H:i:s');
        $statement = $this->pdo->prepare(
            'INSERT INTO teacher_conversations (conversation_type, teacher_id, parent_id, other_teacher_id, student_id, subject, status, last_message_at, created_at, updated_at)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)'
        );
        $statement->execute([
            'teacher_parent',
            $teacherId,
            $parentId,
            null,
            $studentId,
            $subject,
            'open',
            $createdAt,
            $createdAt,
            $createdAt,
        ]);

        $conversationId = (int) $this->pdo->lastInsertId();
        $this->insertTeacherConversationMessage($conversationId, $teacherId, 'teacher', $message, ['attachment_path' => '', 'attachment_name' => '']);

        return $conversationId;
    }

    public function createTeacherTeacherConversation(int $teacherId, int $otherTeacherId, string $subject, string $message): int
    {
        $subject = trim($subject);
        $message = trim($message);

        if ($teacherId <= 0) {
            throw new \RuntimeException('Teacher access could not be resolved.');
        }
        if ($otherTeacherId <= 0 || $otherTeacherId === $teacherId) {
            throw new \InvalidArgumentException('A valid fellow teacher is required.');
        }
        if (!$this->teacherCanMessageTeacher($teacherId, $otherTeacherId)) {
            throw new \RuntimeException('You can only message fellow teachers.');
        }
        if ($subject === '' || $message === '') {
            throw new \InvalidArgumentException('Subject and message are required.');
        }

        $existing = $this->findTeacherConversationByParticipants('teacher_teacher', [
            'teacher_id' => $teacherId,
            'other_teacher_id' => $otherTeacherId,
            'subject' => $subject,
        ]);
        if ($existing) {
            $this->sendTeacherConversationMessage($teacherId, (int) $existing['id'], $message);
            return (int) $existing['id'];
        }

        $createdAt = date('Y-m-d H:i:s');
        $statement = $this->pdo->prepare(
            'INSERT INTO teacher_conversations (conversation_type, teacher_id, parent_id, other_teacher_id, student_id, subject, status, last_message_at, created_at, updated_at)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)'
        );
        $statement->execute([
            'teacher_teacher',
            $teacherId,
            null,
            $otherTeacherId,
            null,
            $subject,
            'open',
            $createdAt,
            $createdAt,
            $createdAt,
        ]);

        $conversationId = (int) $this->pdo->lastInsertId();
        $this->insertTeacherConversationMessage($conversationId, $teacherId, 'teacher', $message, ['attachment_path' => '', 'attachment_name' => '']);

        return $conversationId;
    }

    public function sendTeacherConversationMessage(int $teacherId, int $conversationId, string $message, $attachment = null): void
    {
        $message = trim($message);
        $attachmentData = is_array($attachment) ? $attachment : ['attachment_path' => '', 'attachment_name' => ''];

        if ($teacherId <= 0) {
            throw new \RuntimeException('Teacher access could not be resolved.');
        }
        if ($conversationId <= 0) {
            throw new \InvalidArgumentException('Conversation is required.');
        }
        if (!$this->teacherCanAccessConversation($teacherId, $conversationId)) {
            throw new \RuntimeException('You can only reply to your own conversations.');
        }
        if ($message === '' && trim((string) ($attachmentData['attachment_path'] ?? '')) === '') {
            throw new \InvalidArgumentException('Reply message is required.');
        }

        $this->insertTeacherConversationMessage($conversationId, $teacherId, 'teacher', $message, $attachmentData);
    }

    public function teacherCanAccessConversation(int $teacherId, int $conversationId): bool
    {
        if ($teacherId <= 0 || $conversationId <= 0) {
            return false;
        }

        $statement = $this->pdo->prepare(
            'SELECT 1 FROM teacher_conversations WHERE id = ? AND (teacher_id = ? OR other_teacher_id = ?) LIMIT 1'
        );
        $statement->execute([$conversationId, $teacherId, $teacherId]);

        return (bool) $statement->fetchColumn();
    }

    public function teacherConversationById(int $teacherId, int $conversationId): ?array
    {
        if (!$this->teacherCanAccessConversation($teacherId, $conversationId)) {
            return null;
        }

        $rows = $this->teacherConversationSummaries($teacherId, $conversationId);

        return $rows[0] ?? null;
    }

    public function teacherConversationMessages(int $teacherId, int $conversationId): array
    {
        if (!$this->teacherCanAccessConversation($teacherId, $conversationId)) {
            return [];
        }

        $conversation = $this->teacherConversationRow($conversationId);
        if (!$conversation) {
            return [];
        }

        $statement = $this->pdo->prepare(
            'SELECT * FROM teacher_conversation_messages WHERE conversation_id = ? ORDER BY id ASC'
        );
        $statement->execute([$conversationId]);
        $rows = [];

        foreach ($statement->fetchAll() as $row) {
            $row['sender_name'] = $this->teacherConversationSenderName($row, $conversation);
            $row['is_mine'] = (string) ($row['sender_role'] ?? '') === 'teacher' && (int) ($row['sender_id'] ?? 0) === $teacherId;
            $rows[] = $row;
        }

        return $rows;
    }

    public function createNotification(array $data): void
    {
        $title = trim($data['title'] ?? '');
        $message = trim($data['message'] ?? '');
        if ($title === '' || $message === '') {
            return;
        }

        $priority = in_array($data['priority'] ?? 'normal', ['low', 'normal', 'high', 'urgent'], true) ? $data['priority'] : 'normal';
        $type = in_array($data['type'] ?? 'general', $this->notificationTypes(), true) ? $data['type'] : 'general';
        $link = trim($data['link'] ?? '');
        if ($link !== '' && (!str_starts_with($link, '/') || str_starts_with($link, '//'))) {
            $link = '';
        }

        $statement = $this->pdo->prepare(
            'INSERT INTO notifications (user_id, role, title, message, type, priority, link, icon, expires_at, created_by, created_at)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)'
        );
        $statement->execute([
            !empty($data['user_id']) ? (int) $data['user_id'] : null,
            trim($data['role'] ?? '') ?: null,
            $title,
            $message,
            $type,
            $priority,
            $link ?: null,
            trim($data['icon'] ?? notification_icon($type)),
            trim($data['expires_at'] ?? '') ?: null,
            !empty($data['created_by']) ? (int) $data['created_by'] : null,
            date('Y-m-d H:i:s'),
        ]);
    }

    public function createNotificationForUser(int $userId, string $title, string $message, string $type = 'general', ?string $link = null, string $priority = 'normal', ?int $createdBy = null): void
    {
        $this->createNotification([
            'user_id' => $userId,
            'title' => $title,
            'message' => $message,
            'type' => $type,
            'link' => $link ?? '',
            'priority' => $priority,
            'created_by' => $createdBy ?? 0,
        ]);
    }

    public function createNotificationForRole(string $role, string $title, string $message, string $type = 'general', ?string $link = null, string $priority = 'normal', ?int $createdBy = null): void
    {
        $this->createNotification([
            'role' => $role,
            'title' => $title,
            'message' => $message,
            'type' => $type,
            'link' => $link ?? '',
            'priority' => $priority,
            'created_by' => $createdBy ?? 0,
        ]);
    }

    public function getUserNotifications(int $userId, string $role, int $limit = 20, bool $onlyUnread = false, string $status = ''): array
    {
        $where = [
            '(n.expires_at IS NULL OR n.expires_at = "" OR n.expires_at > ?)',
            '(n.user_id = ? OR (n.user_id IS NULL AND n.role = ?) OR (n.user_id IS NULL AND n.role IS NULL))',
            'COALESCE(s.is_deleted, 0) = 0',
        ];
        $params = [date('Y-m-d H:i:s'), $userId, $role];

        if ($onlyUnread || $status === 'unread') {
            $where[] = "(CASE WHEN n.user_id IS NOT NULL THEN n.is_read ELSE COALESCE(s.is_read, 0) END) = 0";
        } elseif ($status === 'read') {
            $where[] = "(CASE WHEN n.user_id IS NOT NULL THEN n.is_read ELSE COALESCE(s.is_read, 0) END) = 1";
        }

        $sql = "SELECT n.*, CASE WHEN n.user_id IS NOT NULL THEN n.is_read ELSE COALESCE(s.is_read, 0) END AS effective_is_read
            FROM notifications n
            LEFT JOIN notification_user_states s ON s.notification_id = n.id AND s.user_id = ? AND s.role = ?
            WHERE " . implode(' AND ', $where) . '
            ORDER BY n.created_at DESC, n.id DESC';
        $params = array_merge([$userId, $role], $params);

        if ($limit > 0) {
            $sql .= ' LIMIT ' . (int) $limit;
        }

        $statement = $this->pdo->prepare($sql);
        $statement->execute($params);

        return $statement->fetchAll();
    }

    public function getUnreadNotificationCount(int $userId, string $role): int
    {
        return count($this->getUserNotifications($userId, $role, 0, true));
    }

    public function getRecentNotifications(int $userId, string $role, int $limit = 5): array
    {
        return $this->getUserNotifications($userId, $role, $limit);
    }

    public function markNotificationAsRead(int $notificationId, int $userId, string $role): void
    {
        $notification = $this->visibleNotification($notificationId, $userId, $role);
        if (!$notification) {
            return;
        }
        if ((int) ($notification['user_id'] ?? 0) === $userId) {
            $statement = $this->pdo->prepare('UPDATE notifications SET is_read = 1, read_at = ?, updated_at = ? WHERE id = ?');
            $statement->execute([date('Y-m-d H:i:s'), date('Y-m-d H:i:s'), $notificationId]);
            return;
        }
        $statement = $this->pdo->prepare('REPLACE INTO notification_user_states (notification_id, user_id, role, is_read, is_deleted, read_at) VALUES (?, ?, ?, 1, 0, ?)');
        $statement->execute([$notificationId, $userId, $role, date('Y-m-d H:i:s')]);
    }

    public function markAllNotificationsAsRead(int $userId, string $role): void
    {
        foreach ($this->getUserNotifications($userId, $role, 0, true) as $notification) {
            $this->markNotificationAsRead((int) $notification['id'], $userId, $role);
        }
    }

    public function deleteNotification(int $notificationId, int $userId, string $role): void
    {
        $notification = $this->visibleNotification($notificationId, $userId, $role);
        if (!$notification) {
            return;
        }
        if ((int) ($notification['user_id'] ?? 0) === $userId) {
            $statement = $this->pdo->prepare('DELETE FROM notifications WHERE id = ?');
            $statement->execute([$notificationId]);
            return;
        }
        $statement = $this->pdo->prepare('REPLACE INTO notification_user_states (notification_id, user_id, role, is_read, is_deleted, deleted_at) VALUES (?, ?, ?, 0, 1, ?)');
        $statement->execute([$notificationId, $userId, $role, date('Y-m-d H:i:s')]);
    }

    public function getAllNotificationsForAdmin(array $filters = []): array
    {
        $where = [];
        $params = [];
        foreach (['role', 'type', 'priority'] as $field) {
            if (!empty($filters[$field])) {
                $where[] = "{$field} = ?";
                $params[] = $filters[$field];
            }
        }
        if (($filters['status'] ?? '') === 'read') {
            $where[] = 'is_read = 1';
        } elseif (($filters['status'] ?? '') === 'unread') {
            $where[] = 'is_read = 0';
        }
        if (!empty($filters['date'])) {
            $where[] = 'created_at LIKE ?';
            $params[] = $filters['date'] . '%';
        }
        $sql = 'SELECT * FROM notifications';
        if ($where) {
            $sql .= ' WHERE ' . implode(' AND ', $where);
        }
        $sql .= ' ORDER BY created_at DESC, id DESC LIMIT 200';
        $statement = $this->pdo->prepare($sql);
        $statement->execute($params);

        return $statement->fetchAll();
    }

    public function deleteNotificationAsAdmin(int $notificationId): void
    {
        $statement = $this->pdo->prepare('DELETE FROM notifications WHERE id = ?');
        $statement->execute([$notificationId]);
        $statement = $this->pdo->prepare('DELETE FROM notification_user_states WHERE notification_id = ?');
        $statement->execute([$notificationId]);
    }

    public function cleanupExpiredNotifications(): void
    {
        $statement = $this->pdo->prepare('DELETE FROM notifications WHERE expires_at IS NOT NULL AND expires_at <> "" AND expires_at < ?');
        $statement->execute([date('Y-m-d H:i:s')]);
    }

    public function notificationTypes(): array
    {
        return ['general', 'homework', 'attendance', 'exam', 'result', 'fees', 'message', 'announcement', 'admission', 'staff', 'parent', 'student', 'website', 'system'];
    }

    public function notificationPriorities(): array
    {
        return ['low', 'normal', 'high', 'urgent'];
    }

    private function visibleNotification(int $notificationId, int $userId, string $role): ?array
    {
        foreach ($this->getUserNotifications($userId, $role, 0) as $notification) {
            if ((int) $notification['id'] === $notificationId) {
                return $notification;
            }
        }
        return null;
    }

    public function createApiToken(int $userId, string $role, ?string $deviceName = null, ?string $deviceType = null): string
    {
        $token = bin2hex(random_bytes(32));
        $expiresAt = date('Y-m-d H:i:s', strtotime('+90 days'));
        $statement = $this->pdo->prepare(
            'INSERT INTO api_tokens (user_id, role, token_hash, device_name, device_type, expires_at, created_at)
            VALUES (?, ?, ?, ?, ?, ?, ?)'
        );
        $statement->execute([
            $userId,
            $role,
            hash('sha256', $token),
            $deviceName,
            $deviceType,
            $expiresAt,
            date('Y-m-d H:i:s'),
        ]);

        return $token;
    }

    public function validateApiToken(string $token): ?array
    {
        if ($token === '') {
            return null;
        }

        $statement = $this->pdo->prepare(
            'SELECT * FROM api_tokens
            WHERE token_hash = ? AND revoked_at IS NULL AND (expires_at IS NULL OR expires_at = "" OR expires_at > ?)
            LIMIT 1'
        );
        $statement->execute([hash('sha256', $token), date('Y-m-d H:i:s')]);
        $row = $statement->fetch();

        if (!$row) {
            return null;
        }

        $statement = $this->pdo->prepare('UPDATE api_tokens SET last_used_at = ? WHERE id = ?');
        $statement->execute([date('Y-m-d H:i:s'), (int) $row['id']]);

        return $row;
    }

    public function revokeApiToken(string $token): void
    {
        if ($token === '') {
            return;
        }

        $statement = $this->pdo->prepare('UPDATE api_tokens SET revoked_at = ? WHERE token_hash = ?');
        $statement->execute([date('Y-m-d H:i:s'), hash('sha256', $token)]);
    }

    public function getApiUserFromToken(string $token): ?array
    {
        $apiToken = $this->validateApiToken($token);
        if (!$apiToken) {
            return null;
        }

        return $this->userByRoleAndId((int) $apiToken['user_id'], (string) $apiToken['role']);
    }

    public function userByRoleAndId(int $id, string $role): ?array
    {
        if (in_array($role, ['superadmin', 'admin'], true)) {
            $statement = $this->pdo->prepare('SELECT * FROM users WHERE id = ? AND role = ? AND status = ? LIMIT 1');
            $statement->execute([$id, $role, 'Active']);
            $user = $statement->fetch();
            return $user ? $this->publicUser($user) : null;
        }

        if (in_array($role, ['teacher', 'accountant', 'receptionist'], true)) {
            $statement = $this->pdo->prepare("SELECT * FROM staff WHERE id = ? AND status = 'Active' LIMIT 1");
            $statement->execute([$id]);
            $staff = $statement->fetch();
            if ($staff && $this->staffRoleToLoginRole((string) ($staff['role'] ?? '')) === $role) {
                return [
                    'id' => (int) $staff['id'],
                    'name' => trim(($staff['name'] ?? '') . ' ' . ($staff['surname'] ?? '')),
                    'email' => $staff['username'] ?: ($staff['email'] ?? ''),
                    'role' => $this->staffRoleToLoginRole($staff['role'] ?? ''),
                    'photo' => $staff['staff_photo'] ?? '',
                ];
            }

            $statement = $this->pdo->prepare('SELECT id, email, name, role, status FROM users WHERE id = ? AND role = ? AND status = ? LIMIT 1');
            $statement->execute([$id, $role, 'Active']);
            $user = $statement->fetch();
            if (!$user || empty($user['email'])) {
                return null;
            }

            $statement = $this->pdo->prepare("SELECT * FROM staff WHERE (username = ? OR email = ?) AND status = 'Active' LIMIT 1");
            $statement->execute([$user['email'], $user['email']]);
            $staff = $statement->fetch();
            if (!$staff) {
                return [
                    'id' => (int) $user['id'],
                    'name' => $user['name'] ?? '',
                    'email' => $user['email'] ?? '',
                    'role' => $role,
                    'photo' => '',
                ];
            }

            return [
                'id' => (int) $staff['id'],
                'name' => trim(($staff['name'] ?? '') . ' ' . ($staff['surname'] ?? '')),
                'email' => $staff['username'] ?: ($staff['email'] ?? ''),
                'role' => $this->staffRoleToLoginRole($staff['role'] ?? ''),
                'photo' => $staff['staff_photo'] ?? '',
            ];
        }

        if ($role === 'student') {
            $student = $this->admissionById($id);
            if ($student) {
                return [
                'id' => (int) $student['id'],
                'name' => $student['applicant'] ?? trim(($student['first_name'] ?? '') . ' ' . ($student['last_name'] ?? '')),
                'email' => $student['username'] ?: ($student['email'] ?? ''),
                'role' => 'student',
                'photo' => $student['profile_picture'] ?? '',
                ];
            }

            $statement = $this->pdo->prepare('SELECT * FROM users WHERE id = ? AND role = ? AND status = ? LIMIT 1');
            $statement->execute([$id, 'student', 'Active']);
            $user = $statement->fetch();
            return $user ? $this->publicUser($user) : null;
        }

        if ($role === 'parent') {
            $student = $this->admissionById($id);
            if ($student) {
                return [
                'id' => (int) $student['id'],
                'name' => $student['guardian_full_name'] ?: ($student['guardian'] ?? 'Parent'),
                'email' => $student['parent_username'] ?: ($student['guardian_mobile'] ?? ''),
                'role' => 'parent',
                'photo' => $student['guardian_picture'] ?? '',
                ];
            }

            $statement = $this->pdo->prepare('SELECT * FROM users WHERE id = ? AND role = ? AND status = ? LIMIT 1');
            $statement->execute([$id, 'parent', 'Active']);
            $user = $statement->fetch();
            return $user ? $this->publicUser($user) : null;
        }

        return null;
    }

    public function publicUser(array $user): array
    {
        return [
            'id' => (int) ($user['id'] ?? 0),
            'name' => $user['name'] ?? '',
            'email' => $user['email'] ?? '',
            'role' => $user['role'] ?? '',
            'photo' => $user['photo'] ?? '',
        ];
    }

    public function findUserByEmail(string $email): ?array
    {
        $statement = $this->pdo->prepare('SELECT * FROM users WHERE email = ? AND status = ? LIMIT 1');
        $statement->execute([$email, 'Active']);
        $user = $statement->fetch();

        if ($user) {
            return $user;
        }

        $statement = $this->pdo->prepare("SELECT * FROM staff WHERE (username = ? OR email = ?) AND password <> '' AND status = 'Active' LIMIT 1");
        $statement->execute([$email, $email]);
        $staff = $statement->fetch();

        if ($staff) {
            return [
                'id' => $staff['id'],
                'name' => trim($staff['name'] . ' ' . ($staff['surname'] ?? '')),
                'email' => $staff['username'] ?: $staff['email'],
                'password' => $staff['password'],
                'role' => $this->staffRoleToLoginRole($staff['role'] ?? ''),
                'status' => 'Active',
            ];
        }

        $statement = $this->pdo->prepare("SELECT * FROM admissions WHERE (username = ? OR email = ?) AND password <> '' LIMIT 1");
        $statement->execute([$email, $email]);
        $student = $statement->fetch();

        if ($student) {
            return [
                'id' => $student['id'],
                'name' => $student['applicant'],
                'email' => $student['username'] ?: $student['email'],
                'password' => $student['password'],
                'role' => 'student',
                'status' => 'Active',
            ];
        }

        $statement = $this->pdo->prepare("SELECT * FROM admissions WHERE (parent_username = ? OR guardian_mobile = ?) AND parent_password <> '' LIMIT 1");
        $statement->execute([$email, $email]);
        $parent = $statement->fetch();

        if ($parent) {
            return [
                'id' => $parent['id'],
                'name' => $parent['guardian_full_name'] ?: $parent['guardian'],
                'email' => $parent['parent_username'] ?: $parent['guardian_mobile'],
                'password' => $parent['parent_password'],
                'role' => 'parent',
                'status' => 'Active',
            ];
        }

        return null;
    }

    private function staffRoleToLoginRole(string $role): string
    {
        return match (strtolower($role)) {
            'admin' => 'admin',
            'teacher', 'asst teacher', 'assistant teacher' => 'teacher',
            'accountant', 'account' => 'accountant',
            'receptionist' => 'receptionist',
            default => 'teacher',
        };
    }

    public function settings(): array
    {
        $rows = $this->pdo->query('SELECT setting_key, setting_value FROM settings')->fetchAll();
        $settings = [];

        foreach ($rows as $row) {
            $settings[$row['setting_key']] = $row['setting_value'];
        }

        return $settings;
    }

    public function updateSettings(array $settings): void
    {
        $statement = $this->pdo->prepare('REPLACE INTO settings (setting_key, setting_value) VALUES (?, ?)');

        foreach ($settings as $key => $value) {
            $statement->execute([$key, (string) $value]);
        }
    }

    public function getSetting(string $key, mixed $default = null): mixed
    {
        $statement = $this->pdo->prepare('SELECT setting_value FROM settings WHERE setting_key = ? LIMIT 1');
        $statement->execute([$key]);
        $value = $statement->fetchColumn();

        return $value === false ? $default : $value;
    }

    public function saveSetting(string $key, mixed $value): void
    {
        $statement = $this->pdo->prepare('REPLACE INTO settings (setting_key, setting_value) VALUES (?, ?)');
        $statement->execute([$key, (string) $value]);
    }

