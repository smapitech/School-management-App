            'classOptions' => $options['classOptions'],
            'subjectOptions' => $options['subjectOptions'],
            'sectionOptionsByClass' => $options['sectionOptionsByClass'],
            'subjectOptionsByClassSection' => $options['subjectOptionsByClassSection'],
            'days' => $this->teacherTimetableDays(),
            'isEdit' => false,
        ]);
        unset($_SESSION['teacher_timetable_old'], $_SESSION['teacher_timetable_errors']);
    }

    private function teacherTimetableEditForm(): void
    {
        $this->requirePermission('classes', 'edit_own_timetable');
        $user = Auth::user() ?? [];
        $teacherId = $this->repository->getCurrentTeacherIdFromUser((int) ($user['id'] ?? 0));
        $timetableId = (int) ($_GET['id'] ?? 0);
        if ($teacherId <= 0 || $timetableId <= 0) {
            $_SESSION['teacher_timetable_errors'] = [$this->teacherWorkspaceWarningMessage()];
            $this->redirect('/teacher/classes/timetable');
            return;
        }

        $rows = $this->repository->getTeacherTimetable($teacherId, ['id' => $timetableId]);
        $timetable = $rows[0] ?? null;
        if (!$timetable || (int) ($timetable['teacher_id'] ?? 0) !== $teacherId) {
            $_SESSION['teacher_timetable_errors'] = ['Timetable row not found in your assigned workspace.'];
            $this->redirect('/teacher/classes/timetable');
            return;
        }

        $options = $this->teacherTimetableFormOptions($teacherId);
        $defaults = [
            'id' => (int) $timetable['id'],
            'class_id' => (int) ($timetable['class_id'] ?? 0),
            'section' => $timetable['section'] ?? '',
            'subject_id' => (int) ($timetable['subject_id'] ?? 0),
            'day_of_week' => $timetable['day_of_week'] ?? '',
            'start_time' => $timetable['start_time'] ?? '',
            'end_time' => $timetable['end_time'] ?? '',
            'room' => $timetable['room'] ?? '',
            'note' => $timetable['note'] ?? '',
        ];
        $formValues = array_merge($defaults, $_SESSION['teacher_timetable_old'] ?? []);

        $this->render('classes/teacher_timetable_form', [
            'title' => 'Edit Timetable',
            'timetable' => $timetable,
            'formValues' => $formValues,
            'errors' => $_SESSION['teacher_timetable_errors'] ?? [],
            'classOptions' => $options['classOptions'],
            'subjectOptions' => $options['subjectOptions'],
            'sectionOptionsByClass' => $options['sectionOptionsByClass'],
            'subjectOptionsByClassSection' => $options['subjectOptionsByClassSection'],
            'days' => $this->teacherTimetableDays(),
            'isEdit' => true,
        ]);
        unset($_SESSION['teacher_timetable_old'], $_SESSION['teacher_timetable_errors']);
    }

