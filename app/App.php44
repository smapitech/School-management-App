    private function saveExamMarks(): void
    {
        $this->requirePermission('exams', 'edit');
        $user = Auth::user() ?? [];
        $settingId = (int) ($_POST['exam_setting_id'] ?? 0);
        $setting = null;

        foreach ($this->repository->examSettings($user) as $row) {
            if ((int) $row['id'] === $settingId) {
                $setting = $row;
                break;
            }
        }

        if (!$setting) {
            $this->forbidden();
            return;
        }

        $staff = $this->repository->staffByEmail($user['email'] ?? '');
        $editStudentId = (int) ($_POST['edit_student_id'] ?? 0);
        $blocked = $this->repository->saveExamMarks($settingId, $_POST['marks'] ?? [], (int) ($staff['id'] ?? 0), $editStudentId, $_POST['comments'] ?? []);
        $this->repository->createNotificationForRole('student', 'Exam marks updated', 'Marks for ' . ($setting['subject_name'] ?? 'a subject') . ' have been updated.', 'result', '/student_portal/report', 'normal', (int) ($user['id'] ?? 0));
        $this->repository->createNotificationForRole('parent', 'Exam marks updated', 'A result record has been updated for your child.', 'result', '/parent_portal', 'normal', (int) ($user['id'] ?? 0));
        $notice = $blocked > 0 ? '&notice=' . urlencode('Mark already created. Use Edit before changing saved student marks.') : '';
        $this->redirect('/exams/marks?class_name=' . urlencode($setting['class_name']) . '&section=' . urlencode($setting['section']) . '&school_term=' . urlencode($setting['school_term']) . '&school_session=' . urlencode($setting['school_session']) . '&subject_id=' . urlencode((string) $setting['subject_id']) . $notice);
    }

    private function deleteExamMarks(): void
    {
        $this->requirePermission('exams', 'delete');
        $user = Auth::user() ?? [];
        $settingId = (int) ($_POST['exam_setting_id'] ?? 0);
        $studentId = (int) ($_POST['student_id'] ?? 0);
        $setting = $this->repository->examSettingById($settingId, $user);

        if (!$setting) {
            $this->forbidden();
            return;
        }

        $this->repository->deleteExamMarksForStudent($settingId, $studentId);
        $this->redirect('/exams/marks?class_name=' . urlencode($setting['class_name']) . '&section=' . urlencode($setting['section']) . '&school_term=' . urlencode($setting['school_term']) . '&school_session=' . urlencode($setting['school_session']) . '&subject_id=' . urlencode((string) $setting['subject_id']));
    }

