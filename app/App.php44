            '/exams/marksheet-templates/delete' => $this->deleteMarksheetTemplate(),
            '/fees/create' => $this->createFee(),
            '/accounting/student/create' => $this->createFee(),
            '/accounting/student/reminder' => $this->createFeeReminder(),
            '/accounting/office/create' => $this->createOfficeTransaction(),
            '/accounting/office/delete' => $this->deleteOfficeTransaction(),
            '/communication/internal/send' => $this->sendInternalMessage(),
            '/communication/invoices/send' => $this->sendInvoiceMessage(),
            '/communication/reminders/send' => $this->sendReminderMessage(),
            '/communication/messages/delete' => $this->deleteCommunicationMessage(),
            '/student_portal/assignment/submit' => $this->submitStudentAssignment(),
            '/homework/save' => $this->saveHomework(),
            '/homework/delete' => $this->deleteHomework(),
            '/homework/close' => $this->closeHomework(),
            '/homework/mark' => $this->markHomeworkSubmission(),
            '/notifications/read' => $this->notificationRead(),
            '/notifications/read-all' => $this->notificationReadAll(),
            '/notifications/delete' => $this->notificationDelete(),
            '/notification-manager/send' => $this->notificationManagerSend(),
            '/notification-manager/delete' => $this->notificationManagerDelete(),
            '/notification-manager/cleanup' => $this->notificationManagerCleanup(),
