    private function sendInternalMessage(): void
    {
        $this->requirePermission('communication', 'create');
        $user = Auth::user() ?? [];
        if (($user['role'] ?? '') === 'teacher') {
            $this->forbidden();
            return;
        }
        $audience = trim($_POST['audience'] ?? 'Staff');
        $message = trim($_POST['message'] ?? '');
        $recipientRole = trim($_POST['recipient_role'] ?? '');

        $this->repository->createCommunicationMessage([
            'message_type' => 'Internal',
            'channel' => trim($_POST['channel'] ?? 'Internal'),
            'audience' => $audience,
            'recipient_role' => $recipientRole,
            'subject' => trim($_POST['subject'] ?? ''),
            'message' => $message,
            ...$this->storeCommunicationAttachment(),
            'status' => 'Queued',
        ]);
        if ($recipientRole !== '') {
            $this->repository->createNotificationForRole($recipientRole, trim($_POST['subject'] ?? 'New message'), 'A new internal message is available.', 'message', '/communication/internal', 'normal', (int) ($user['id'] ?? 0));
        }
        $this->redirect('/communication/internal');
    }

    private function sendTeacherMessage(): void
    {
        $this->requireLogin();
        $this->verifyCsrfOrForbidden();
        $user = Auth::user() ?? [];
        $teacherId = $this->repository->getCurrentTeacherIdFromUser((int) ($user['id'] ?? 0));
        $conversationType = trim($_POST['conversation_type'] ?? '');

        if ($teacherId <= 0) {
            $this->notFound();
            return;
        }

        try {
            if ($conversationType === 'teacher_parent') {
                if (!Auth::can('communication', 'message_assigned_parents', $user)) {
                    $this->forbidden();
                    return;
                }

                $parentId = (int) ($_POST['parent_id'] ?? 0);
                $studentId = (int) ($_POST['student_id'] ?? 0);
                $pairTarget = trim((string) ($_POST['parent_student_target'] ?? ''));
                if (($parentId <= 0 || $studentId <= 0) && preg_match('/^(\d+):(\d+)$/', $pairTarget, $matches)) {
                    $parentId = (int) $matches[1];
                    $studentId = (int) $matches[2];
                }
                $subject = trim($_POST['subject'] ?? '');
                $message = trim($_POST['message'] ?? '');
                $conversationId = $this->repository->createTeacherParentConversation($teacherId, $parentId, $studentId, $subject, $message);
                $conversation = $this->repository->teacherConversationById($teacherId, $conversationId);
                if ($conversation) {
                    $this->notifyTeacherConversationRecipient($conversation, $teacherId, $subject, $message, (int) ($user['id'] ?? 0));
                }
            } elseif ($conversationType === 'teacher_teacher') {
                if (!Auth::can('communication', 'message_teachers', $user)) {
                    $this->forbidden();
                    return;
                }

                $otherTeacherId = (int) ($_POST['other_teacher_id'] ?? 0);
                $subject = trim($_POST['subject'] ?? '');
                $message = trim($_POST['message'] ?? '');
                $conversationId = $this->repository->createTeacherTeacherConversation($teacherId, $otherTeacherId, $subject, $message);
                $conversation = $this->repository->teacherConversationById($teacherId, $conversationId);
                if ($conversation) {
                    $this->notifyTeacherConversationRecipient($conversation, $teacherId, $subject, $message, (int) ($user['id'] ?? 0));
                }
            } else {
                throw new \InvalidArgumentException('Conversation type is invalid.');
            }

            $_SESSION['teacher_message_success'] = 'Conversation started successfully.';
            unset($_SESSION['teacher_message_old'], $_SESSION['teacher_message_errors']);
            $this->redirect('/teacher/messages/view?id=' . $conversationId);
        } catch (\Throwable $exception) {
            $_SESSION['teacher_message_old'] = [
                'conversation_type' => $conversationType,
                'parent_id' => (int) ($_POST['parent_id'] ?? 0),
                'student_id' => (int) ($_POST['student_id'] ?? 0),
                'other_teacher_id' => (int) ($_POST['other_teacher_id'] ?? 0),
                'subject' => trim($_POST['subject'] ?? ''),
                'message' => trim($_POST['message'] ?? ''),
            ];
            $_SESSION['teacher_message_errors'] = [($exception instanceof \InvalidArgumentException || $exception instanceof \RuntimeException)
                ? $exception->getMessage()
                : 'Unable to start the conversation right now.'];
            $this->redirect($conversationType === 'teacher_teacher' ? '/teacher/messages/teachers' : '/teacher/messages/parents');
        }
    }

    private function replyTeacherMessage(): void
    {
        $this->requirePermission('communication', 'view_own_conversations');
        $this->verifyCsrfOrForbidden();
        $user = Auth::user() ?? [];
        $teacherId = $this->repository->getCurrentTeacherIdFromUser((int) ($user['id'] ?? 0));
        $conversationId = (int) ($_POST['conversation_id'] ?? 0);

        if ($teacherId <= 0 || $conversationId <= 0) {
            $this->notFound();
            return;
        }

        try {
            $attachment = $this->storeCommunicationAttachment();
            $message = trim($_POST['message'] ?? '');
            $conversation = $this->repository->teacherConversationById($teacherId, $conversationId);
            if (!$conversation) {
                $this->notFound();
                return;
            }

            $this->repository->sendTeacherConversationMessage($teacherId, $conversationId, $message, $attachment);
            $this->notifyTeacherConversationRecipient($conversation, $teacherId, $conversation['subject'] ?? 'New message', $message, (int) ($user['id'] ?? 0), $attachment);
            $_SESSION['teacher_message_success'] = 'Reply sent successfully.';
        } catch (\Throwable $exception) {
            $_SESSION['teacher_message_errors'] = [($exception instanceof \InvalidArgumentException || $exception instanceof \RuntimeException)
                ? $exception->getMessage()
                : 'Unable to send the reply right now.'];
        }

        $this->redirect('/teacher/messages/view?id=' . $conversationId);
    }

    private function sendInvoiceMessage(): void
    {
        $this->requirePermission('communication', 'create');
        if ((Auth::user()['role'] ?? '') === 'teacher') {
            $this->forbidden();
            return;
        }
        $feeId = (int) ($_POST['fee_id'] ?? 0);
        $fee = null;
        foreach ($this->repository->fees() as $row) {
            if ((int) $row['id'] === $feeId) {
                $fee = $row;
                break;
            }
        }

        if ($fee) {
            $this->repository->createCommunicationMessage([
                'message_type' => 'Invoice',
                'channel' => trim($_POST['channel'] ?? 'Email'),
                'audience' => 'Parents and Student',
                'recipient_name' => $fee['student_name'],
                'subject' => 'School Fee Invoice ' . $fee['invoice_no'],
                'message' => trim($_POST['message'] ?? '') ?: 'Invoice ' . $fee['invoice_no'] . ' amount ' . money($fee['amount']) . ' is ' . $fee['status'] . '.',
                ...$this->storeCommunicationAttachment(),
                'related_id' => $feeId,
                'status' => 'Queued',
            ]);
        }
        $this->redirect('/communication/invoices');
    }

    private function sendReminderMessage(): void
    {
        $this->requirePermission('communication', 'create');
        if ((Auth::user()['role'] ?? '') === 'teacher') {
            $this->forbidden();
            return;
        }

        $this->repository->createCommunicationMessage([
            'message_type' => 'Reminder',
            'channel' => trim($_POST['channel'] ?? 'Email'),
            'audience' => trim($_POST['audience'] ?? 'Parents'),
            'recipient_role' => 'parent',
            'subject' => trim($_POST['subject'] ?? 'School Fee Reminder'),
            'message' => trim($_POST['message'] ?? ''),
            ...$this->storeCommunicationAttachment(),
            'status' => 'Queued',
        ]);
        $this->redirect('/communication/reminders');
    }

    private function deleteCommunicationMessage(): void
    {
        $this->requirePermission('communication', 'create');
        $return = trim($_POST['return_to'] ?? '/communication');

        if (!str_starts_with($return, '/communication')) {
            $return = '/communication';
        }

        $this->repository->deleteCommunicationMessage((int) ($_POST['id'] ?? 0));
        $this->redirect($return);
    }

    private function submitStudentAssignment(): void
    {
        $this->requirePermission('student_portal', 'edit');
        $student = $this->repository->studentForPortal(Auth::user() ?? []);

        if (!$student) {
            $this->forbidden();
            return;
        }

        $this->repository->submitHomework([
            'assignment_id' => (int) ($_POST['assignment_id'] ?? 0),
            'student_id' => (int) $student['id'],
            'submission_text' => trim($_POST['submission_text'] ?? ''),
            'submission_link' => trim($_POST['submission_link'] ?? ''),
            ...$this->storeHomeworkUpload('attachment', 'submission'),
        ]);
        $this->repository->createNotificationForRole('teacher', 'Homework submitted', ($student['applicant'] ?? 'A student') . ' submitted homework.', 'homework', '/homework/submissions', 'normal', (int) $student['id']);

        $this->redirect('/student_portal/homework');
    }

    private function saveHomework(): void
    {
        $this->requirePermission('homework', 'create');
        $user = Auth::user() ?? [];
        $id = (int) ($_POST['id'] ?? 0);
        $existing = $id > 0 ? $this->repository->homeworkById($id) : null;

        if ($existing && !$this->canManageHomework($existing, $user)) {
            $this->forbidden();
            return;
        }

        $subjectId = (int) ($_POST['subject_id'] ?? 0);
        $subject = $this->repository->subjectById($subjectId);
        $data = [
            'id' => $id,
            'teacher_id' => $this->homeworkTeacherId($user),
            'class_name' => trim($_POST['class_name'] ?? ''),
            'section' => trim($_POST['section'] ?? ''),
            'subject_id' => $subjectId,
            'subject' => $subject['subject_name'] ?? trim($_POST['subject'] ?? ''),
            'title' => trim($_POST['title'] ?? ''),
            'topic' => trim($_POST['topic'] ?? ''),
            'description' => trim($_POST['description'] ?? ''),
            'due_at' => trim($_POST['due_at'] ?? ''),
            'due_date' => substr(trim($_POST['due_at'] ?? ''), 0, 10),
            'total_marks' => (float) ($_POST['total_marks'] ?? 100),
            'submission_type' => trim($_POST['submission_type'] ?? 'both'),
            'resource_link' => trim($_POST['resource_link'] ?? ''),
            'allow_late_submission' => isset($_POST['allow_late_submission']) ? 1 : 0,
            'status' => trim($_POST['status'] ?? 'draft'),
            'created_by' => (int) ($user['id'] ?? 0),
            'updated_by' => (int) ($user['id'] ?? 0),
            ...$this->storeHomeworkUpload('attachment', 'teacher'),
        ];

        $errors = $this->validateHomework($data, $user);
        if ($errors) {
            $_SESSION['homework_errors'] = $errors;
            $this->redirect($id > 0 ? '/homework/edit?id=' . $id : '/homework/create');
            return;
        }

        $this->repository->saveHomework($data, $id ?: null);
        if ($data['status'] === 'published') {
            $this->repository->createNotificationForRole('student', 'New homework published', $data['title'] . ' has been posted for ' . $data['class_name'] . ' ' . $data['section'] . '.', 'homework', '/student_portal/homework', 'normal', (int) ($user['id'] ?? 0));
            $this->repository->createNotificationForRole('parent', 'New homework published', $data['title'] . ' has been posted for your child.', 'homework', '/parent_portal', 'normal', (int) ($user['id'] ?? 0));
        }
        $this->redirect('/homework');
    }

    private function deleteHomework(): void
    {
        $this->requirePermission('homework', 'delete');
        $homework = $this->repository->homeworkById((int) ($_POST['id'] ?? 0));
        if (!$homework || !$this->canManageHomework($homework, Auth::user() ?? [])) {
            $this->forbidden();
            return;
        }

        $this->repository->deleteHomework((int) $homework['id']);
        $this->redirect('/homework');
    }

    private function closeHomework(): void
    {
        $this->requirePermission('homework', 'edit');
        $homework = $this->repository->homeworkById((int) ($_POST['id'] ?? 0));
        if (!$homework || !$this->canManageHomework($homework, Auth::user() ?? [])) {
            $this->forbidden();
            return;
        }

        $this->repository->updateHomeworkStatus((int) $homework['id'], trim($_POST['status'] ?? 'closed'));
        $this->redirect('/homework');
    }

    private function markHomeworkSubmission(): void
    {
        $this->requirePermission('homework', 'edit');
        $submission = $this->repository->homeworkSubmissionById((int) ($_POST['submission_id'] ?? 0));
        $homework = $submission ? $this->repository->homeworkById((int) $submission['assignment_id']) : null;

        if (!$submission || !$homework || !$this->canManageHomework($homework, Auth::user() ?? [])) {
            $this->forbidden();
            return;
        }

        $this->repository->markHomeworkSubmission([
            'submission_id' => (int) $submission['id'],
            'score' => (float) ($_POST['score'] ?? 0),
            'feedback' => trim($_POST['feedback'] ?? ''),
            'status' => trim($_POST['status'] ?? 'marked'),
            'private_note' => trim($_POST['private_note'] ?? ''),
            'marked_by' => (int) ((Auth::user() ?? [])['id'] ?? 0),
            ...$this->storeHomeworkUpload('correction_attachment', 'correction'),
        ]);

        $this->redirect('/homework/submissions?homework_id=' . (int) $homework['id']);
    }

    private function settings(): void
    {
        $this->requirePermission('settings', 'view');
        $settings = $this->repository->settings();

        $this->render('settings', [
            'title' => 'Global Settings',
            'settings' => $settings,
            'theme' => ui_theme_from_settings($settings),
            'themePresets' => ui_theme_presets(),
            'settingsError' => $_SESSION['settings_error'] ?? '',
            'settingsSuccess' => $_SESSION['settings_success'] ?? '',
            'roles' => Auth::ROLES,
            'permissions' => Auth::ROLE_PERMISSIONS,
        ]);
        unset($_SESSION['settings_error'], $_SESSION['settings_success']);
    }

    private function updateSettings(): void
    {
        $this->requirePermission('settings', 'edit');
        $this->verifyCsrfOrForbidden();
        $current = $this->repository->settings();

        $settings = [
            'school_name' => trim($_POST['school_name'] ?? ($current['school_name'] ?? '')),
            'school_short_name' => trim($_POST['school_short_name'] ?? ($current['school_short_name'] ?? '')),
            'school_email' => trim($_POST['school_email'] ?? ($current['school_email'] ?? '')),
            'school_phone' => trim($_POST['school_phone'] ?? ($current['school_phone'] ?? '')),
            'school_address' => trim($_POST['school_address'] ?? ($current['school_address'] ?? '')),
            'academic_year' => trim($_POST['academic_year'] ?? ($current['academic_year'] ?? '')),
            'email_driver' => trim($_POST['email_driver'] ?? ($current['email_driver'] ?? 'SMTP')),
            'smtp_host' => trim($_POST['smtp_host'] ?? ($current['smtp_host'] ?? '')),
            'smtp_port' => trim($_POST['smtp_port'] ?? ($current['smtp_port'] ?? '')),
            'smtp_username' => trim($_POST['smtp_username'] ?? ($current['smtp_username'] ?? '')),
            'smtp_password' => trim($_POST['smtp_password'] ?? ($current['smtp_password'] ?? '')),
            'smtp_from_email' => trim($_POST['smtp_from_email'] ?? ($current['smtp_from_email'] ?? '')),
            'sms_api_url' => trim($_POST['sms_api_url'] ?? ($current['sms_api_url'] ?? '')),
            'sms_api_key' => trim($_POST['sms_api_key'] ?? ($current['sms_api_key'] ?? '')),
            'sms_sender_id' => trim($_POST['sms_sender_id'] ?? ($current['sms_sender_id'] ?? '')),
            'whatsapp_api_url' => trim($_POST['whatsapp_api_url'] ?? ($current['whatsapp_api_url'] ?? '')),
            'whatsapp_api_token' => trim($_POST['whatsapp_api_token'] ?? ($current['whatsapp_api_token'] ?? '')),
            'whatsapp_phone_number_id' => trim($_POST['whatsapp_phone_number_id'] ?? ($current['whatsapp_phone_number_id'] ?? '')),
            'logo_path' => $current['logo_path'] ?? '',
            'favicon_path' => $current['favicon_path'] ?? '',
            'login_background_path' => $current['login_background_path'] ?? '',
        ];

        $themeDefaults = ui_theme_default_colors();
        $themePreset = trim($_POST['ui_theme_preset'] ?? ($current['ui_theme_preset'] ?? 'gmail_material'));
        $themePresets = ui_theme_presets();

        if (!isset($themePresets[$themePreset])) {
            $themePreset = 'custom';
        }

        if (isset($_POST['reset_ui_theme'])) {
            $themePreset = 'gmail_material';
            foreach ($themeDefaults as $key => $value) {
                $settings['ui_' . $key] = $value;
            }
        } else {
            foreach ($themeDefaults as $key => $fallback) {
                $posted = $_POST['ui_' . $key . '_hex'] ?? $_POST['ui_' . $key] ?? null;
                if ($posted !== null && !is_valid_hex_color($posted)) {
                    $_SESSION['settings_error'] = 'Invalid theme color submitted. Please use valid hex colors such as #FFFFFF or #fff.';
                    $this->redirect('/settings');
                }
                $settings['ui_' . $key] = normalize_hex_color($posted ?? ($current['ui_' . $key] ?? $fallback), $fallback);
            }
        }
        $settings['ui_theme_preset'] = $themePreset;

        if (Auth::can('settings', 'upload')) {
            if (isset($_POST['delete_logo'])) {
                $this->deleteSettingAsset($settings['logo_path']);
                $settings['logo_path'] = '';
            }
            if (isset($_POST['delete_favicon'])) {
                $this->deleteSettingAsset($settings['favicon_path']);
                $settings['favicon_path'] = '';
            }
            if (isset($_POST['delete_login_background'])) {
                $this->deleteSettingAsset($settings['login_background_path']);
                $settings['login_background_path'] = '';
            }
            if (isset($_FILES['logo']) && ($_FILES['logo']['error'] ?? UPLOAD_ERR_NO_FILE) === UPLOAD_ERR_OK) {
                $upload = $this->storeSettingAsset($_FILES['logo'], 'logo', ['jpg', 'jpeg', 'png', 'gif', 'webp', 'svg']);
                $settings['logo_path'] = $upload ?: $settings['logo_path'];
            }
            if (isset($_FILES['favicon']) && ($_FILES['favicon']['error'] ?? UPLOAD_ERR_NO_FILE) === UPLOAD_ERR_OK) {
                $upload = $this->storeSettingAsset($_FILES['favicon'], 'favicon', ['ico', 'png', 'jpg', 'jpeg', 'svg', 'webp']);
                $settings['favicon_path'] = $upload ?: $settings['favicon_path'];
            }
            if (isset($_FILES['login_background']) && ($_FILES['login_background']['error'] ?? UPLOAD_ERR_NO_FILE) === UPLOAD_ERR_OK) {
                $upload = $this->storeSettingAsset($_FILES['login_background'], 'login-bg', ['jpg', 'jpeg', 'png', 'gif', 'webp']);
                $settings['login_background_path'] = $upload ?: $settings['login_background_path'];
            }
        }

        $this->repository->updateSettings($settings);
        $_SESSION['settings_success'] = isset($_POST['reset_ui_theme']) ? 'UI theme reset to Gmail Material Default.' : 'Settings saved successfully.';
        $this->redirect('/settings');
    }

    private function storeLogo(array $file): string
    {
        return $this->storeSettingAsset($file, 'logo', ['jpg', 'jpeg', 'png', 'gif', 'webp', 'svg']);
    }

    private function storeSettingAsset(array $file, string $prefix, array $allowed): string
    {
        $extension = strtolower(pathinfo($file['name'], PATHINFO_EXTENSION));

        if (!in_array($extension, $allowed, true)) {
            return '';
        }

        $uploadDir = dirname(__DIR__) . '/public/uploads/settings';

        if (!is_dir($uploadDir)) {
            mkdir($uploadDir, 0775, true);
        }

        $name = $prefix . '-' . date('YmdHis') . '-' . bin2hex(random_bytes(3)) . '.' . $extension;
        move_uploaded_file($file['tmp_name'], $uploadDir . '/' . $name);

        return '/uploads/settings/' . $name;
    }

    private function deleteSettingAsset(string $path): void
    {
        if ($path === '' || !str_starts_with($path, '/uploads/settings/')) {
            return;
        }

        $file = realpath(dirname(__DIR__) . '/public' . $path);
        $settingsDir = realpath(dirname(__DIR__) . '/public/uploads/settings');

        if ($file && $settingsDir && str_starts_with($file, $settingsDir) && is_file($file)) {
            unlink($file);
        }
    }

