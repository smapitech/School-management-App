    private function teacherPayroll(): void
    {
        $this->requirePermission('payroll', 'view_own_payslips');
        $user = Auth::user() ?? [];
        $teacherId = $this->repository->getCurrentTeacherIdFromUser((int) ($user['id'] ?? 0));
        if ($teacherId <= 0) {
            $this->notFound();
            return;
        }

        $staff = $this->repository->staffById($teacherId);
        if (!$staff) {
            $this->notFound();
            return;
        }

        $payslips = $this->repository->getTeacherPayslips($teacherId);
        $allowances = $this->repository->getTeacherAllowances($teacherId);
        $deductions = $this->repository->getTeacherDeductions($teacherId);
        $increments = $this->repository->getTeacherIncrements($teacherId);

        $this->render('staff/teacher_payroll', [
            'title' => 'Payroll',
            'staff' => $staff,
            'payslips' => $payslips,
            'allowances' => $allowances,
            'deductions' => $deductions,
            'increments' => $increments,
            'attendanceSummary' => $this->repository->getTeacherStaffAttendanceSummary($teacherId),
            'totals' => [
                'payslips' => count($payslips),
                'allowances' => array_sum(array_map(static fn (array $row): float => (float) ($row['total_allowance'] ?? 0), $allowances)),
                'deductions' => array_sum(array_map(static fn (array $row): float => (float) ($row['deduction_amount'] ?? 0), $deductions)),
                'increments' => array_sum(array_map(static fn (array $row): float => (float) ($row['increment_amount'] ?? 0), $increments)),
                'net_pay' => array_sum(array_map(static fn (array $row): float => (float) ($row['net_pay'] ?? 0), $payslips)),
            ],
            'latestPayslip' => $payslips[0] ?? null,
        ]);
    }

