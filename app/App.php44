    private function teacherMessages(): void
    {
        $this->requirePermission('communication', 'view_own_conversations');
        $user = Auth::user() ?? [];
        $teacherId = $this->repository->getCurrentTeacherIdFromUser((int) ($user['id'] ?? 0));
        if ($teacherId <= 0) {
            $this->notFound();
            return;
        }

        $conversations = $this->repository->getTeacherConversations($teacherId);
        $parents = $this->repository->getParentsOfTeacherAssignedStudents($teacherId);
        $teachers = $this->repository->getFellowTeachers($teacherId);
        $parentConversations = array_values(array_filter($conversations, fn (array $row): bool => ($row['conversation_type'] ?? '') === 'teacher_parent'));
        $teacherConversations = array_values(array_filter($conversations, fn (array $row): bool => ($row['conversation_type'] ?? '') === 'teacher_teacher'));

        $this->render('communication/teacher_messages', [
            'title' => 'Teacher Messages',
            'conversations' => $conversations,
            'parentConversations' => $parentConversations,
            'teacherConversations' => $teacherConversations,
            'parents' => $parents,
            'teachers' => $teachers,
            'success' => $_SESSION['teacher_message_success'] ?? '',
            'errors' => $_SESSION['teacher_message_errors'] ?? [],
        ]);
        unset($_SESSION['teacher_message_success'], $_SESSION['teacher_message_errors']);
    }

    private function teacherParentMessages(): void
    {
        $this->requirePermission('communication', 'message_assigned_parents');
        $user = Auth::user() ?? [];
        $teacherId = $this->repository->getCurrentTeacherIdFromUser((int) ($user['id'] ?? 0));
        if ($teacherId <= 0) {
            $this->notFound();
            return;
        }

        $parents = $this->repository->getParentsOfTeacherAssignedStudents($teacherId);
        $conversations = array_values(array_filter(
            $this->repository->getTeacherConversations($teacherId),
            fn (array $row): bool => ($row['conversation_type'] ?? '') === 'teacher_parent'
        ));

        $this->render('communication/teacher_parent_messages', [
            'title' => 'Parent Messages',
            'parents' => $parents,
            'conversations' => $conversations,
            'formValues' => $_SESSION['teacher_message_old'] ?? ['conversation_type' => 'teacher_parent', 'parent_id' => 0, 'student_id' => 0, 'subject' => '', 'message' => ''],
            'success' => $_SESSION['teacher_message_success'] ?? '',
            'errors' => $_SESSION['teacher_message_errors'] ?? [],
        ]);
        unset($_SESSION['teacher_message_old'], $_SESSION['teacher_message_success'], $_SESSION['teacher_message_errors']);
    }

