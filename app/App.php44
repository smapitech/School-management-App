    private function teacherTimetableFormOptions(int $teacherId): array
    {
        $assignedClasses = $this->repository->getTeacherAssignedClasses($teacherId);
        $assignedSubjects = $this->repository->getTeacherAssignedSubjects($teacherId);

        $classOptions = [];
        $sectionOptionsByClass = [];
        $subjectOptions = [];
        $subjectOptionsByClassSection = [];

        foreach ($assignedClasses as $class) {
            $classId = (int) ($class['class_id'] ?? 0);
            $className = trim((string) ($class['class_name'] ?? ''));
            if ($classId <= 0 || $className === '') {
                continue;
            }

            $classOptions[$classId] = [
                'class_id' => $classId,
                'class_name' => $className,
            ];

            $section = trim((string) ($class['section'] ?? ''));
            $sectionOptionsByClass[$classId][$section] = $section;
        }

        foreach ($assignedSubjects as $subject) {
            $classId = (int) ($subject['class_id'] ?? 0);
            $section = trim((string) ($subject['section'] ?? ''));
            $subjectId = (int) ($subject['subject_id'] ?? 0);

            if ($classId <= 0 || $subjectId <= 0) {
                continue;
            }

            $subjectOptions[$subjectId] = [
                'subject_id' => $subjectId,
                'subject_name' => $subject['subject_name'] ?? '',
                'subject_code' => $subject['subject_code'] ?? '',
                'subject_type' => $subject['subject_type'] ?? '',
            ];

            $subjectOptionsByClassSection[$classId . '|' . $section][$subjectId] = [
                'subject_id' => $subjectId,
                'subject_name' => $subject['subject_name'] ?? '',
                'subject_code' => $subject['subject_code'] ?? '',
                'subject_type' => $subject['subject_type'] ?? '',
            ];
        }

        return [
            'assignedClasses' => $assignedClasses,
            'classOptions' => array_values($classOptions),
            'subjectOptions' => array_values($subjectOptions),
            'sectionOptionsByClass' => array_map(static fn (array $sections): array => array_values($sections), $sectionOptionsByClass),
            'subjectOptionsByClassSection' => array_map(static fn (array $subjects): array => array_values($subjects), $subjectOptionsByClassSection),
        ];
    }

    private function academicYears(): array
    {
        $years = ['2025/2026'];

        for ($year = 2026; $year <= 2050; $year++) {
            $years[] = $year . '-' . ($year + 1);
        }

        return $years;
    }

