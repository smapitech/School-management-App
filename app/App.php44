        move_uploaded_file($_FILES['attachment']['tmp_name'], $uploadDir . '/' . $name);

        return [
            'attachment_path' => '/uploads/communication/' . $name,
            'attachment_name' => $_FILES['attachment']['name'],
        ];
    }

