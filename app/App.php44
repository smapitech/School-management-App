            'editGrade' => isset($_GET['edit_grade']) ? $this->repository->examGradeById((int) $_GET['edit_grade']) : null,
            'notice' => $notice,
        ]);
    }

    private function examMarks(): void
    {
        $this->requirePermission('exams', 'view');
        $user = Auth::user() ?? [];
        $filters = [
            'class_name' => trim($_GET['class_name'] ?? ''),
            'section' => trim($_GET['section'] ?? ''),
            'school_term' => trim($_GET['school_term'] ?? ''),
            'school_session' => trim($_GET['school_session'] ?? ''),
            'subject_id' => (int) ($_GET['subject_id'] ?? 0),
        ];
        $filtersComplete = $filters['class_name'] !== ''
            && $filters['section'] !== ''
            && $filters['school_term'] !== ''
            && $filters['school_session'] !== ''
            && (int) $filters['subject_id'] > 0;
        $notice = trim($_GET['notice'] ?? '');
        $setting = null;
        $students = [];
        $distributions = [];
        $marks = [];
        $comments = [];
        $subjects = [];

        try {
            $subjects = ($user['role'] ?? '') === 'teacher'
                ? $this->repository->subjectsForTeacher($user, $filters['class_name'], $filters['section'])
                : $this->repository->subjectsForClass();
        } catch (\Throwable $exception) {
            error_log('[Exam mark subject load failed] ' . $exception->getMessage());
            $subjects = [];
            if ($notice === '') {
                $notice = 'Unable to load subject options right now.';
            }
        }

        if ($filtersComplete) {
            try {
            $setting = $filtersComplete
                ? $this->repository->findOrCreateExamSetting([
                    'class_name' => $filters['class_name'],
                    'section' => $filters['section'],
                    'school_term' => $filters['school_term'],
                    'school_session' => $filters['school_session'],
                    'subject_id' => $filters['subject_id'],
                    'exam_name' => 'Term Examination',
                    'created_by' => (int) ($user['id'] ?? 0),
                ], $user)
                : null;
            } catch (\Throwable $exception) {
                error_log('[Exam mark setting load failed] ' . $exception->getMessage());
                $setting = null;
                if ($notice === '') {
                    $notice = 'Unable to load the selected exam record right now. Please reload the page and try again.';
                }
            }
        }

        if ($setting) {
            try {
                $students = $this->repository->examStudentsForUser($user, ['class_name' => $setting['class_name'], 'section' => $setting['section']]);
            } catch (\Throwable $exception) {
                error_log('[Exam mark student load failed] ' . $exception->getMessage());
                $students = [];
            }

            try {
                $distributions = $this->repository->markDistributions();
            } catch (\Throwable $exception) {
                error_log('[Exam mark distribution load failed] ' . $exception->getMessage());
                $distributions = [];
            }

            try {
                $marks = $this->repository->examMarks((int) $setting['id']);
            } catch (\Throwable $exception) {
                error_log('[Exam mark marks load failed] ' . $exception->getMessage());
                $marks = [];
            }

            try {
                $comments = $this->repository->examComments((int) $setting['id']);
            } catch (\Throwable $exception) {
                error_log('[Exam mark comment load failed] ' . $exception->getMessage());
                $comments = [];
            }
        }

        $this->render('exams/marks', [
            'title' => 'Exam Mark',
            'classOptions' => $this->examClassOptions($user),
            'sections' => $this->sections(),
            'schoolTerms' => $this->schoolTerms(),
            'schoolSessions' => $this->academicYears(),
            'subjects' => $subjects,
            'filters' => $filters,
            'filtersComplete' => $filtersComplete,
            'setting' => $setting,
            'students' => $students,
            'distributions' => $distributions,
            'marks' => $marks,
            'comments' => $comments,
            'editStudentId' => (int) ($_GET['edit_student'] ?? 0),
            'notice' => $notice,
            'isTeacher' => ($user['role'] ?? '') === 'teacher',
        ]);
    }

    private function examMarkView(): void
    {
        $this->requirePermission('exams', 'view');
        $user = Auth::user() ?? [];
        $settingId = (int) ($_GET['setting_id'] ?? 0);
        $studentId = (int) ($_GET['student_id'] ?? 0);
        $setting = $this->repository->examSettingById($settingId, $user);

        if (!$setting || $studentId <= 0) {
            $this->notFound();
            return;
        }

        $student = null;
        foreach ($this->repository->admittedStudents(['class_name' => $setting['class_name'], 'section' => $setting['section']]) as $row) {
            if ((int) $row['id'] === $studentId) {
                $student = $row;
                break;
            }
        }

        if (!$student) {
            $this->notFound();
            return;
        }

        $this->render('exams/mark_view', [
            'title' => 'Exam Mark View',
            'setting' => $setting,
            'student' => $student,
            'distributions' => $this->repository->markDistributions(),
            'marks' => $this->repository->examMarksForStudent($settingId, $studentId),
        ]);
    }

