    }

    private function saveTeacherTimetable(): void
    {
        $this->requireLogin();
        $this->verifyCsrfOrForbidden();
        $user = Auth::user() ?? [];
        $timetableId = (int) ($_POST['id'] ?? 0);

        if ($timetableId > 0) {
            if (!Auth::can('classes', 'edit_own_timetable', $user)) {
                $this->forbidden();
                return;
            }
        } elseif (!Auth::can('classes', 'create_timetable', $user)) {
            $this->forbidden();
            return;
        }

        $teacherId = $this->repository->getCurrentTeacherIdFromUser((int) ($user['id'] ?? 0));
        if ($teacherId <= 0) {
            $_SESSION['teacher_timetable_errors'] = [$this->teacherWorkspaceWarningMessage()];
            $this->redirect($timetableId > 0
                ? '/teacher/classes/timetable/edit?id=' . $timetableId
                : '/teacher/classes/timetable/create');
            return;
        }

        $payload = [
            'class_id' => (int) ($_POST['class_id'] ?? 0),
            'section' => trim($_POST['section'] ?? ''),
            'subject_id' => (int) ($_POST['subject_id'] ?? 0),
            'day_of_week' => trim($_POST['day_of_week'] ?? ''),
            'start_time' => trim($_POST['start_time'] ?? ''),
            'end_time' => trim($_POST['end_time'] ?? ''),
            'room' => trim($_POST['room'] ?? ''),
            'note' => trim($_POST['note'] ?? ''),
            'created_by' => (int) ($user['id'] ?? 0),
        ];

        try {
            if ($timetableId > 0) {
                $this->repository->updateTeacherTimetable($teacherId, $timetableId, $payload);
                $_SESSION['teacher_timetable_success'] = 'Timetable updated successfully.';
            } else {
                $this->repository->createTeacherTimetable($teacherId, $payload);
                $_SESSION['teacher_timetable_success'] = 'Timetable created successfully.';
            }
            unset($_SESSION['teacher_timetable_old'], $_SESSION['teacher_timetable_errors']);
            $this->redirect('/teacher/classes/timetable');
        } catch (\Throwable $exception) {
            $_SESSION['teacher_timetable_old'] = ['id' => $timetableId] + $payload;
            $_SESSION['teacher_timetable_errors'] = [($exception instanceof \InvalidArgumentException || $exception instanceof \RuntimeException)
                ? $exception->getMessage()
                : 'Unable to save the timetable right now.'];
            $this->redirect($timetableId > 0
                ? '/teacher/classes/timetable/edit?id=' . $timetableId
                : '/teacher/classes/timetable/create');
        }
    }

    private function deleteTeacherTimetable(): void
    {
        $this->requirePermission('classes', 'delete_own_timetable');
        $this->verifyCsrfOrForbidden();
        $user = Auth::user() ?? [];
        $teacherId = $this->repository->getCurrentTeacherIdFromUser((int) ($user['id'] ?? 0));
        $timetableId = (int) ($_POST['id'] ?? 0);

        if ($teacherId <= 0 || $timetableId <= 0) {
            $_SESSION['teacher_timetable_errors'] = [$this->teacherWorkspaceWarningMessage()];
            $this->redirect('/teacher/classes/timetable');
            return;
        }

        try {
            $this->repository->deleteTeacherTimetable($teacherId, $timetableId);
            $_SESSION['teacher_timetable_success'] = 'Timetable deleted successfully.';
        } catch (\Throwable $exception) {
            $_SESSION['teacher_timetable_errors'] = [($exception instanceof \RuntimeException)
                ? $exception->getMessage()
                : 'Unable to delete the timetable right now.'];
        }

        $this->redirect('/teacher/classes/timetable');
    }

    private function saveTeacherAttendance(): void
    {
        $this->requirePermission('attendance', 'mark_assigned_students');
        $this->verifyCsrfOrForbidden();
        $user = Auth::user() ?? [];
        $teacherId = $this->repository->getCurrentTeacherIdFromUser((int) ($user['id'] ?? 0));
        $classId = (int) ($_POST['class_id'] ?? 0);
        $date = trim($_POST['attendance_date'] ?? date('Y-m-d'));
        $rows = (array) ($_POST['attendance'] ?? []);

        if ($teacherId <= 0) {
            $_SESSION['teacher_attendance_errors'] = [$this->teacherWorkspaceWarningMessage()];
            $this->redirect('/teacher/attendance');
            return;
        }

        try {
            $studentMap = [];
            foreach ($this->repository->getStudentsForTeacherAttendance($teacherId, $classId) as $student) {
                $studentMap[(int) $student['id']] = $student;
            }

            $this->repository->saveTeacherStudentAttendance($teacherId, $classId, $date, $rows);

            foreach ($rows as $studentId => $row) {
                $studentId = (int) $studentId;
                $status = trim((string) ($row['status'] ?? 'Present'));
                if (!in_array($status, ['Absent', 'Late'], true) || !isset($studentMap[$studentId])) {
                    continue;
                }

                $this->notifyAttendanceParentForStudent(
                    $studentMap[$studentId],
                    $status,
                    $date,
                    trim((string) ($row['remark'] ?? '')),
                    (int) ($user['id'] ?? 0)
                );
            }

            $_SESSION['teacher_attendance_success'] = 'Attendance saved successfully.';
            unset($_SESSION['teacher_attendance_old_rows'], $_SESSION['teacher_attendance_errors']);
        } catch (\Throwable $exception) {
            $_SESSION['teacher_attendance_old_rows'] = $rows;
            $_SESSION['teacher_attendance_errors'] = [($exception instanceof \InvalidArgumentException || $exception instanceof \RuntimeException)
                ? $exception->getMessage()
                : 'Unable to save attendance right now.'];
        }

        $this->redirect('/teacher/attendance?class_id=' . urlencode((string) $classId) . '&attendance_date=' . urlencode($date));
    }

    private function saveStudentAttendance(): void
    {
        $this->requirePermission('attendance', 'edit');
        $user = Auth::user() ?? [];
        $className = trim($_POST['class_name'] ?? '');
        $section = trim($_POST['section'] ?? '');
        $date = trim($_POST['attendance_date'] ?? date('Y-m-d'));

        if (!$this->canUseExamClass($user, $className, $section)) {
            $this->forbidden();
            return;
        }

        $this->repository->saveStudentAttendance([
            'class_name' => $className,
            'section' => $section,
            'attendance_date' => $date,
            'rows' => $_POST['attendance'] ?? [],
        ]);
        foreach ((array) ($_POST['attendance'] ?? []) as $row) {
            $status = $row['status'] ?? 'Present';
            if (in_array($status, ['Absent', 'Late'], true)) {
                $this->repository->createNotificationForRole('parent', 'Attendance notice', 'A student in ' . $className . ' ' . $section . ' was marked ' . $status . ' on ' . $date . '.', 'attendance', '/parent_portal', $status === 'Absent' ? 'high' : 'normal', (int) ($user['id'] ?? 0));
                break;
            }
        }
        $this->redirect('/attendance/students?class_name=' . urlencode($className) . '&section=' . urlencode($section) . '&attendance_date=' . urlencode($date));
    }

