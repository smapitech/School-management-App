    private function examClassOptions(array $user): array
    {
        if (($user['role'] ?? '') !== 'teacher') {
            return $this->classOptions();
        }

        $classes = [];
        foreach ($this->repository->teacherAssignmentsForUser($user) as $assignment) {
            $classes[] = $assignment['class_name'];
        }

        return array_values(array_unique($classes));
    }

    private function canUseExamClass(array $user, string $className, string $section): bool
    {
        if (($user['role'] ?? '') !== 'teacher') {
            return true;
        }

        foreach ($this->repository->teacherAssignmentsForUser($user) as $assignment) {
            if ($assignment['class_name'] === $className && $assignment['section'] === $section) {
                return true;
            }
        }

        return false;
    }

