    private function storeHomeworkUpload(string $field, string $prefix): array
    {
        $empty = str_contains($field, 'correction')
            ? ['correction_file_path' => '', 'correction_file_name' => '']
            : ['attachment_path' => '', 'attachment_name' => ''];

        if (!isset($_FILES[$field]) || ($_FILES[$field]['error'] ?? UPLOAD_ERR_NO_FILE) !== UPLOAD_ERR_OK) {
            return $empty;
        }

        $extension = strtolower(pathinfo($_FILES[$field]['name'], PATHINFO_EXTENSION));
        $allowed = ['pdf', 'doc', 'docx', 'jpg', 'jpeg', 'png'];
        $maxBytes = (int) (($this->repository->settings()['homework_upload_max_mb'] ?? 10) * 1024 * 1024);

        if (!in_array($extension, $allowed, true) || (int) ($_FILES[$field]['size'] ?? 0) > $maxBytes) {
            return $empty;
        }

        $uploadDir = dirname(__DIR__) . '/public/uploads/homework';

        if (!is_dir($uploadDir)) {
            mkdir($uploadDir, 0775, true);
        }

        $name = $prefix . '-' . date('YmdHis') . '-' . bin2hex(random_bytes(3)) . '.' . $extension;
        move_uploaded_file($_FILES[$field]['tmp_name'], $uploadDir . '/' . $name);
        $path = '/uploads/homework/' . $name;

        if (str_contains($field, 'correction')) {
            return ['correction_file_path' => $path, 'correction_file_name' => $_FILES[$field]['name']];
        }

        return ['attachment_path' => $path, 'attachment_name' => $_FILES[$field]['name']];
    }

    private function storeWebsiteImage(string $field, string $folder, int $maxMb = 5): string
    {
        return $this->storeWebsiteImageFromUpload($_FILES[$field] ?? [], $field, $folder, $maxMb);
    }

    private function storeWebsiteImages(string $field, string $folder, int $maxMb = 5): array
    {
        if (!isset($_FILES[$field])) {
            return [];
        }

        $file = $_FILES[$field];
        if (!is_array($file['name'] ?? null)) {
            $image = $this->storeWebsiteImage($field, $folder, $maxMb);
            return $image !== '' ? [$image] : [];
        }

        $paths = [];
        $count = count($file['name']);
        for ($i = 0; $i < $count; $i++) {
            $upload = [
                'name' => $file['name'][$i] ?? '',
                'type' => $file['type'][$i] ?? '',
                'tmp_name' => $file['tmp_name'][$i] ?? '',
                'error' => $file['error'][$i] ?? UPLOAD_ERR_NO_FILE,
                'size' => $file['size'][$i] ?? 0,
            ];
            $image = $this->storeWebsiteImageFromUpload($upload, $field, $folder, $maxMb);
            if ($image !== '') {
                $paths[] = $image;
            }
        }

        return $paths;
    }

    private function storeWebsiteImageFromUpload(array $file, string $field, string $folder, int $maxMb = 5): string
    {
        if (($file['error'] ?? UPLOAD_ERR_NO_FILE) !== UPLOAD_ERR_OK) {
            return '';
        }
        if ((int) ($file['size'] ?? 0) > $maxMb * 1024 * 1024) {
            return '';
        }
        $extension = strtolower(pathinfo((string) ($file['name'] ?? ''), PATHINFO_EXTENSION));
        if (!in_array($extension, ['jpg', 'jpeg', 'png', 'webp'], true)) {
            return '';
        }
        $mime = mime_content_type((string) ($file['tmp_name'] ?? ''));
        if (!in_array($mime, ['image/jpeg', 'image/png', 'image/webp'], true)) {
            return '';
        }
        $safeFolder = preg_replace('/[^a-z0-9_-]/i', '', $folder) ?: 'general';
        $uploadDir = dirname(__DIR__) . '/public/uploads/website/' . $safeFolder;
        if (!is_dir($uploadDir)) {
            mkdir($uploadDir, 0775, true);
        }
        $name = $field . '-' . date('YmdHis') . '-' . bin2hex(random_bytes(5)) . '.' . $extension;
        move_uploaded_file((string) $file['tmp_name'], $uploadDir . '/' . $name);

        return '/uploads/website/' . $safeFolder . '/' . $name;
    }

    private function deleteWebsiteAsset(string $path): void
    {
        if ($path === '' || !str_starts_with(public_upload_url($path), '/uploads/website/')) {
            return;
        }
        $file = realpath(dirname(__DIR__) . '/public' . public_upload_url($path));
        $root = realpath(dirname(__DIR__) . '/public/uploads/website');
        if ($file && $root && str_starts_with($file, $root) && is_file($file)) {
            unlink($file);
        }
    }

    private function verifyCsrfOrForbidden(): void
    {
        if (!csrf_verify($_POST['_csrf_token'] ?? null)) {
            $this->forbidden();
            exit;
        }
    }

    private function websiteSectionKeys(): array
    {
        return [
            'hero_title' => 'Hero slide 1 title', 'hero_subtitle' => 'Hero slide 1 subtitle', 'hero_button_text' => 'Hero slide 1 button text',
            'hero_button_link' => 'Hero slide 1 button link', 'hero_image' => 'Hero slide 1 image',
