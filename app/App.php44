    private function studentPortalPage(string $page): void
    {
        $this->requirePermission('student_portal', 'view');
        $user = Auth::user() ?? [];
        $student = $this->repository->studentForPortal($user, (int) ($_GET['student_id'] ?? 0));
        $templates = [
            'profile' => 'student_portal/profile',
            'teachers' => 'student_portal/teachers',
            'classes' => 'student_portal/classes',
            'homework' => 'student_portal/homework',
            'report' => 'student_portal/report',
            'attendance' => 'student_portal/attendance',
            'messages' => 'student_portal/messages',
            'accounting' => 'student_portal/accounting',
        ];

        $this->render($templates[$page], $this->studentPortalPayload($student, 'Student ' . ucfirst($page), $page));
    }

    private function studentPortalPayload(?array $student, string $title, string $activePortal = 'dashboard'): array
    {
        if (!$student) {
            return [
                'title' => $title,
                'student' => null,
                'activePortal' => $activePortal,
            ];
        }

        $filters = [
            'class_name' => $student['class_name'],
            'section' => $student['section'],
            'student_id' => (int) $student['id'],
        ];
        $attendanceMonth = trim($_GET['month'] ?? date('Y-m'));

        return [
            'title' => $title,
            'activePortal' => $activePortal,
            'student' => $student,
            'attendance' => $this->repository->studentPortalAttendance((int) $student['id']),
            'attendanceMonth' => $attendanceMonth,
            'monthlyAttendance' => $this->repository->studentPortalAttendanceByMonth((int) $student['id'], $attendanceMonth),
            'fees' => $this->repository->studentPortalFees($student),
            'feeSummary' => $this->repository->studentPortalFeeSummary($student),
            'results' => $this->repository->studentExamResults((int) $student['id'], $filters, ['role' => 'student']),
            'timetables' => $this->repository->timetables(['class_name' => $student['class_name'], 'section' => $student['section']]),
            'examSchedules' => $this->repository->examSchedules(['role' => 'student'], ['student_id' => (int) $student['id']]),
            'messages' => $this->repository->studentPortalMessages($student),
            'assignments' => $this->repository->studentPortalAssignments($student),
            'teachers' => $this->repository->staffPublicList(),
            'certificates' => $this->repository->studentCertificates($student),
        ];
    }

    private function parentPortal(): void
    {
        $this->requirePermission('parent_portal', 'view');
        $user = Auth::user() ?? [];
        $this->render('parent_portal/index', $this->parentPortalPayload($user, (int) ($_GET['student_id'] ?? 0), 'Parent Portal'));
    }

    private function parentPortalPayload(array $user, int $previewStudentId, string $title): array
    {
        $previewStudent = $previewStudentId > 0 ? $this->repository->parentPortalChildById($user, $previewStudentId) : null;
        $children = $previewStudent ? [$previewStudent] : $this->repository->parentPortalChildren($user);

        $childData = [];
        foreach ($children as $child) {
            $filters = [
                'class_name' => $child['class_name'],
                'section' => $child['section'],
                'student_id' => (int) $child['id'],
            ];
            $childData[] = [
                'student' => $child,
                'attendance' => $this->repository->studentPortalAttendance((int) $child['id']),
                'fees' => $this->repository->studentPortalFees($child),
                'results' => $this->repository->studentExamResults((int) $child['id'], $filters, ['role' => 'parent']),
                'assignments' => $this->repository->studentPortalAssignments($child),
            ];
        }

        return [
            'title' => $title,
            'children' => $childData,
            'messages' => $this->repository->parentPortalMessages($user),
        ];
    }

