            'end_time' => '',
            'room' => '',
            'note' => '',
        ];
        if ($defaults['class_id'] > 0 && !$this->repository->teacherCanAccessClass($teacherId, $defaults['class_id'])) {
            $defaults['class_id'] = 0;
            $defaults['section'] = '';
