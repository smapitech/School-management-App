    private function createStudent(): void
    {
        $this->requirePermission('students', 'create');

        $this->repository->createStudent([
            'name' => trim($_POST['name'] ?? ''),
            'student_no' => trim($_POST['student_no'] ?? ''),
            'class_name' => trim($_POST['class_name'] ?? ''),
            'guardian' => trim($_POST['guardian'] ?? ''),
            'status' => trim($_POST['status'] ?? 'Active'),
        ]);

        $this->redirect('/students');
    }

    private function updateStudentPortalAccount(): void
    {
        $this->requirePermission('students', 'edit');
        $password = (string) ($_POST['password'] ?? '');

        if ($password !== (string) ($_POST['password_confirmation'] ?? '')) {
            $this->redirect('/students/accounts');
        }

        $this->repository->updateStudentPortalAccount(
            (int) ($_POST['id'] ?? 0),
            trim($_POST['username'] ?? ''),
            $password
        );

        $this->redirect('/students/accounts');
    }

    private function deleteStudentPortalAccount(): void
    {
        $this->requirePermission('students', 'edit');
        $this->repository->deleteStudentPortalAccount((int) ($_POST['id'] ?? 0));
        $this->redirect('/students/accounts');
    }

    private function updateParentPortalAccount(): void
    {
        $this->requirePermission('students', 'edit');
        $password = (string) ($_POST['password'] ?? '');

        if ($password !== (string) ($_POST['password_confirmation'] ?? '')) {
            $this->redirect('/students/accounts');
        }

        $this->repository->updateParentPortalAccount(
            (int) ($_POST['id'] ?? 0),
            trim($_POST['username'] ?? ''),
            $password
        );

        $this->redirect('/students/accounts');
    }

    private function deleteParentPortalAccount(): void
    {
        $this->requirePermission('students', 'edit');
        $this->repository->deleteParentPortalAccount((int) ($_POST['id'] ?? 0));
        $this->redirect('/students/accounts');
    }

    private function staff(): void
    {
        $this->requirePermission('staff', 'view');
        $user = Auth::user() ?? [];

        if (($user['role'] ?? '') === 'teacher') {
            $this->render('staff/index', [
                'title' => 'Teachers',
                'roles' => ['All Staff'],
                'selectedRole' => 'All Staff',
                'rows' => $this->repository->staff(),
                'isTeacherDirectory' => true,
            ]);
            return;
        }

        $role = trim($_GET['role'] ?? 'Admin');
        $this->render('staff/index', [
            'title' => 'Staff',
            'roles' => $this->repository->staffRoles(),
            'selectedRole' => $role,
            'rows' => $this->repository->staff(['role' => $role]),
        ]);
    }

