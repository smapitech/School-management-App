    private function loginForm(?string $error = null): void
    {
        if (Auth::check()) {
            $this->redirect('/dashboard');
        }

        $loginIdentifier = (string) ($_SESSION['login_old'] ?? '');
        $loginError = $error ?? ($_SESSION['login_error'] ?? null);
        unset($_SESSION['login_old'], $_SESSION['login_error']);

        $this->renderPublic('login', [
            'title' => 'Login',
            'error' => $loginError,
            'loginIdentifier' => $loginIdentifier,
            'settings' => $this->repository->settings(),
        ]);
    }

    private function attemptLogin(): void
    {
        $email = trim($_POST['email'] ?? '');
        $password = (string) ($_POST['password'] ?? '');
        $user = $this->repository->findUserByEmail($email);

        if (!$user || !password_verify($password, $user['password'])) {
            $_SESSION['login_old'] = $email;
            $_SESSION['login_error'] = 'Invalid email or password.';
            $this->loginForm();
            return;
        }

        unset($_SESSION['login_old'], $_SESSION['login_error']);
        Auth::login($user);
        $this->redirect('/dashboard');
    }

    private function home(): void
    {
        if (Auth::check()) {
            $this->redirect('/dashboard');
        }

        $this->redirect('/website');
    }

    private function logout(): void
    {
        Auth::logout();
        $this->redirect('/login');
    }

    private function websiteContactSubmit(): void
    {
        if (!csrf_verify($_POST['_csrf_token'] ?? null)) {
            $_SESSION['website_contact_error'] = 'Security token expired. Please try again.';
            $this->redirect('/website/contact');
        }
        $data = [
            'full_name' => trim($_POST['full_name'] ?? ''),
            'email' => trim($_POST['email'] ?? ''),
            'phone' => trim($_POST['phone'] ?? ''),
            'subject' => trim($_POST['subject'] ?? ''),
            'message' => trim($_POST['message'] ?? ''),
        ];
        if ($data['full_name'] === '' || !filter_var($data['email'], FILTER_VALIDATE_EMAIL) || $data['message'] === '') {
            $_SESSION['website_contact_error'] = 'Please enter your name, valid email, and message.';
            $this->redirect('/website/contact');
        }
        $this->repository->saveContactMessage($data);
        $this->repository->createNotificationForRole('admin', 'New website contact message', $data['full_name'] . ' sent a message from the public website.', 'website', '/website-manager/contact-messages', 'normal');
        $this->repository->createNotificationForRole('superadmin', 'New website contact message', $data['full_name'] . ' sent a message from the public website.', 'website', '/website-manager/contact-messages', 'normal');
        $_SESSION['website_contact_success'] = 'Your message has been sent successfully.';
        $this->redirect('/website/contact');
    }

    private function notificationRead(): void
    {
        $this->requirePermission('notifications', 'view');
        $this->verifyCsrfOrForbidden();
        $user = Auth::user() ?? [];
        $id = (int) ($_POST['id'] ?? 0);
        $this->repository->markNotificationAsRead($id, (int) ($user['id'] ?? 0), $user['role'] ?? '');
        $return = trim($_POST['return_to'] ?? '/notifications');
        $this->redirect(str_starts_with($return, '/') ? $return : '/notifications');
    }

    private function notificationReadAll(): void
    {
        $this->requirePermission('notifications', 'view');
        $this->verifyCsrfOrForbidden();
        $user = Auth::user() ?? [];
        $this->repository->markAllNotificationsAsRead((int) ($user['id'] ?? 0), $user['role'] ?? '');
        $this->redirect('/notifications');
    }

    private function notificationDelete(): void
    {
        $this->requirePermission('notifications', 'view');
        $this->verifyCsrfOrForbidden();
        $user = Auth::user() ?? [];
        $this->repository->deleteNotification((int) ($_POST['id'] ?? 0), (int) ($user['id'] ?? 0), $user['role'] ?? '');
        $this->redirect('/notifications');
    }

    private function notificationManagerSend(): void
    {
        $this->requirePermission('notification_manager', 'send');
        $this->verifyCsrfOrForbidden();
        $targetType = trim($_POST['target_type'] ?? 'role');
        $role = $targetType === 'role' ? trim($_POST['role'] ?? '') : '';
        $userId = $targetType === 'user' ? (int) ($_POST['user_id'] ?? 0) : 0;
        if ($targetType === 'global') {
            $role = '';
            $userId = 0;
        }
        if ($targetType === 'role' && !array_key_exists($role, Auth::ROLES)) {
            $this->redirect('/notification-manager');
        }

        $this->repository->createNotification([
            'user_id' => $userId,
            'role' => $role,
            'title' => trim($_POST['title'] ?? ''),
            'message' => trim($_POST['message'] ?? ''),
            'type' => trim($_POST['type'] ?? 'general'),
            'priority' => trim($_POST['priority'] ?? 'normal'),
            'link' => trim($_POST['link'] ?? ''),
            'expires_at' => trim($_POST['expires_at'] ?? ''),
            'created_by' => (int) ((Auth::user() ?? [])['id'] ?? 0),
        ]);
        $this->redirect('/notification-manager');
    }

    private function notificationManagerDelete(): void
    {
        $this->requirePermission('notification_manager', 'delete');
        $this->verifyCsrfOrForbidden();
        $this->repository->deleteNotificationAsAdmin((int) ($_POST['id'] ?? 0));
        $this->redirect('/notification-manager');
    }

    private function notificationManagerCleanup(): void
    {
        $this->requirePermission('notification_manager', 'manage');
        $this->verifyCsrfOrForbidden();
        $this->repository->cleanupExpiredNotifications();
        $this->redirect('/notification-manager');
    }

    private function websiteManagerTemplate(): void
    {
        $this->requirePermission('website', 'edit');
        $this->verifyCsrfOrForbidden();
        $template = trim($_POST['active_template'] ?? 'classic');
        if (!array_key_exists($template, getAvailableWebsiteTemplates())) {
            $this->forbidden();
            return;
        }
        $this->repository->updateActiveWebsiteTemplate($template);
        $_SESSION['website_manager_success'] = 'Website template updated.';
        $this->redirect('/website-manager');
    }

    private function websiteManagerSave(): void
    {
        $this->requirePermission('website', 'edit');
        $this->verifyCsrfOrForbidden();
        $current = $this->repository->getWebsiteSettings();
        $settings = [
            'active_template' => $current['active_template'],
            'site_title' => trim($_POST['site_title'] ?? ''),
            'meta_description' => trim($_POST['meta_description'] ?? ''),
            'meta_keywords' => trim($_POST['meta_keywords'] ?? ''),
            'og_title' => trim($_POST['og_title'] ?? ''),
            'og_description' => trim($_POST['og_description'] ?? ''),
            'footer_text' => trim($_POST['footer_text'] ?? ''),
            'show_teacher_phone' => isset($_POST['show_teacher_phone']) ? 1 : 0,
            'show_teacher_email' => isset($_POST['show_teacher_email']) ? 1 : 0,
            'school_logo' => $this->storeWebsiteImage('school_logo', 'logo') ?: ($current['school_logo'] ?? ''),
            'favicon' => $this->storeWebsiteImage('favicon', 'logo') ?: ($current['favicon'] ?? ''),
            'og_image' => $this->storeWebsiteImage('og_image', 'seo') ?: ($current['og_image'] ?? ''),
        ];
        $this->repository->updateWebsiteSettings($settings);

        $sections = [];
        foreach ($this->websiteSectionKeys() as $key => $label) {
            $sections[$key] = trim($_POST[$key] ?? '');
        }
        foreach (['hero_image' => 'hero', 'hero_slide_2_image' => 'hero', 'hero_slide_3_image' => 'hero', 'about_image' => 'about'] as $key => $folder) {
            $upload = $this->storeWebsiteImage($key, $folder);
            if ($upload !== '') {
                $sections[$key] = $upload;
            } elseif (($sections[$key] ?? '') === '') {
                $sections[$key] = $this->repository->websiteContent()[$key] ?? '';
            }
        }
        $this->repository->saveWebsiteSections($sections);
        $_SESSION['website_manager_success'] = 'Website content saved.';
        $this->redirect('/website-manager/edit');
    }

    private function websiteManagerGallerySave(): void
    {
        $this->requirePermission('website', 'upload');
        $this->verifyCsrfOrForbidden();
        $user = Auth::user() ?? [];
        $category = trim($_POST['category'] ?? '') ?: 'General';
        $title = trim($_POST['title'] ?? '');
        $description = trim($_POST['description'] ?? '');
        $isFeatured = isset($_POST['is_featured']) ? 1 : 0;
        $isPublished = isset($_POST['is_published']) ? 1 : 0;
        $baseSortOrder = (int) ($_POST['sort_order'] ?? 0);

        $imagePaths = $this->storeWebsiteImages('images', 'gallery');
        if ($imagePaths === []) {
            $singleImage = $this->storeWebsiteImage('image', 'gallery');
            if ($singleImage !== '') {
                $imagePaths = [$singleImage];
            }
        }

        if ($imagePaths === []) {
            $_SESSION['website_manager_error'] = 'Please choose one or more gallery images to upload.';
            $this->redirect('/website-manager/gallery');
            return;
        }

        $items = [];
        foreach ($imagePaths as $index => $imagePath) {
            $items[] = [
                'image_path' => $imagePath,
                'title' => $title,
                'description' => $description,
                'category' => $category,
                'is_featured' => $isFeatured,
                'is_published' => $isPublished,
                'sort_order' => $baseSortOrder + $index,
                'created_by' => (int) ($user['id'] ?? 0),
            ];
        }

        try {
            $this->repository->saveGalleryItems($items);
        } catch (\Throwable $e) {
            $_SESSION['website_manager_error'] = 'We could not save the gallery batch right now. Please try again.';
            $this->redirect('/website-manager/gallery');
            return;
        }
        $_SESSION['website_manager_success'] = count($items) === 1 ? 'Gallery image uploaded.' : count($items) . ' gallery images uploaded.';
        $this->redirect('/website-manager/gallery');
    }

