<?php

declare(strict_types=1);

namespace App;

final class App
{
    private Database $database;
    private Repository $repository;
    private View $view;

    public function __construct()
    {
        $this->database = new Database(require dirname(__DIR__) . '/config/database.php');
        $this->database->migrate();
        $this->repository = new Repository($this->database->pdo());
        $this->view = new View(dirname(__DIR__) . '/resources/views');
    }

    public function run(): void
    {
        $path = parse_url($_SERVER['REQUEST_URI'] ?? '/', PHP_URL_PATH) ?: '/';
        $method = $_SERVER['REQUEST_METHOD'] ?? 'GET';

        if (str_starts_with($path, '/api')) {
            (new Api($this->repository))->handle($method, $path);
            return;
        }

        if ($method === 'POST') {
            $this->handlePost($path);
            return;
        }

        match ($path) {
            '/website' => $this->website('home'),
            '/website/preview' => $this->websitePreview(),
            '/website/about' => $this->website('about'),
            '/website/gallery' => $this->website('gallery'),
            '/website/teachers' => $this->website('teachers'),
            '/website/contact' => $this->website('contact'),
            '/login' => $this->loginForm(),
            '/logout' => $this->logout(),
            '/' => $this->home(),
            '/dashboard' => $this->dashboard(),
            '/profile' => $this->profile(),
            '/profile/password' => $this->passwordProfile(),
            '/students' => $this->students(),
            '/students/accounts' => $this->studentPortalAccounts(),
            '/admissions' => $this->admissions(),
            '/admissions/create' => $this->admissionCreateForm(),
            '/admissions/admitted' => $this->admittedStudents(),
            '/staff' => $this->staff(),
            '/staff/add' => $this->staffForm(),
            '/staff/edit' => $this->staffForm(),
            '/staff/designations' => $this->staffDesignations(),
            '/staff/accounts' => $this->staffAccounts(),
            '/human_resource' => $this->humanResource(),
            '/human-resource' => $this->humanResource(),
            '/human-resource/payroll' => $this->payroll(),
            '/human-resource/salary-assign' => $this->salaryAssign(),
            '/human-resource/salary-payment' => $this->salaryPayment(),
            '/human-resource/payslip' => $this->payslip(),
            '/teacher/payroll' => $this->teacherPayroll(),
            '/teacher/payslips' => $this->teacherPayslips(),
            '/teacher/payslips/view' => $this->teacherPayslipView(),
            '/teacher/allowances' => $this->teacherAllowances(),
            '/teacher/deductions' => $this->teacherDeductions(),
            '/teacher/increments' => $this->teacherIncrements(),
            '/classes' => $this->classes(),
            '/teacher/classes' => $this->teacherClasses(),
            '/teacher/classes/students' => $this->teacherStudents(),
            '/teacher/classes/subjects' => $this->teacherSubjects(),
            '/teacher/classes/timetable' => $this->teacherTimetable(),
            '/teacher/classes/timetable/create' => $this->teacherTimetableCreateForm(),
            '/teacher/classes/timetable/edit' => $this->teacherTimetableEditForm(),
            '/teacher/attendance' => $this->teacherAttendance(),
            '/teacher/attendance/history' => $this->teacherAttendanceHistory(),
            '/teacher/my-attendance' => $this->teacherMyAttendance(),
            '/teacher/messages' => $this->teacherMessages(),
            '/teacher/messages/parents' => $this->teacherParentMessages(),
            '/teacher/messages/teachers' => $this->teacherTeacherMessages(),
            '/teacher/messages/view' => $this->teacherMessageView(),
            '/classes/assign' => $this->classAssign(),
            '/classes/subjects' => $this->subjects(),
            '/classes/subject-assign' => $this->subjectAssign(),
            '/classes/timetable' => $this->timetable(),
            '/attendance' => $this->attendance(),
            '/attendance/students' => $this->studentAttendance(),
            '/attendance/staff' => $this->staffAttendance(),
            '/fees' => $this->studentAccounting(),
            '/exams' => $this->exams(),
            '/exams/settings' => $this->examSettings(),
            '/exams/distribution' => $this->examDistribution(),
            '/exams/marks' => $this->examMarks(),
            '/exams/marks/view' => $this->examMarkView(),
            '/exams/schedule' => $this->examSchedule(),
            '/exams/schedule/print' => $this->examSchedulePrint(),
            '/exams/marksheet-templates' => $this->marksheetTemplates(),
            '/exams/marksheet-templates/preview' => $this->marksheetTemplatePreview(),
            '/homework' => $this->homework(),
            '/homework/create' => $this->homeworkForm(),
            '/homework/edit' => $this->homeworkForm(),
            '/homework/submissions' => $this->homeworkSubmissions(),
            '/homework/reports' => $this->homeworkReports(),
            '/homework/download' => $this->homeworkDownload(),
            '/notifications' => $this->notifications(),
            '/notifications/count' => $this->notificationCount(),
            '/notifications/recent' => $this->notificationRecent(),
            '/notification-manager' => $this->notificationManager(),
            '/library' => $this->module('library'),
            '/transport' => $this->module('transport'),
            '/hostel' => $this->module('hostel'),
            '/communication' => $this->communication(),
            '/communication/internal' => $this->communicationInternal(),
            '/communication/invoices' => $this->communicationInvoices(),
            '/communication/reminders' => $this->communicationReminders(),
            '/communication/setup' => $this->communicationSetup(),
            '/reception' => $this->module('reception'),
            '/accounting' => $this->accounting(),
            '/accounting/student' => $this->studentAccounting(),
            '/accounting/student/print' => $this->studentAccountingPrint(),
            '/accounting/office' => $this->officeAccounting(),
            '/accounting/office/print' => $this->officeAccountingPrint(),
            '/parent_portal' => $this->parentPortal(),
            '/parent_portal/report-card' => $this->parentReportCard(),
            '/student_portal' => $this->studentPortal(),
            '/student_portal/profile' => $this->studentPortalPage('profile'),
            '/student_portal/teachers' => $this->studentPortalPage('teachers'),
            '/student_portal/classes' => $this->studentPortalPage('classes'),
            '/student_portal/homework' => $this->studentPortalPage('homework'),
            '/student_portal/report' => $this->studentPortalPage('report'),
            '/student_portal/attendance' => $this->studentPortalPage('attendance'),
            '/student_portal/messages' => $this->studentPortalPage('messages'),
            '/student_portal/accounting' => $this->studentPortalPage('accounting'),
            '/student_portal/report-card' => $this->studentReportCard(),
            '/reports' => $this->module('reports'),
            '/settings' => $this->settings(),
            '/website-manager' => $this->websiteManager(),
            '/website-manager/edit' => $this->websiteManagerEdit(),
            '/website-manager/gallery' => $this->websiteManagerGallery(),
            '/website-manager/teachers' => $this->websiteManagerTeachers(),
            '/website-manager/reviews' => $this->websiteManagerReviews(),
            '/website-manager/contact-messages' => $this->websiteManagerMessages(),
            '/website-manager/contact-messages/view' => $this->websiteManagerMessageView(),
            default => $this->notFound(),
        };
    }

    private function dashboard(): void
    {
        $this->requireLogin();
        $user = Auth::user() ?? [];

        if (($user['role'] ?? '') === 'student') {
            $student = $this->repository->studentForPortal($user);
            $this->render('student_portal/dashboard', $this->studentPortalPayload($student, 'Dashboard'));
            return;
        }

        if (($user['role'] ?? '') === 'parent') {
            $this->render('parent_portal/index', $this->parentPortalPayload($user, 0, 'Dashboard'));
            return;
        }

        if (!in_array($user['role'] ?? '', ['superadmin', 'admin'], true)) {
            $this->staffDashboard($user);
            return;
        }

        $this->render('dashboard', [
            'title' => 'Dashboard',
            'stats' => $this->repository->stats(),
            'recentStudents' => $this->repository->students(5),
            'feeSummary' => $this->repository->feeSummary(),
            'attendanceSummary' => $this->repository->attendanceSummary(),
            'announcements' => $this->repository->announcements(),
        ]);
    }

    private function staffDashboard(array $user): void
    {
        $staff = $this->repository->staffByEmail($user['email'] ?? '');
        $teacherId = ($user['role'] ?? '') === 'teacher' ? $this->repository->getCurrentTeacherIdFromUser((int) ($user['id'] ?? 0)) : 0;
        $dashboard = ($user['role'] ?? '') === 'teacher' && $teacherId > 0 ? $this->repository->getTeacherDashboardSummary($teacherId) : [];
        $assignments = ($user['role'] ?? '') === 'teacher' ? ($dashboard['classes'] ?? []) : [];
        $students = ($user['role'] ?? '') === 'teacher' ? ($dashboard['students'] ?? []) : [];
        $messages = ($user['role'] ?? '') === 'teacher'
            ? array_merge($dashboard['recent_parent_messages'] ?? [], $dashboard['recent_teacher_messages'] ?? [])
            : $this->repository->communicationMessages(8);

        $this->render('dashboards/staff', [
            'title' => 'Dashboard',
            'staff' => $staff,
            'dashboard' => $dashboard,
            'assignments' => $assignments,
            'students' => $students,
            'messages' => $messages,
        ]);
    }

    private function module(string $key): void
    {
        $this->requireLogin();

        if (!Auth::can($key, 'view')) {
            $this->forbidden();
            return;
        }

        $modules = Modules::all();

        if (!isset($modules[$key])) {
            $this->notFound();
            return;
        }

        $this->render('module', [
            'title' => $modules[$key]['title'],
            'moduleKey' => $key,
            'module' => $modules[$key],
            'rows' => $this->repository->moduleRows($key),
            'stats' => $this->repository->moduleStats($key),
        ]);
    }

    private function website(string $page): void
    {
        $settings = $this->repository->getWebsiteSettings();
        $templates = getAvailableWebsiteTemplates();
        $template = array_key_exists($settings['active_template'] ?? '', $templates) ? $settings['active_template'] : 'classic';
        $folder = $templates[$template]['view_folder'];
        $allowedPages = ['home', 'about', 'gallery', 'teachers', 'contact'];
        if (!in_array($page, $allowedPages, true)) {
            $this->notFound();
            return;
        }

        $this->renderWebsite("website/{$folder}/{$page}", [
            'title' => $settings['site_title'] ?: 'Smapis School Portal',
            'websiteSettings' => $settings,
            'sections' => $this->repository->websiteContent(),
            'gallery' => $this->repository->getPublishedGallery($page === 'home'),
            'galleryGroups' => $this->repository->getPublishedGalleryGrouped($page === 'home'),
            'teachers' => $this->repository->getPublishedTeachers($page === 'home'),
            'reviews' => $this->repository->getWebsiteReviews(true, $page === 'home'),
            'success' => $_SESSION['website_contact_success'] ?? '',
            'error' => $_SESSION['website_contact_error'] ?? '',
        ]);
        unset($_SESSION['website_contact_success'], $_SESSION['website_contact_error']);
    }

    private function websitePreview(): void
    {
        $templates = getAvailableWebsiteTemplates();
        $template = trim($_GET['template'] ?? 'classic');
        if (!array_key_exists($template, $templates)) {
            $template = 'classic';
        }
        $settings = $this->repository->getWebsiteSettings();
        $settings['active_template'] = $template;
        $this->renderWebsite('website/' . $templates[$template]['view_folder'] . '/home', [
            'title' => $settings['site_title'] ?: 'Smapis School Portal',
            'websiteSettings' => $settings,
            'sections' => $this->repository->websiteContent(),
            'gallery' => $this->repository->getPublishedGallery(true),
            'galleryGroups' => $this->repository->getPublishedGalleryGrouped(true),
            'teachers' => $this->repository->getPublishedTeachers(true),
            'reviews' => $this->repository->getWebsiteReviews(true, true),
            'success' => '',
            'error' => '',
        ]);
    }

    private function websiteManager(): void
    {
        $this->requirePermission('website', 'view');
        $this->render('website_manager/index', [
            'title' => 'Website Manager',
            'websiteSettings' => $this->repository->getWebsiteSettings(),
            'sections' => $this->repository->websiteContent(),
            'galleryCount' => count($this->repository->getGalleryItems()),
            'teacherCount' => count($this->repository->getTeacherItems()),
            'messageCount' => count($this->repository->getContactMessages()),
            'reviewCount' => count($this->repository->getWebsiteReviews()),
            'templates' => getAvailableWebsiteTemplates(),
            'success' => $_SESSION['website_manager_success'] ?? '',
        ]);
        unset($_SESSION['website_manager_success']);
    }

    private function websiteManagerEdit(): void
    {
        $this->requirePermission('website', 'edit');
        $this->render('website_manager/edit', [
            'title' => 'Edit Website Content',
            'websiteSettings' => $this->repository->getWebsiteSettings(),
            'sections' => $this->repository->websiteContent(),
            'sectionKeys' => $this->websiteSectionKeys(),
        ]);
    }

    private function websiteManagerGallery(): void
    {
        $this->requirePermission('website', 'view');
        $galleryItems = $this->repository->getGalleryItems();
        $categories = array_values(array_unique(array_merge(
            ['Classroom', 'Sports', 'Graduation', 'Cultural Day', 'Excursion', 'Awards', 'Events', 'Laboratory', 'Library', 'General'],
            array_filter(array_map(static fn (array $item): string => trim((string) ($item['category'] ?? '')), $galleryItems))
        )));
        $this->render('website_manager/gallery', [
            'title' => 'Student Gallery',
            'items' => $this->repository->getGalleryItemsGrouped(),
            'categories' => $categories,
            'success' => $_SESSION['website_manager_success'] ?? '',
            'error' => $_SESSION['website_manager_error'] ?? '',
        ]);
        unset($_SESSION['website_manager_success'], $_SESSION['website_manager_error']);
    }

    private function websiteManagerTeachers(): void
    {
        $this->requirePermission('website', 'view');
        $this->render('website_manager/teachers', [
            'title' => 'Website Teachers',
            'items' => $this->repository->getTeacherItems(),
        ]);
    }

    private function websiteManagerReviews(): void
    {
        $this->requirePermission('website', 'view');
        $this->render('website_manager/reviews', [
            'title' => 'Parent Reviews',
            'items' => $this->repository->getWebsiteReviews(),
        ]);
    }

    private function websiteManagerMessages(): void
    {
        $this->requirePermission('website', 'view');
        $this->render('website_manager/messages', [
            'title' => 'Contact Messages',
            'messages' => $this->repository->getContactMessages(),
        ]);
    }

    private function websiteManagerMessageView(): void
    {
        $this->requirePermission('website', 'view');
        $message = $this->repository->getContactMessage((int) ($_GET['id'] ?? 0));
        if (!$message) {
            $this->notFound();
            return;
        }
        $this->render('website_manager/message_view', ['title' => 'Contact Message', 'message' => $message]);
    }

    private function homework(): void
    {
        $this->requirePermission('homework', 'view');
        $user = Auth::user() ?? [];
        $filters = [
            'class_name' => trim($_GET['class_name'] ?? ''),
            'section' => trim($_GET['section'] ?? ''),
            'teacher_id' => (int) ($_GET['teacher_id'] ?? 0),
            'subject_id' => (int) ($_GET['subject_id'] ?? 0),
            'status' => trim($_GET['status'] ?? ''),
        ];

        $this->render('homework/index', [
            'title' => 'Homework Portal',
            'homeworks' => $this->repository->homeworksForUser($user, $filters),
            'summary' => $this->repository->homeworkSummary($user),
            'teacherSummary' => $this->repository->homeworkTeacherSummary($user),
            'classSummary' => $this->repository->homeworkClassSummary($user),
            'subjects' => ($user['role'] ?? '') === 'teacher' ? $this->repository->subjectsForTeacher($user) : $this->repository->subjects(),
            'teachers' => $this->repository->teachers(),
            'classOptions' => $this->homeworkClassOptions($user),
            'sectionOptions' => ['A', 'B', 'C', 'D', 'E'],
            'filters' => $filters,
        ]);
    }

    private function homeworkForm(): void
    {
        $this->requirePermission('homework', 'create');
        $user = Auth::user() ?? [];
        $homework = null;
        $id = (int) ($_GET['id'] ?? 0);

        if ($id > 0) {
            $homework = $this->repository->homeworkById($id);
            if (!$homework || !$this->canManageHomework($homework, $user)) {
                $this->forbidden();
                return;
            }
        }

        $this->render('homework/form', [
            'title' => $homework ? 'Edit Homework' : 'Create Homework',
            'homework' => $homework,
            'subjects' => ($user['role'] ?? '') === 'teacher' ? $this->repository->subjectsForTeacher($user) : $this->repository->subjects(),
            'classOptions' => $this->homeworkClassOptions($user),
            'sectionOptions' => ['A', 'B', 'C', 'D', 'E'],
            'teacherAssignments' => $this->repository->teacherAssignmentsForUser($user),
            'errors' => $_SESSION['homework_errors'] ?? [],
        ]);
        unset($_SESSION['homework_errors']);
    }

    private function homeworkSubmissions(): void
    {
        $this->requirePermission('homework', 'view');
        $user = Auth::user() ?? [];
        $homeworkId = (int) ($_GET['homework_id'] ?? 0);
        $status = trim($_GET['status'] ?? '');
        $homeworks = $this->repository->homeworksForUser($user, ['status' => '']);
        $selected = $homeworkId > 0 ? $this->repository->homeworkById($homeworkId) : ($homeworks[0] ?? null);

        if ($selected && !$this->canViewHomework($selected, $user)) {
            $this->forbidden();
            return;
        }

        $this->render('homework/submissions', [
            'title' => 'Homework Submissions',
            'homeworks' => $homeworks,
            'selected' => $selected,
            'submissions' => $selected ? $this->repository->homeworkSubmissions((int) $selected['id'], $status) : [],
            'status' => $status,
        ]);
    }

    private function homeworkReports(): void
    {
        $this->requirePermission('homework', 'view');
        $user = Auth::user() ?? [];

        $this->render('homework/reports', [
            'title' => 'Homework Reports',
            'summary' => $this->repository->homeworkSummary($user),
            'teacherSummary' => $this->repository->homeworkTeacherSummary($user),
            'classSummary' => $this->repository->homeworkClassSummary($user),
            'subjectSummary' => $this->repository->homeworkSubjectSummary($user),
            'studentSummary' => $this->repository->homeworkStudentSummary($user),
        ]);
    }

    private function notifications(): void
    {
        $this->requirePermission('notifications', 'view');
        $user = Auth::user() ?? [];
        $status = trim($_GET['status'] ?? '');

        $this->render('notifications/index', [
            'title' => 'My Notifications',
            'notifications' => $this->repository->getUserNotifications((int) ($user['id'] ?? 0), $user['role'] ?? '', 0, false, $status),
            'status' => $status,
        ]);
    }

    private function notificationManager(): void
    {
        $this->requirePermission('notification_manager', 'manage');
        $filters = [
            'role' => trim($_GET['role'] ?? ''),
            'type' => trim($_GET['type'] ?? ''),
            'priority' => trim($_GET['priority'] ?? ''),
            'status' => trim($_GET['status'] ?? ''),
            'date' => trim($_GET['date'] ?? ''),
        ];

        $this->render('notifications/manager', [
            'title' => 'Notification Manager',
            'notifications' => $this->repository->getAllNotificationsForAdmin($filters),
            'filters' => $filters,
            'roles' => array_keys(Auth::ROLES),
            'types' => $this->repository->notificationTypes(),
            'priorities' => $this->repository->notificationPriorities(),
        ]);
    }

    private function notificationCount(): void
    {
        $this->requirePermission('notifications', 'view');
        $user = Auth::user() ?? [];
        header('Content-Type: application/json');
        echo json_encode(['count' => $this->repository->getUnreadNotificationCount((int) ($user['id'] ?? 0), $user['role'] ?? '')]);
    }

    private function notificationRecent(): void
    {
        $this->requirePermission('notifications', 'view');
        $user = Auth::user() ?? [];
        header('Content-Type: application/json');
        echo json_encode(['items' => $this->repository->getRecentNotifications((int) ($user['id'] ?? 0), $user['role'] ?? '', 5)]);
    }

    private function homeworkDownload(): void
    {
        $this->requireLogin();
        $path = trim($_GET['path'] ?? '');
        $user = Auth::user() ?? [];

        if (!$this->repository->canDownloadHomeworkFile($path, $user)) {
            $this->forbidden();
            return;
        }

        $fullPath = realpath(dirname(__DIR__) . '/public' . $path);
        $uploadRoot = realpath(dirname(__DIR__) . '/public/uploads/homework');
        if (!$fullPath || !$uploadRoot || !str_starts_with($fullPath, $uploadRoot) || !is_file($fullPath)) {
            $this->notFound();
            return;
        }

        header('Content-Type: application/octet-stream');
        header('Content-Disposition: attachment; filename="' . basename($fullPath) . '"');
        readfile($fullPath);
    }

