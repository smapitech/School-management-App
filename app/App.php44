    private function createAdmission(): void
    {
        $this->verifyCsrfOrForbidden();

        $id = (int) ($_POST['id'] ?? 0);
        $existing = $id > 0 ? $this->repository->admissionById($id) : null;
        if ($id > 0) {
            $this->requirePermission('admissions', 'edit');
            if (!$existing) {
                $_SESSION['admission_manage_errors'] = ['Admission record not found.'];
                $this->redirect(trim((string) ($_POST['return_to'] ?? '')) ?: '/admissions');
                return;
            }
        } else {
            $this->requirePermission('admissions', 'create');
        }

        $password = (string) ($_POST['password'] ?? '');
        $retypePassword = (string) ($_POST['password_confirmation'] ?? '');
        $registrationNo = trim($_POST['registration_no'] ?? '');
        $returnTo = trim((string) ($_POST['return_to'] ?? ''));
        if ($returnTo === '' || !str_starts_with($returnTo, '/') || str_contains($returnTo, '://')) {
            $returnTo = '';
        }

        if ($registrationNo === '') {
            $_SESSION['admission_create_errors'] = ['Admission number is required.'];
            $_SESSION['admission_create_old'] = $_POST;
            $this->redirect('/admissions/create' . ($id > 0 ? '?edit=' . $id . ($returnTo !== '' ? '&return_to=' . urlencode($returnTo) : '') : ''));
            return;
        }

        if (($password !== '' || $retypePassword !== '') && $password !== $retypePassword) {
            $_SESSION['admission_create_errors'] = ['Passwords do not match.'];
            $_SESSION['admission_create_old'] = $_POST;
            $this->redirect('/admissions/create' . ($id > 0 ? '?edit=' . $id . ($returnTo !== '' ? '&return_to=' . urlencode($returnTo) : '') : ''));
            return;
        }

        $profilePicture = $this->storeAdmissionUpload('profile_picture');
        $guardianPicture = $this->storeAdmissionUpload('guardian_picture');
        if ($existing) {
            $profilePicture = $profilePicture ?: ($existing['profile_picture'] ?? '');
            $guardianPicture = $guardianPicture ?: ($existing['guardian_picture'] ?? '');
        }

        $payload = [
            'academic_year' => trim($_POST['academic_year'] ?? ''),
            'school_term' => trim($_POST['school_term'] ?? ''),
            'registration_no' => $registrationNo,
            'admission_date' => trim($_POST['admission_date'] ?? ''),
            'class_name' => trim($_POST['class_name'] ?? ''),
            'section' => trim($_POST['section'] ?? ''),
            'first_name' => trim($_POST['first_name'] ?? ''),
            'middle_name' => trim($_POST['middle_name'] ?? ''),
            'last_name' => trim($_POST['last_name'] ?? ''),
            'date_of_birth' => trim($_POST['date_of_birth'] ?? ''),
            'gender' => trim($_POST['gender'] ?? ''),
            'religion' => trim($_POST['religion'] ?? ''),
            'address' => trim($_POST['address'] ?? ''),
            'email' => trim($_POST['email'] ?? ''),
            'city' => trim($_POST['city'] ?? ''),
            'state' => trim($_POST['state'] ?? ''),
            'profile_picture' => $profilePicture,
            'username' => trim($_POST['username'] ?? ''),
            'password' => $password,
            'mother_tongue' => trim($_POST['mother_tongue'] ?? ''),
            'guardian_full_name' => trim($_POST['guardian_full_name'] ?? ''),
            'guardian_relationship' => trim($_POST['guardian_relationship'] ?? ''),
            'father_name' => trim($_POST['father_name'] ?? ''),
            'mother_name' => trim($_POST['mother_name'] ?? ''),
            'guardian_occupation' => trim($_POST['guardian_occupation'] ?? ''),
            'guardian_address' => trim($_POST['guardian_address'] ?? ''),
            'guardian_city' => trim($_POST['guardian_city'] ?? ''),
            'guardian_state' => trim($_POST['guardian_state'] ?? ''),
            'guardian_mobile' => trim($_POST['guardian_mobile'] ?? ''),
            'guardian_picture' => $guardianPicture,
        ];

        if ($id > 0) {
            $this->repository->updateAdmission($id, $payload);
            $_SESSION['admission_manage_success'] = 'Admission updated successfully.';
            $this->redirect($returnTo !== '' ? $returnTo : '/admissions');
            return;
        }

        $this->repository->createAdmission($payload);
        $this->repository->createNotificationForRole('admin', 'New admission created', trim(($_POST['first_name'] ?? '') . ' ' . ($_POST['last_name'] ?? '')) . ' was admitted into ' . trim($_POST['class_name'] ?? ''), 'admission', '/admissions/admitted', 'normal', (int) ((Auth::user() ?? [])['id'] ?? 0));

        $this->redirect($returnTo !== '' ? $returnTo : '/admissions/admitted?class_name=' . urlencode(trim($_POST['class_name'] ?? '')));
    }

    private function deleteAdmission(string $module): void
    {
        $this->requirePermission($module, 'delete');
        $this->verifyCsrfOrForbidden();

        $id = (int) ($_POST['id'] ?? 0);
        $back = trim((string) ($_POST['back'] ?? ''));
        if ($back === '' || !str_starts_with($back, '/') || str_contains($back, '://')) {
            $back = '';
        }
        if ($back === '') {
            $back = $module === 'students' ? '/students' : '/admissions';
        }

        if ($id <= 0 || !$this->repository->admissionById($id)) {
            $_SESSION['admission_manage_errors'] = ['Admission record not found.'];
            $this->redirect($back);
            return;
        }

        $this->repository->deleteAdmission($id);
        $_SESSION['admission_manage_success'] = 'Admission deleted successfully.';
        $this->redirect($back);
    }

