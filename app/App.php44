    private function subjects(): void
    {
        if ((Auth::user()['role'] ?? '') === 'teacher') {
            $this->forbidden();
            return;
        }
        $this->requirePermission('classes', 'edit');

        $edit = isset($_GET['edit']) ? $this->repository->subjectById((int) $_GET['edit']) : null;
        $old = $_SESSION['subjects_old'] ?? [];
        $errors = $_SESSION['subjects_errors'] ?? [];
        $success = $_SESSION['subjects_success'] ?? '';
        unset($_SESSION['subjects_old'], $_SESSION['subjects_errors'], $_SESSION['subjects_success']);

        $form = array_merge([
            'id' => 0,
            'subject_name' => '',
            'subject_type' => '',
            'subject_code' => '',
        ], $edit ?: []);

        if (!empty($old)) {
            $form = array_merge($form, $old);
        }

        $this->render('classes/subjects', [
            'title' => 'Subjects',
            'subjects' => $this->repository->subjects(),
            'form' => $form,
            'errors' => $errors,
            'success' => $success,
        ]);
    }

    private function subjectAssign(): void
    {
        $user = Auth::user() ?? [];
        if (($user['role'] ?? '') === 'teacher') {
            $this->forbidden();
            return;
        }
        $this->requirePermission('classes', 'edit');

        $classOptions = $this->classOptions();
        $old = $_SESSION['subject_assign_old'] ?? [];
        $errors = $_SESSION['subject_assign_errors'] ?? [];
        $success = $_SESSION['subject_assign_success'] ?? '';
        unset($_SESSION['subject_assign_old'], $_SESSION['subject_assign_errors'], $_SESSION['subject_assign_success']);

        $selectedClassName = trim($_GET['class_name'] ?? '');
        if ($selectedClassName === '' && !empty($old['class_name'])) {
            $selectedClassName = trim((string) $old['class_name']);
        }

        if ($selectedClassName !== '' && !in_array($selectedClassName, $classOptions, true)) {
            $errors[] = 'Please select a valid class.';
            $selectedClassName = '';
        }

        $subjects = $this->repository->subjects();
        $currentAssignments = $selectedClassName !== '' ? $this->repository->subjectsForClass($selectedClassName) : [];

        if (!empty($old['subject_ids']) && ($selectedClassName === '' || trim((string) ($old['class_name'] ?? '')) === $selectedClassName)) {
            $selectedSubjectIds = array_values(array_unique(array_filter(array_map('intval', (array) $old['subject_ids']), static fn (int $subjectId): bool => $subjectId > 0)));
        } else {
            $selectedSubjectIds = array_values(array_unique(array_filter(array_map(
                static fn (array $row): int => (int) ($row['subject_id'] ?? 0),
                $currentAssignments
            ), static fn (int $subjectId): bool => $subjectId > 0)));
        }

        $this->render('classes/subject_assign', [
            'title' => 'Assign Subjects to Class',
            'classOptions' => $classOptions,
            'subjects' => $subjects,
            'selectedClassName' => $selectedClassName,
            'selectedSubjectIds' => $selectedSubjectIds,
            'currentAssignments' => $currentAssignments,
            'errors' => $errors,
            'success' => $success,
        ]);
    }

