    private function officeAccountingPrint(): void
    {
        $this->requirePermission('accounting', 'view');

        $filters = [
            'type' => trim($_GET['type'] ?? ''),
            'category' => trim($_GET['category'] ?? ''),
        ];

        $this->render('accounting/office_print', [
            'title' => 'Printable Office Accounting',
            'summary' => $this->repository->accountingSummary(),
            'transactions' => $this->repository->officeTransactions($filters),
            'filters' => $filters,
        ]);
    }

    private function printableQuery(array $filters): string
    {
        $clean = array_filter($filters, fn (string $value): bool => $value !== '');

        return $clean ? '?' . http_build_query($clean) : '';
    }

    private function students(): void
    {
        $this->requireLogin();
        $user = Auth::user() ?? [];
        $isTeacher = ($user['role'] ?? '') === 'teacher';
        $manageErrors = $_SESSION['admission_manage_errors'] ?? [];
        $manageSuccess = $_SESSION['admission_manage_success'] ?? '';
        unset($_SESSION['admission_manage_errors'], $_SESSION['admission_manage_success']);

        if ($isTeacher) {
            if (!Auth::can('students', 'view_assigned', $user)) {
                $this->forbidden();
                return;
            }
        } else {
            $this->requirePermission('students', 'view');
        }

        $filters = [
            'class_name' => trim($_GET['class_name'] ?? ''),
            'name' => trim($_GET['name'] ?? ''),
            'registration_no' => trim($_GET['registration_no'] ?? ''),
        ];
        if ($isTeacher) {
            $teacherId = $this->repository->getCurrentTeacherIdFromUser((int) ($user['id'] ?? 0));
            $classRows = $this->repository->getTeacherAssignedClasses($teacherId);
            $rows = $this->repository->getTeacherAssignedStudents($teacherId);
            $allowedClasses = array_values(array_unique(array_map(fn (array $row): string => $row['class_name'], $classRows)));
            $rows = array_values(array_filter($rows, function (array $row) use ($filters, $allowedClasses): bool {
                if ($filters['class_name'] !== '' && $row['class_name'] !== $filters['class_name']) {
                    return false;
                }

                if ($filters['name'] !== '') {
                    $needle = mb_strtolower($filters['name']);
                    $haystack = mb_strtolower(trim(($row['first_name'] ?: $row['applicant']) . ' ' . ($row['middle_name'] ?? '') . ' ' . ($row['last_name'] ?? '')));
                    if (!str_contains($haystack, $needle)) {
                        return false;
                    }
                }

                if ($filters['registration_no'] !== '' && !str_contains((string) ($row['registration_no'] ?? ''), $filters['registration_no'])) {
                    return false;
                }

                return in_array($row['class_name'], $allowedClasses, true);
            }));
        } else {
            $rows = $this->repository->admittedStudents($filters);
        }

        $this->render('students/index', [
            'title' => $isTeacher ? 'My Students' : 'Students',
            'classOptions' => $isTeacher ? $allowedClasses : $this->classOptions(),
            'filters' => $filters,
            'rows' => $rows,
            'isTeacher' => $isTeacher,
            'manageErrors' => $manageErrors,
            'manageSuccess' => $manageSuccess,
        ]);
    }

    private function studentPortalAccounts(): void
    {
        $this->requirePermission('students', 'edit');

        $filters = [
            'class_name' => trim($_GET['class_name'] ?? ''),
            'name' => trim($_GET['name'] ?? ''),
            'registration_no' => trim($_GET['registration_no'] ?? ''),
        ];

        $this->render('students/accounts', [
            'title' => 'Student and Parent Login Accounts',
            'classOptions' => $this->classOptions(),
            'filters' => $filters,
            'rows' => $this->repository->studentLoginAccounts($filters),
        ]);
    }

    private function admissions(): void
    {
        $this->requirePermission('admissions', 'view');
        $manageErrors = $_SESSION['admission_manage_errors'] ?? [];
        $manageSuccess = $_SESSION['admission_manage_success'] ?? '';
        unset($_SESSION['admission_manage_errors'], $_SESSION['admission_manage_success']);

        $this->render('admissions/index', [
            'title' => 'Admissions',
            'module' => Modules::all()['admissions'],
            'rows' => $this->repository->admissions(),
            'stats' => $this->repository->moduleStats('admissions'),
            'classOptions' => $this->classOptions(),
            'manageErrors' => $manageErrors,
            'manageSuccess' => $manageSuccess,
        ]);
    }

    private function admissionCreateForm(): void
    {
        $editId = (int) ($_GET['edit'] ?? 0);
        $edit = $editId > 0 ? $this->repository->admissionById($editId) : null;
        if ($editId > 0) {
            $this->requirePermission('admissions', 'edit');
            if (!$edit) {
                $this->notFound();
                return;
            }
        } else {
            $this->requirePermission('admissions', 'create');
        }

        $errors = $_SESSION['admission_create_errors'] ?? [];
        $old = $_SESSION['admission_create_old'] ?? [];
        unset($_SESSION['admission_create_errors'], $_SESSION['admission_create_old']);

        $form = array_merge([
            'id' => 0,
            'academic_year' => $this->academicYears()[0] ?? '',
            'school_term' => $this->schoolTerms()[0] ?? '',
            'registration_no' => '',
            'admission_date' => date('Y-m-d'),
            'class_name' => $this->classOptions()[0] ?? '',
            'section' => 'A',
            'first_name' => '',
            'middle_name' => '',
            'last_name' => '',
            'date_of_birth' => '',
            'gender' => 'Male',
            'religion' => '',
            'address' => '',
            'email' => '',
            'city' => '',
            'state' => '',
            'profile_picture' => '',
            'username' => '',
            'password' => '',
            'password_confirmation' => '',
            'mother_tongue' => '',
            'guardian_full_name' => '',
            'guardian_relationship' => '',
            'father_name' => '',
            'mother_name' => '',
            'guardian_occupation' => '',
            'guardian_address' => '',
            'guardian_city' => '',
            'guardian_state' => '',
            'guardian_mobile' => '',
            'guardian_picture' => '',
        ], $edit ?: []);

        if (!empty($old)) {
            $form = array_merge($form, $old);
        }

        $returnTo = trim((string) ($_GET['return_to'] ?? ''));
        if ($returnTo === '' || !str_starts_with($returnTo, '/') || str_contains($returnTo, '://')) {
            $returnTo = '';
        }
        if ($returnTo === '' && $editId > 0) {
            $returnTo = '/admissions';
        }

        $this->render('admissions/create', [
            'title' => $editId > 0 ? 'Edit Admission' : 'Create Admission',
            'academicYears' => $this->academicYears(),
            'schoolTerms' => $this->schoolTerms(),
            'classOptions' => $this->classOptions(),
            'sections' => ['A', 'B', 'C', 'D', 'E'],
            'form' => $form,
            'edit' => $edit,
            'returnTo' => $returnTo,
            'errors' => $errors,
        ]);
    }

    private function admittedStudents(): void
    {
        $this->requirePermission('admissions', 'view');
        $manageErrors = $_SESSION['admission_manage_errors'] ?? [];
        $manageSuccess = $_SESSION['admission_manage_success'] ?? '';
        unset($_SESSION['admission_manage_errors'], $_SESSION['admission_manage_success']);

        $className = trim($_GET['class_name'] ?? '');
        $this->render('admissions/admitted', [
            'title' => 'Admitted Students',
            'classOptions' => $this->classOptions(),
            'selectedClass' => $className,
            'rows' => $className === '' ? [] : $this->repository->admissions($className),
            'manageErrors' => $manageErrors,
            'manageSuccess' => $manageSuccess,
        ]);
    }

    private function handlePost(string $path): void
    {
        match ($path) {
            '/login' => $this->attemptLogin(),
            '/students/create' => $this->createStudent(),
            '/students/accounts/student-update' => $this->updateStudentPortalAccount(),
            '/students/accounts/student-delete' => $this->deleteStudentPortalAccount(),
            '/students/accounts/parent-update' => $this->updateParentPortalAccount(),
            '/students/accounts/parent-delete' => $this->deleteParentPortalAccount(),
            '/students/delete' => $this->deleteAdmission('students'),
            '/admissions/create' => $this->createAdmission(),
            '/admissions/delete' => $this->deleteAdmission('admissions'),
            '/staff/save' => $this->saveStaff(),
            '/staff/delete' => $this->deleteStaff(),
            '/staff/designations/save' => $this->saveDesignation(),
            '/staff/designations/delete' => $this->deleteDesignation(),
            '/staff/accounts/update' => $this->updateStaffAccount(),
            '/staff/accounts/delete' => $this->deleteStaffAccount(),
            '/human-resource/payroll/template' => $this->saveSalaryTemplate(),
            '/human-resource/salary-assign/save' => $this->saveSalaryAssignment(),
            '/human-resource/salary-payment/save' => $this->saveSalaryPayment(),
            '/classes/assign/save' => $this->saveClassAssignment(),
            '/classes/assign/delete' => $this->deleteClassAssignment(),
            '/classes/subjects/save' => $this->saveSubject(),
            '/classes/subjects/delete' => $this->deleteSubject(),
            '/classes/subject-assign/save' => $this->saveSubjectAssignment(),
            '/classes/timetable/save' => $this->saveTimetable(),
            '/teacher/classes/timetable/save' => $this->saveTeacherTimetable(),
            '/teacher/classes/timetable/delete' => $this->deleteTeacherTimetable(),
            '/teacher/attendance/save' => $this->saveTeacherAttendance(),
            '/teacher/messages/send' => $this->sendTeacherMessage(),
            '/teacher/messages/reply' => $this->replyTeacherMessage(),
            '/attendance/students/save' => $this->saveStudentAttendance(),
            '/attendance/staff/save' => $this->saveStaffAttendance(),
            '/exams/settings/save' => $this->saveExamSetting(),
            '/exams/distribution/save' => $this->saveMarkDistribution(),
            '/exams/distribution/delete' => $this->deleteMarkDistribution(),
            '/exams/distribution/grade-save' => $this->saveExamGrade(),
            '/exams/distribution/grade-delete' => $this->deleteExamGrade(),
            '/exams/marks/save' => $this->saveExamMarks(),
            '/exams/marks/delete' => $this->deleteExamMarks(),
            '/exams/schedule/save' => $this->saveExamSchedule(),
            '/exams/schedule/delete' => $this->deleteExamSchedule(),
