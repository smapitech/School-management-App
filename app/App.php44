    private function studentAttendance(): void
    {
        $this->requirePermission('attendance', 'view');
        $user = Auth::user() ?? [];
        if (($user['role'] ?? '') === 'teacher') {
            $this->redirect('/teacher/attendance');
            return;
        }
        $isTeacher = ($user['role'] ?? '') === 'teacher';
        $filters = [
            'class_name' => trim($_GET['class_name'] ?? ''),
            'section' => trim($_GET['section'] ?? ''),
            'attendance_date' => trim($_GET['attendance_date'] ?? date('Y-m-d')),
        ];
        $loaded = $filters['class_name'] !== '' && $filters['section'] !== '' && $filters['attendance_date'] !== '' && (!$isTeacher || $this->canUseExamClass($user, $filters['class_name'], $filters['section']));
        $students = $loaded ? $this->repository->admittedStudents(['class_name' => $filters['class_name'], 'section' => $filters['section']]) : [];
        $studentIds = array_map(fn (array $row): int => (int) $row['id'], $students);

        $this->render('attendance/students', [
            'title' => 'Student Attendance',
            'filters' => $filters,
            'classOptions' => $this->examClassOptions($user),
            'sections' => $this->sections(),
            'statuses' => $this->attendanceStatuses(),
            'students' => $students,
            'records' => $this->repository->studentAttendanceRecords($filters['attendance_date'], $studentIds),
            'loaded' => $loaded,
            'isTeacher' => $isTeacher,
        ]);
    }

    private function staffAttendance(): void
    {
        $this->requirePermission('attendance', 'view');
        if ((Auth::user()['role'] ?? '') === 'teacher') {
            $this->forbidden();
            return;
        }
        $filters = [
            'role' => trim($_GET['role'] ?? ''),
            'attendance_date' => trim($_GET['attendance_date'] ?? date('Y-m-d')),
        ];
        $loaded = $filters['role'] !== '' && $filters['attendance_date'] !== '';
        $staff = $loaded ? $this->repository->staff(['role' => $filters['role']]) : [];
        $staffIds = array_map(fn (array $row): int => (int) $row['id'], $staff);

        $this->render('attendance/staff', [
            'title' => 'Staff Attendance',
            'filters' => $filters,
            'roles' => $this->repository->attendanceStaffRoles(),
            'statuses' => $this->attendanceStatuses(),
            'staff' => $staff,
            'records' => $this->repository->staffAttendanceRecords($filters['attendance_date'], $staffIds),
            'loaded' => $loaded,
        ]);
    }

    private function teacherAttendance(): void
    {
        $this->requirePermission('attendance', 'mark_assigned_students');
        $user = Auth::user() ?? [];
        $teacherId = $this->repository->getCurrentTeacherIdFromUser((int) ($user['id'] ?? 0));
        $workspaceWarning = $teacherId <= 0 ? $this->teacherWorkspaceWarningMessage() : '';

        $filters = [
            'class_id' => (int) ($_GET['class_id'] ?? 0),
            'attendance_date' => trim($_GET['attendance_date'] ?? date('Y-m-d')),
        ];

        if ($teacherId > 0 && $filters['class_id'] > 0 && !$this->repository->teacherCanAccessClass($teacherId, $filters['class_id'])) {
            $this->notFound();
            return;
        }

        if (!preg_match('/^\d{4}-\d{2}-\d{2}$/', $filters['attendance_date'])) {
            $filters['attendance_date'] = date('Y-m-d');
        }

        $loaded = $filters['class_id'] > 0;
        $students = $loaded ? $this->repository->getStudentsForTeacherAttendance($teacherId, $filters['class_id']) : [];
        $studentIds = array_map(fn (array $row): int => (int) $row['id'], $students);

        $this->render('attendance/teacher_attendance', [
            'title' => 'Mark Student Attendance',
            'classes' => $this->repository->getTeacherAttendanceClasses($teacherId),
            'filters' => $filters,
            'statuses' => $this->teacherAttendanceStatuses(),
            'students' => $students,
            'records' => $this->repository->studentAttendanceRecords($filters['attendance_date'], $studentIds),
            'draftRows' => $_SESSION['teacher_attendance_old_rows'] ?? [],
            'loaded' => $loaded,
            'success' => $_SESSION['teacher_attendance_success'] ?? '',
            'workspaceWarning' => $workspaceWarning,
            'errors' => $_SESSION['teacher_attendance_errors'] ?? [],
        ]);
        unset($_SESSION['teacher_attendance_old_rows'], $_SESSION['teacher_attendance_success'], $_SESSION['teacher_attendance_errors']);
    }

    private function teacherAttendanceHistory(): void
    {
        $this->requirePermission('attendance', 'view_assigned_attendance');
        $user = Auth::user() ?? [];
        $teacherId = $this->repository->getCurrentTeacherIdFromUser((int) ($user['id'] ?? 0));
        $workspaceWarning = $teacherId <= 0 ? $this->teacherWorkspaceWarningMessage() : '';

        $filters = [
            'class_id' => (int) ($_GET['class_id'] ?? 0),
            'attendance_date' => trim($_GET['attendance_date'] ?? ''),
            'status' => trim($_GET['status'] ?? ''),
        ];

        if ($teacherId > 0 && $filters['class_id'] > 0 && !$this->repository->teacherCanAccessClass($teacherId, $filters['class_id'])) {
            $this->notFound();
            return;
        }

        if ($filters['attendance_date'] !== '' && !preg_match('/^\d{4}-\d{2}-\d{2}$/', $filters['attendance_date'])) {
            $filters['attendance_date'] = '';
        }

        if ($filters['status'] !== '' && !in_array($filters['status'], $this->teacherAttendanceStatuses(), true)) {
            $filters['status'] = '';
        }

        $rows = $this->repository->getTeacherAttendanceHistory($teacherId, $filters);
        $summary = ['Present' => 0, 'Absent' => 0, 'Late' => 0, 'Excused' => 0];
        foreach ($rows as $row) {
            $status = $row['status'] ?? '';
            if (isset($summary[$status])) {
                $summary[$status]++;
            }
        }

        $this->render('attendance/teacher_attendance_history', [
            'title' => 'Attendance History',
            'classes' => $this->repository->getTeacherAttendanceClasses($teacherId),
            'filters' => $filters,
            'statuses' => $this->teacherAttendanceStatuses(),
            'rows' => $rows,
            'summary' => $summary,
            'workspaceWarning' => $workspaceWarning,
        ]);
    }

    private function teacherMyAttendance(): void
    {
        $this->requirePermission('attendance', 'view_own_staff_attendance');
        $user = Auth::user() ?? [];
        $teacherId = $this->repository->getCurrentTeacherIdFromUser((int) ($user['id'] ?? 0));
        $workspaceWarning = $teacherId <= 0 ? $this->teacherWorkspaceWarningMessage() : '';

        $staff = $this->repository->staffById($teacherId);
        if (!$staff) {
            $workspaceWarning = $this->teacherWorkspaceWarningMessage();
            $staff = [];
        }

        $filters = [
            'month' => trim($_GET['month'] ?? date('Y-m')),
            'status' => trim($_GET['status'] ?? ''),
        ];

        if (!preg_match('/^\d{4}-\d{2}$/', $filters['month'])) {
            $filters['month'] = date('Y-m');
        }

        $statuses = $this->teacherStaffAttendanceStatuses();
        if ($filters['status'] !== '' && !in_array($filters['status'], $statuses, true)) {
            $filters['status'] = '';
        }

        $monthRows = $this->repository->getTeacherStaffAttendance($teacherId, ['month' => $filters['month']]);
        $rows = $filters['status'] !== ''
            ? $this->repository->getTeacherStaffAttendance($teacherId, $filters)
            : $monthRows;

        $this->render('staff/teacher_my_attendance', [
            'title' => 'My Staff Attendance',
            'staff' => $staff,
            'filters' => $filters,
            'statuses' => $statuses,
            'rows' => $rows,
            'summary' => $this->summarizeTeacherStaffAttendanceRows($monthRows),
            'workspaceWarning' => $workspaceWarning,
        ]);
    }

