    private function teacherStudents(): void
    {
        $this->requirePermission('classes', 'view_students');
        $user = Auth::user() ?? [];
        $isTeacher = ($user['role'] ?? '') === 'teacher';
        $teacherId = $isTeacher ? $this->repository->getCurrentTeacherIdFromUser((int) ($user['id'] ?? 0)) : 0;
        $classId = (int) ($_GET['class_id'] ?? 0);
        $studentId = (int) ($_GET['student_id'] ?? 0);
        $name = trim($_GET['name'] ?? '');
        $registrationNo = trim($_GET['registration_no'] ?? '');
        $selectedStudent = null;

        if ($isTeacher) {
            $classes = $this->repository->getTeacherAssignedClasses($teacherId);
            if ($classId > 0 && !$this->repository->teacherCanAccessClass($teacherId, $classId)) {
                $this->notFound();
                return;
            }

            $rows = $this->repository->getTeacherAssignedStudents($teacherId);
            if ($classId > 0) {
                $rows = array_values(array_filter($rows, function (array $row) use ($classes, $classId): bool {
                    foreach ($classes as $class) {
                        if ((int) ($class['class_id'] ?? 0) === $classId && $class['class_name'] === $row['class_name']) {
                            if (($class['section'] ?? '') === '' || ($row['section'] ?? '') === ($class['section'] ?? '')) {
                                return true;
                            }
                        }
                    }

                    return false;
                }));
            }

            if ($name !== '') {
                $needle = mb_strtolower($name);
                $rows = array_values(array_filter($rows, function (array $row) use ($needle): bool {
                    $fullName = mb_strtolower(trim(($row['first_name'] ?: $row['applicant']) . ' ' . ($row['middle_name'] ?? '') . ' ' . ($row['last_name'] ?? '')));
                    return str_contains($fullName, $needle);
                }));
            }

            if ($registrationNo !== '') {
                $rows = array_values(array_filter($rows, function (array $row) use ($registrationNo): bool {
                    return str_contains((string) ($row['registration_no'] ?? ''), $registrationNo);
                }));
            }

            if ($studentId > 0) {
                if (!$this->repository->teacherCanAccessStudent($teacherId, $studentId)) {
                    $this->notFound();
                    return;
                }

                foreach ($rows as $row) {
                    if ((int) $row['id'] === $studentId) {
                        $selectedStudent = $row;
                        break;
                    }
                }
            }
        } else {
            $filters = [
                'class_name' => trim($_GET['class_name'] ?? ''),
                'name' => $name,
                'registration_no' => $registrationNo,
            ];
            $rows = $this->repository->admittedStudents($filters);
            if ($studentId > 0) {
                foreach ($rows as $row) {
                    if ((int) $row['id'] === $studentId) {
                        $selectedStudent = $row;
                        break;
                    }
                }
            }
            $classes = $this->repository->classAssignments();
        }

        $this->render('classes/teacher_students', [
            'title' => $isTeacher ? 'My Students' : 'Students',
            'isTeacher' => $isTeacher,
            'classes' => $classes,
            'students' => $rows,
            'selectedStudent' => $selectedStudent,
            'selectedClassId' => $classId,
            'filters' => [
                'class_id' => $classId,
                'name' => $name,
                'registration_no' => $registrationNo,
            ],
        ]);
    }

