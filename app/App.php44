    private function saveStaff(): void
    {
        $id = (int) ($_POST['id'] ?? 0);
        $this->requirePermission('staff', $id ? 'edit' : 'create');
        $password = (string) ($_POST['password'] ?? '');
        $confirm = (string) ($_POST['password_confirmation'] ?? '');

        if (!$id && $password !== $confirm) {
            $this->redirect('/staff/add');
        }

        $existing = $id ? $this->repository->staffById($id) : null;
        $photo = $this->storeStaffUpload('staff_photo') ?: ($existing['staff_photo'] ?? '');
        $role = trim($_POST['role'] ?? '');
        $role = match ($role) {
            'Assistant Teacher' => 'Asst Teacher',
            'Account' => 'Accountant',
            'Library' => 'Library',
            default => $role,
        };

        $this->repository->saveStaff([
            'employee_no' => trim($_POST['employee_no'] ?? ''),
            'name' => trim($_POST['name'] ?? ''),
            'middle_name' => trim($_POST['middle_name'] ?? ''),
            'surname' => trim($_POST['surname'] ?? ''),
            'role' => $role,
            'joining_date' => trim($_POST['joining_date'] ?? ''),
            'designation' => trim($_POST['designation'] ?? ''),
            'qualification' => trim($_POST['qualification'] ?? ''),
            'experience_details' => trim($_POST['experience_details'] ?? ''),
            'gender' => trim($_POST['gender'] ?? ''),
            'religion' => trim($_POST['religion'] ?? ''),
            'date_of_birth' => trim($_POST['date_of_birth'] ?? ''),
            'mobile_no' => trim($_POST['mobile_no'] ?? ''),
            'address' => trim($_POST['address'] ?? ''),
            'email' => trim($_POST['email'] ?? ''),
            'staff_photo' => $photo,
            'username' => trim($_POST['username'] ?? ''),
            'password' => $password !== '' ? password_hash($password, PASSWORD_DEFAULT) : ($existing['password'] ?? ''),
            'bank_name' => trim($_POST['bank_name'] ?? ''),
            'account_name' => trim($_POST['account_name'] ?? ''),
            'account_number' => trim($_POST['account_number'] ?? ''),
            'department' => $role,
            'status' => 'Active',
        ], $id ?: null);

        $this->redirect('/staff?role=' . urlencode($role ?: 'Admin'));
    }

