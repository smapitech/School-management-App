    private function validateHomework(array $data, array $user): array
    {
        $errors = [];
        if ($data['title'] === '' || strlen($data['title']) > 255) {
            $errors[] = 'Homework title is required and must be below 255 characters.';
        }
        if ($data['class_name'] === '' || $data['section'] === '') {
            $errors[] = 'Class and section are required.';
        }
        if (($user['role'] ?? '') === 'teacher' && !$this->canUseExamClass($data['class_name'], $data['section'], $user)) {
            $errors[] = 'Teachers can only create homework for assigned classes.';
        }
        if ((int) $data['subject_id'] <= 0) {
            $errors[] = 'Subject is required.';
        }
        if ($data['description'] === '') {
            $errors[] = 'Description or instructions are required.';
        }
        if ($data['due_at'] === '' || strtotime($data['due_at']) <= time()) {
            $errors[] = 'Due date and time must be a future date.';
        }
        if ((float) $data['total_marks'] < 1) {
            $errors[] = 'Total marks must be at least 1.';
        }
        if (!in_array($data['submission_type'], ['text', 'file', 'both', 'link'], true)) {
            $errors[] = 'Select a valid submission type.';
        }
        if ($data['resource_link'] !== '' && !filter_var($data['resource_link'], FILTER_VALIDATE_URL)) {
            $errors[] = 'External resource link must be a valid URL.';
        }

        return $errors;
    }

    private function homeworkTeacherId(array $user): int
    {
        $staff = $this->repository->staffByEmail($user['email'] ?? '');
        return (int) ($staff['id'] ?? 0);
    }

    private function canManageHomework(array $homework, array $user): bool
    {
        if (in_array($user['role'] ?? '', ['superadmin', 'admin'], true)) {
            return true;
        }

        if (($user['role'] ?? '') !== 'teacher') {
            return false;
        }

        return $this->canUseExamClass($homework['class_name'] ?? '', $homework['section'] ?? '', $user)
            && ((int) ($homework['teacher_id'] ?? 0) === 0 || (int) ($homework['teacher_id'] ?? 0) === $this->homeworkTeacherId($user));
    }

    private function canViewHomework(array $homework, array $user): bool
    {
        if (in_array($user['role'] ?? '', ['superadmin', 'admin'], true)) {
            return true;
        }

        return ($user['role'] ?? '') === 'teacher'
            && $this->canUseExamClass($homework['class_name'] ?? '', $homework['section'] ?? '', $user);
    }

    private function homeworkClassOptions(array $user): array
    {
        if (($user['role'] ?? '') !== 'teacher') {
            return $this->classOptions();
        }

        return array_values(array_unique(array_map(fn (array $row): string => $row['class_name'], $this->repository->teacherAssignmentsForUser($user))));
    }

