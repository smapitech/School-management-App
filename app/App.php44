    private function teacherStaffAttendanceStatuses(): array
    {
        return ['Present', 'Absent', 'Late', 'Excused', 'Leave', 'Half Day'];
    }

    private function summarizeTeacherStaffAttendanceRows(array $rows): array
    {
        $summary = [
            'total' => 0,
            'Present' => 0,
            'Absent' => 0,
            'Late' => 0,
            'Excused' => 0,
            'Leave' => 0,
            'Half Day' => 0,
            'Other' => 0,
        ];

        foreach ($rows as $row) {
            $summary['total']++;
            $status = strtolower(trim((string) ($row['status'] ?? '')));
            switch ($status) {
                case 'present':
                    $summary['Present']++;
                    break;
                case 'absent':
                    $summary['Absent']++;
                    break;
                case 'late':
                    $summary['Late']++;
                    break;
                case 'excused':
                    $summary['Excused']++;
                    break;
                case 'leave':
                    $summary['Leave']++;
                    break;
                case 'half day':
                case 'half-day':
                case 'halfday':
                    $summary['Half Day']++;
                    break;
                default:
                    $summary['Other']++;
                    break;
            }
        }

        return $summary;
    }

    private function notifyAttendanceParentForStudent(array $student, string $status, string $date, string $remark, int $createdBy): void
    {
        $recipientLogin = trim((string) ($student['parent_username'] ?? ''));
        if ($recipientLogin === '') {
            $recipientLogin = trim((string) ($student['guardian_mobile'] ?? ''));
        }

        if ($recipientLogin === '') {
            return;
        }

        $parent = $this->repository->findUserByEmail($recipientLogin);
        if (!$parent || ($parent['role'] ?? '') !== 'parent') {
            return;
        }

        $firstName = trim((string) ($student['first_name'] ?? ''));
        if ($firstName === '') {
            $firstName = trim((string) ($student['applicant'] ?? ''));
        }

        $studentName = trim($firstName . ' ' . ($student['middle_name'] ?? '') . ' ' . ($student['last_name'] ?? ''));
        $classLabel = trim((string) (($student['class_name'] ?? '') . ' ' . ($student['section'] ?? '')));
        $message = $studentName . ' was marked ' . strtolower($status) . ' on ' . $date . '.';
        if ($classLabel !== '') {
            $message .= ' Class: ' . $classLabel . '.';
        }
        if ($remark !== '') {
            $message .= ' Note: ' . $remark;
        }

        $this->repository->createNotificationForUser(
            (int) $parent['id'],
            'Attendance notice',
            $message,
            'attendance',
            '/parent_portal',
            $status === 'Absent' ? 'high' : 'normal',
            $createdBy
        );
    }

    private function notifyTeacherConversationRecipient(array $conversation, int $senderTeacherId, string $subject, string $message, int $createdBy, array $attachment = []): void
    {
        $subject = trim($subject) !== '' ? trim($subject) : 'New message';
        $teacherName = $this->teacherStaffDisplayName($senderTeacherId);
        $snippet = trim($message);
        if ($snippet === '') {
            $snippet = 'An attachment was shared in the conversation.';
        }

        if (($conversation['conversation_type'] ?? '') === 'teacher_parent') {
            $recipientLogin = trim((string) (($conversation['parent_username'] ?? '') ?: ($conversation['guardian_mobile'] ?? '')));
            if ($recipientLogin === '') {
                return;
            }

            $parent = $this->repository->findUserByEmail($recipientLogin);
            if (!$parent || ($parent['role'] ?? '') !== 'parent') {
                return;
            }

            $studentContext = trim((string) ($conversation['student_name'] ?? ''));
            if ($studentContext === '') {
                $studentContext = 'your child';
            }

            $portalMessage = '<p><strong>Teacher:</strong> ' . e($teacherName) . '</p>'
                . '<p><strong>Student:</strong> ' . e($studentContext) . '</p>'
                . '<p>' . nl2br(e($snippet)) . '</p>';

            $this->repository->createCommunicationMessage([
                'message_type' => 'Internal',
                'channel' => 'Internal',
                'audience' => 'Parents',
                'recipient_role' => 'parent',
                'recipient_name' => $conversation['participant_name'] ?? 'Parent',
                'recipient_contact' => $recipientLogin,
                'subject' => $subject,
                'message' => $portalMessage,
                'attachment_path' => trim((string) ($attachment['attachment_path'] ?? '')),
                'attachment_name' => trim((string) ($attachment['attachment_name'] ?? '')),
                'status' => 'Queued',
            ]);

            $this->repository->createNotificationForUser(
                (int) $parent['id'],
                $subject,
                $teacherName . ' sent a new message about ' . $studentContext . '.',
                'message',
                '/parent_portal',
                'normal',
                $createdBy
            );

            return;
        }

        $recipientTeacherId = (int) (($conversation['teacher_id'] ?? 0) === $senderTeacherId
            ? ($conversation['other_teacher_id'] ?? 0)
            : ($conversation['teacher_id'] ?? 0));
        if ($recipientTeacherId <= 0) {
            return;
        }

        $recipientTeacher = $this->teacherNotificationAccount($recipientTeacherId);
        if (!$recipientTeacher) {
            return;
        }

        $this->repository->createNotificationForUser(
            (int) $recipientTeacher['id'],
            $subject,
            $teacherName . ' sent you a new message.',
            'message',
            '/teacher/messages/view?id=' . (int) ($conversation['id'] ?? 0),
            'normal',
            $createdBy
        );
    }

    private function teacherNotificationAccount(int $teacherId): ?array
    {
        $staff = $this->repository->staffById($teacherId);
        if (!$staff) {
            return null;
        }

        foreach (array_values(array_filter([
            trim((string) ($staff['username'] ?? '')),
            trim((string) ($staff['email'] ?? '')),
        ])) as $candidate) {
            $account = $this->repository->findUserByEmail($candidate);
            if ($account && ($account['role'] ?? '') === 'teacher') {
                return $account;
            }
        }

        return null;
    }

    private function teacherStaffDisplayName(int $teacherId): string
    {
        $staff = $this->repository->staffById($teacherId);
        if ($staff) {
            return trim(($staff['name'] ?? '') . ' ' . ($staff['middle_name'] ?? '') . ' ' . ($staff['surname'] ?? ''));
        }

        return 'Teacher';
    }

    private function render(string $template, array $data): void
    {
        $user = Auth::user();
        $data['user'] = $user;
        $data['modules'] = Auth::visibleModules(Modules::all(), $user);
        $data['settings'] = $data['settings'] ?? $this->repository->settings();
        $data['profilePhoto'] = $this->repository->profilePhotoForUser($user);
        $data['recentNotifications'] = $user ? $this->repository->getRecentNotifications((int) ($user['id'] ?? 0), $user['role'] ?? '', 5) : [];
        $data['notificationUnreadCount'] = $user ? $this->repository->getUnreadNotificationCount((int) ($user['id'] ?? 0), $user['role'] ?? '') : 0;
        echo $this->view->render($template, $data);
    }

    private function renderPublic(string $template, array $data): void
    {
        $data['modules'] = [];
        $data['user'] = null;
        echo $this->view->render($template, $data);
    }

    private function renderWebsite(string $template, array $data): void
    {
        extract($data, EXTR_SKIP);
        require dirname(__DIR__) . '/resources/views/' . $template . '.php';
    }

    private function notFound(): void
    {
        http_response_code(404);
        $this->render('not-found', [
            'title' => 'Page not found',
            'homeLink' => Auth::check() ? '/dashboard' : '/website',
        ]);
    }

    private function forbidden(): void
    {
        http_response_code(403);
        $this->render('forbidden', [
            'title' => 'Access denied',
            'homeLink' => Auth::check() ? '/dashboard' : '/website',
        ]);
    }

    private function requireLogin(): void
    {
        if (!Auth::check()) {
            $this->redirect('/login');
        }
    }

    private function requirePermission(string $module, string $action): void
    {
        $this->requireLogin();

        if (!Auth::can($module, $action)) {
            $this->forbidden();
            exit;
        }
    }

    private function redirect(string $path): void
    {
        header('Location: ' . $path);
        exit;
    }
}
