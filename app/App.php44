    private function saveSubject(): void
    {
        $this->requirePermission('classes', 'edit');
        $this->verifyCsrfOrForbidden();

        $id = (int) ($_POST['id'] ?? 0);
        $data = [
            'subject_name' => trim($_POST['subject_name'] ?? ''),
            'subject_type' => trim($_POST['subject_type'] ?? ''),
            'subject_code' => trim($_POST['subject_code'] ?? ''),
        ];
        $errors = [];

        if ($data['subject_name'] === '') {
            $errors[] = 'Subject name is required.';
        }

        if ($data['subject_type'] === '') {
            $errors[] = 'Subject type is required.';
        }

        if ($data['subject_code'] === '') {
            $errors[] = 'Subject code is required.';
        }

        if ($data['subject_code'] !== '' && $this->repository->subjectCodeExists($data['subject_code'], $id)) {
            $errors[] = 'Subject code already exists.';
        }

        if ($errors) {
            $_SESSION['subjects_errors'] = $errors;
            $_SESSION['subjects_old'] = array_merge(['id' => $id], $data);
            $this->redirect('/classes/subjects' . ($id > 0 ? '?edit=' . $id : ''));
        }

        if ($id > 0) {
            if (!$this->repository->subjectById($id)) {
                $_SESSION['subjects_errors'] = ['Subject not found.'];
                $_SESSION['subjects_old'] = array_merge(['id' => $id], $data);
                $this->redirect('/classes/subjects');
            }

            $this->repository->updateSubject($id, $data);
            $_SESSION['subjects_success'] = 'Subject updated successfully.';
            $this->redirect('/classes/subjects?edit=' . $id);
        }

        $this->repository->saveSubject($data);
        $_SESSION['subjects_success'] = 'Subject created successfully.';
        $this->redirect('/classes/subjects');
    }

    private function deleteSubject(): void
    {
        $this->requirePermission('classes', 'edit');
        $this->verifyCsrfOrForbidden();

        $id = (int) ($_POST['id'] ?? 0);
        $subject = $id > 0 ? $this->repository->subjectById($id) : null;

        if (!$subject) {
            $_SESSION['subjects_errors'] = ['Subject not found.'];
            $this->redirect('/classes/subjects');
        }

        $usage = $this->repository->subjectUsageSummary($id);
        $labels = [
            'subject_assignments' => 'class subject assignments',
            'timetables' => 'timetables',
            'exam_settings' => 'exam records',
            'homework_assignments' => 'homework assignments',
            'teacher_assignments' => 'teacher assignments',
        ];
        $inUse = [];

        foreach ($usage as $key => $count) {
            if ((int) $count > 0) {
                $inUse[] = ((int) $count) . ' ' . ($labels[$key] ?? $key);
            }
        }

        if ($inUse) {
            $_SESSION['subjects_errors'] = [
                'This subject is already linked to ' . implode(', ', $inUse) . '. Remove those links first.'
            ];
            $_SESSION['subjects_old'] = $subject;
            $this->redirect('/classes/subjects?edit=' . $id);
        }

        $this->repository->deleteSubject($id);
        $_SESSION['subjects_success'] = 'Subject deleted successfully.';
        $this->redirect('/classes/subjects');
    }

    private function saveSubjectAssignment(): void
    {
        $this->requirePermission('classes', 'edit');
        $this->verifyCsrfOrForbidden();

        $classOptions = $this->classOptions();
        $className = trim($_POST['class_name'] ?? '');
        $subjectIds = array_values(array_unique(array_filter(array_map(
            'intval',
            (array) ($_POST['subject_ids'] ?? [])
        ), static fn (int $subjectId): bool => $subjectId > 0)));

        $errors = [];
        if ($className === '' || !in_array($className, $classOptions, true)) {
            $errors[] = 'Please select a valid class.';
        }

        if (empty($subjectIds)) {
            $errors[] = 'Please select at least one subject.';
        }

        $existingSubjects = [];
        foreach ($this->repository->subjects() as $subject) {
            $existingSubjects[(int) ($subject['id'] ?? 0)] = true;
        }

        foreach ($subjectIds as $subjectId) {
            if (!isset($existingSubjects[$subjectId])) {
                $errors[] = 'One or more selected subjects could not be found.';
                break;
            }
        }

        if ($errors) {
            $_SESSION['subject_assign_errors'] = array_values(array_unique($errors));
            $_SESSION['subject_assign_old'] = [
                'class_name' => $className,
                'subject_ids' => $subjectIds,
            ];
            $this->redirect('/classes/subject-assign' . ($className !== '' ? '?class_name=' . urlencode($className) : ''));
        }

        try {
            $this->repository->syncSubjectAssignments($className, $subjectIds);
        } catch (\Throwable $throwable) {
            $_SESSION['subject_assign_errors'] = ['Unable to save subject assignments right now. Please try again.'];
            $_SESSION['subject_assign_old'] = [
                'class_name' => $className,
                'subject_ids' => $subjectIds,
            ];
            $this->redirect('/classes/subject-assign' . ($className !== '' ? '?class_name=' . urlencode($className) : ''));
        }

        $_SESSION['subject_assign_success'] = 'Subjects assigned to ' . $className . ' successfully.';
        $this->redirect('/classes/subject-assign?class_name=' . urlencode($className));
    }

