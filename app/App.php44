        $classes = $isTeacher ? $this->repository->getTeacherAssignedClasses($teacherId) : $this->repository->classAssignments();
        $subjects = $isTeacher ? $this->repository->getTeacherAssignedSubjects($teacherId) : $this->repository->subjectAssignments();

        if ($classId > 0) {
            $subjects = array_values(array_filter($subjects, fn (array $row): bool => (int) ($row['class_id'] ?? 0) === $classId));
