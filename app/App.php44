    private function examSettings(): void
    {
        $this->requirePermission('exams', 'view');
        $user = Auth::user() ?? [];

        if (($user['role'] ?? '') !== 'superadmin') {
            $_SESSION['exam_notice'] = 'Manual exam setup has been automated. Use Mark Distribution to manage score components, then enter marks from Exam Mark.';
            $this->redirect('/exams/distribution');
        }

        $notice = $_SESSION['exam_notice'] ?? '';
        unset($_SESSION['exam_notice']);

        $this->render('exams/settings', [
            'title' => 'Configured Exam Records',
            'notice' => $notice,
            'settings' => $this->repository->examSettings($user),
        ]);
    }

