<?php

declare(strict_types=1);

namespace App;

use PDO;

final class Database
{
    private PDO $pdo;
    private string $driver;

    public function __construct(array $config)
    {
        $this->driver = $config['driver'] ?? 'sqlite';
        $options = [
            PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
            PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
            PDO::ATTR_EMULATE_PREPARES => false,
            PDO::ATTR_STRINGIFY_FETCHES => false,
        ];

        if ($this->driver === 'mysql') {
            $mysql = $config['mysql'] ?? [];
            $charset = $mysql['charset'] ?? 'utf8mb4';
            $port = (int) ($mysql['port'] ?? 3306);
            $socket = trim((string) ($mysql['socket'] ?? ''));
            $dsn = $socket !== ''
                ? "mysql:unix_socket={$socket};dbname={$mysql['database']};charset={$charset}"
                : "mysql:host={$mysql['host']};port={$port};dbname={$mysql['database']};charset={$charset}";
            $this->pdo = new PDO($dsn, $mysql['username'] ?? '', $mysql['password'] ?? '', $options);
        } else {
            $path = $config['sqlite']['path'] ?? dirname(__DIR__) . '/storage/database.sqlite';
            $directory = dirname($path);

            if (!is_dir($directory)) {
                @mkdir($directory, 0775, true);
            }

            if (!is_file($path)) {
                @touch($path);
            }

            $this->pdo = new PDO('sqlite:' . $path, null, null, $options);
        }
    }

    public function pdo(): PDO
    {
        return $this->pdo;
    }

    public function migrate(): void
    {
        if ($this->driver === 'mysql') {
            return;
        }

        $this->pdo->exec(<<<SQL
            CREATE TABLE IF NOT EXISTS students (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                student_no TEXT NOT NULL,
                name TEXT NOT NULL,
                class_name TEXT NOT NULL,
                guardian TEXT NOT NULL,
                status TEXT NOT NULL,
                created_at TEXT NOT NULL
            );

            CREATE TABLE IF NOT EXISTS admissions (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                applicant TEXT NOT NULL,
                class_name TEXT NOT NULL,
                guardian TEXT NOT NULL,
                stage TEXT NOT NULL,
                created_at TEXT NOT NULL
            );

            CREATE TABLE IF NOT EXISTS staff (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                employee_no TEXT NOT NULL,
                name TEXT NOT NULL,
                role TEXT NOT NULL,
                department TEXT NOT NULL,
                status TEXT NOT NULL
            );

            CREATE TABLE IF NOT EXISTS classes (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name TEXT NOT NULL,
                teacher TEXT NOT NULL,
                room TEXT NOT NULL,
                capacity INTEGER NOT NULL
            );

            CREATE TABLE IF NOT EXISTS attendance (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                class_name TEXT NOT NULL,
                date TEXT NOT NULL,
                present INTEGER NOT NULL,
                absent INTEGER NOT NULL
            );

            CREATE TABLE IF NOT EXISTS fees (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                invoice_no TEXT NOT NULL,
                student_name TEXT NOT NULL,
                amount REAL NOT NULL,
                status TEXT NOT NULL,
                created_at TEXT NOT NULL
            );

            CREATE TABLE IF NOT EXISTS exams (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                title TEXT NOT NULL,
                class_name TEXT NOT NULL,
                subject TEXT NOT NULL,
                exam_date TEXT NOT NULL,
                status TEXT NOT NULL
            );

            CREATE TABLE IF NOT EXISTS library_books (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                title TEXT NOT NULL,
                author TEXT NOT NULL,
                copies INTEGER NOT NULL,
                status TEXT NOT NULL
            );

            CREATE TABLE IF NOT EXISTS transport_routes (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                route_name TEXT NOT NULL,
                driver TEXT NOT NULL,
                vehicle TEXT NOT NULL,
                students INTEGER NOT NULL
            );

            CREATE TABLE IF NOT EXISTS hostel_rooms (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                room_no TEXT NOT NULL,
                block TEXT NOT NULL,
                capacity INTEGER NOT NULL,
                occupied INTEGER NOT NULL
            );

            CREATE TABLE IF NOT EXISTS announcements (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                title TEXT NOT NULL,
                audience TEXT NOT NULL,
                publish_date TEXT NOT NULL
            );

            CREATE TABLE IF NOT EXISTS users (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name TEXT NOT NULL,
                email TEXT NOT NULL UNIQUE,
                password TEXT NOT NULL,
                role TEXT NOT NULL,
                status TEXT NOT NULL,
                created_at TEXT NOT NULL
            );

            CREATE TABLE IF NOT EXISTS settings (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                setting_key TEXT NOT NULL UNIQUE,
                setting_value TEXT NOT NULL
            );
        SQL);

        $this->ensureAdmissionColumns();
        $this->ensureFeeColumns();
        $this->ensureStaffColumns();
        $this->ensureDesignationTable();
        $this->ensurePayrollTables();
        $this->ensureClassModuleTables();
        $this->ensureAccountingTables();
        $this->ensureFeeReminderTable();
        $this->ensureAttendanceTables();
        $this->ensureCommunicationTables();
        $this->ensureNotificationTables();
        $this->ensureApiTables();
        $this->ensureStudentPortalTables();
        $this->ensureExamTables();
        $this->ensureMarksheetTemplateTable();
        $this->ensureWebsiteTables();
        $this->ensureUiThemeSettings();

        if ((int) $this->pdo->query('SELECT COUNT(*) FROM students')->fetchColumn() === 0) {
            $this->seed();
        }

        if ((int) $this->pdo->query('SELECT COUNT(*) FROM users')->fetchColumn() === 0) {
            $this->seedUsersAndSettings();
        }

        $this->ensureDemoStudentPortalSample();

        if ((int) $this->pdo->query('SELECT COUNT(*) FROM designations')->fetchColumn() === 0) {
            $this->seedDesignations();
        }

        if ((int) $this->pdo->query('SELECT COUNT(*) FROM office_transactions')->fetchColumn() === 0) {
            $this->seedOfficeTransactions();
        }
    }

    private function ensureAdmissionColumns(): void
    {
        $columns = array_column($this->pdo->query('PRAGMA table_info(admissions)')->fetchAll(), 'name');
        $definitions = [
            'academic_year' => "TEXT NOT NULL DEFAULT ''",
            'school_term' => "TEXT NOT NULL DEFAULT ''",
            'registration_no' => "TEXT NOT NULL DEFAULT ''",
            'admission_date' => "TEXT NOT NULL DEFAULT ''",
            'section' => "TEXT NOT NULL DEFAULT ''",
            'first_name' => "TEXT NOT NULL DEFAULT ''",
            'middle_name' => "TEXT NOT NULL DEFAULT ''",
            'last_name' => "TEXT NOT NULL DEFAULT ''",
            'date_of_birth' => "TEXT NOT NULL DEFAULT ''",
            'gender' => "TEXT NOT NULL DEFAULT ''",
            'religion' => "TEXT NOT NULL DEFAULT ''",
            'address' => "TEXT NOT NULL DEFAULT ''",
            'email' => "TEXT NOT NULL DEFAULT ''",
            'city' => "TEXT NOT NULL DEFAULT ''",
            'state' => "TEXT NOT NULL DEFAULT ''",
            'profile_picture' => "TEXT NOT NULL DEFAULT ''",
            'username' => "TEXT NOT NULL DEFAULT ''",
            'password' => "TEXT NOT NULL DEFAULT ''",
            'parent_username' => "TEXT NOT NULL DEFAULT ''",
            'parent_password' => "TEXT NOT NULL DEFAULT ''",
            'mother_tongue' => "TEXT NOT NULL DEFAULT ''",
            'guardian_full_name' => "TEXT NOT NULL DEFAULT ''",
            'guardian_relationship' => "TEXT NOT NULL DEFAULT ''",
            'father_name' => "TEXT NOT NULL DEFAULT ''",
            'mother_name' => "TEXT NOT NULL DEFAULT ''",
            'guardian_occupation' => "TEXT NOT NULL DEFAULT ''",
            'guardian_address' => "TEXT NOT NULL DEFAULT ''",
            'guardian_city' => "TEXT NOT NULL DEFAULT ''",
            'guardian_state' => "TEXT NOT NULL DEFAULT ''",
            'guardian_mobile' => "TEXT NOT NULL DEFAULT ''",
            'guardian_picture' => "TEXT NOT NULL DEFAULT ''",
        ];

        foreach ($definitions as $column => $definition) {
            if (!in_array($column, $columns, true)) {
                $this->pdo->exec("ALTER TABLE admissions ADD COLUMN {$column} {$definition}");
            }
        }
    }

    private function ensureFeeColumns(): void
    {
        $columns = array_column($this->pdo->query('PRAGMA table_info(fees)')->fetchAll(), 'name');
        $definitions = [
            'class_name' => "TEXT NOT NULL DEFAULT ''",
            'school_term' => "TEXT NOT NULL DEFAULT ''",
            'school_session' => "TEXT NOT NULL DEFAULT ''",
        ];

        foreach ($definitions as $column => $definition) {
            if (!in_array($column, $columns, true)) {
                $this->pdo->exec("ALTER TABLE fees ADD COLUMN {$column} {$definition}");
            }
        }
    }

    private function ensureStaffColumns(): void
    {
        $columns = array_column($this->pdo->query('PRAGMA table_info(staff)')->fetchAll(), 'name');
        $definitions = [
            'staff_photo' => "TEXT NOT NULL DEFAULT ''",
            'joining_date' => "TEXT NOT NULL DEFAULT ''",
            'designation' => "TEXT NOT NULL DEFAULT ''",
            'qualification' => "TEXT NOT NULL DEFAULT ''",
            'experience_details' => "TEXT NOT NULL DEFAULT ''",
            'middle_name' => "TEXT NOT NULL DEFAULT ''",
            'surname' => "TEXT NOT NULL DEFAULT ''",
            'gender' => "TEXT NOT NULL DEFAULT ''",
            'religion' => "TEXT NOT NULL DEFAULT ''",
            'date_of_birth' => "TEXT NOT NULL DEFAULT ''",
            'mobile_no' => "TEXT NOT NULL DEFAULT ''",
            'address' => "TEXT NOT NULL DEFAULT ''",
            'email' => "TEXT NOT NULL DEFAULT ''",
            'username' => "TEXT NOT NULL DEFAULT ''",
            'password' => "TEXT NOT NULL DEFAULT ''",
            'bank_name' => "TEXT NOT NULL DEFAULT ''",
            'account_name' => "TEXT NOT NULL DEFAULT ''",
            'account_number' => "TEXT NOT NULL DEFAULT ''",
        ];

        foreach ($definitions as $column => $definition) {
            if (!in_array($column, $columns, true)) {
