    private function ensureDemoStudentPortalSample(): void
    {
        $now = date('Y-m-d');
        $password = password_hash('password', PASSWORD_DEFAULT);
        $existing = $this->pdo->prepare('SELECT id FROM admissions WHERE username = ? LIMIT 1');
        $existing->execute(['student_sample@school.test']);
        $studentId = (int) ($existing->fetchColumn() ?: 0);

        if ($studentId === 0) {
            $statement = $this->pdo->prepare(
                'INSERT INTO admissions (academic_year, school_term, registration_no, admission_date, applicant, class_name, section, first_name, middle_name, last_name, date_of_birth, gender, religion, address, email, city, state, profile_picture, username, password, parent_username, parent_password, mother_tongue, guardian, guardian_full_name, guardian_relationship, father_name, mother_name, guardian_occupation, guardian_address, guardian_city, guardian_state, guardian_mobile, guardian_picture, stage, created_at)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)'
            );
            $statement->execute([
                '2026-2027', 'First Term', 'ADM-2026-PORTAL', $now, 'Test Portal Student', 'Primary 5', 'A',
                'Test', 'Portal', 'Student', '2015-04-12', 'Female', 'Christianity', '15 Learning Avenue, Lagos',
                'student_sample@school.test', 'Lagos', 'Lagos', '', 'student_sample@school.test', $password,
                'parent_sample@school.test', $password, 'English', 'Mr. Portal Parent', 'Mr. Portal Parent',
                'Father', 'Mr. Portal Parent', 'Mrs. Portal Parent', 'Engineer', '15 Learning Avenue, Lagos',
                'Lagos', 'Lagos', '+2348001112222', '', 'Accepted', $now,
            ]);
            $studentId = (int) $this->pdo->lastInsertId();
        }

        $userExists = $this->pdo->prepare('SELECT COUNT(*) FROM users WHERE email = ?');
        $user = $this->pdo->prepare('INSERT INTO users (name, email, password, role, status, created_at) VALUES (?, ?, ?, ?, ?, ?)');
        $userExists->execute(['student_sample@school.test']);
        if ((int) $userExists->fetchColumn() === 0) {
            $user->execute(['Test Portal Student', 'student_sample@school.test', $password, 'student', 'Active', $now]);
        }
        $userExists->execute(['parent_sample@school.test']);
        if ((int) $userExists->fetchColumn() === 0) {
            $user->execute(['Test Portal Parent', 'parent_sample@school.test', $password, 'parent', 'Active', $now]);
        }

        $teacherId = (int) ($this->pdo->query("SELECT id FROM staff WHERE employee_no = 'EMP-PORTAL-T01' LIMIT 1")->fetchColumn() ?: 0);
        if ($teacherId === 0) {
            $staff = $this->pdo->prepare('INSERT INTO staff (employee_no, name, role, department, status, designation, email, mobile_no) VALUES (?, ?, ?, ?, ?, ?, ?, ?)');
            $staff->execute(['EMP-PORTAL-T01', 'Mrs. Grace Teacher', 'Teacher', 'Academics', 'Active', 'Class Teacher', 'grace.teacher@school.test', '+2348003334444']);
            $teacherId = (int) $this->pdo->lastInsertId();
        }

        $this->pdo->prepare('UPDATE staff SET email = ?, username = CASE WHEN username = "" THEN ? ELSE username END WHERE id = ?')
            ->execute(['teacher@school.test', 'teacher@school.test', $teacherId]);

        $subjectId = (int) ($this->pdo->query("SELECT id FROM subjects WHERE subject_code = 'MTH-P5' LIMIT 1")->fetchColumn() ?: 0);
        if ($subjectId === 0) {
            $subject = $this->pdo->prepare('INSERT INTO subjects (subject_name, subject_type, subject_code, created_at) VALUES (?, ?, ?, ?)');
            $subject->execute(['Mathematics', 'Theory', 'MTH-P5', $now]);
            $subjectId = (int) $this->pdo->lastInsertId();
        }

        $classId = (int) ($this->pdo->query("SELECT id FROM classes WHERE name = 'Primary 5' LIMIT 1")->fetchColumn() ?: 0);
        if ($classId === 0) {
            $class = $this->pdo->prepare('INSERT INTO classes (name, teacher, room, capacity) VALUES (?, ?, ?, ?)');
            $class->execute(['Primary 5', 'Mrs. Grace Teacher', 'Block B-104', 30]);
            $classId = (int) $this->pdo->lastInsertId();
        }

        if ((int) $this->pdo->query("SELECT COUNT(*) FROM class_assignments WHERE class_name = 'Primary 5' AND section = 'A'")->fetchColumn() === 0) {
            $this->pdo->prepare('INSERT INTO class_assignments (class_name, section, teacher_id, number_of_students, created_at) VALUES (?, ?, ?, ?, ?)')->execute(['Primary 5', 'A', $teacherId, 1, $now]);
        }
        if ((int) $this->pdo->query("SELECT COUNT(*) FROM subject_assignments WHERE class_name = 'Primary 5' AND section = 'A' AND subject_id = {$subjectId}")->fetchColumn() === 0) {
            $this->pdo->prepare('INSERT INTO subject_assignments (class_name, section, subject_id, created_at) VALUES (?, ?, ?, ?)')->execute(['Primary 5', 'A', $subjectId, $now]);
        }
        if ((int) $this->pdo->query("SELECT COUNT(*) FROM timetables WHERE class_name = 'Primary 5' AND section = 'A'")->fetchColumn() === 0) {
            $this->pdo->prepare('INSERT INTO timetables (class_name, section, subject_id, teacher_id, day_of_week, start_time, end_time, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)')->execute(['Primary 5', 'A', $subjectId, $teacherId, 'Monday', '08:00', '09:00', $now]);
        }
        if ((int) $this->pdo->query("SELECT COUNT(*) FROM teacher_assignments WHERE teacher_id = {$teacherId} AND class_id = {$classId} AND subject_id = {$subjectId} AND section_id IS NULL")->fetchColumn() === 0) {
            $assignedBy = (int) ($this->pdo->query("SELECT id FROM users WHERE role = 'superadmin' LIMIT 1")->fetchColumn() ?: 0);
            $assignment = $this->pdo->prepare('INSERT INTO teacher_assignments (teacher_id, class_id, subject_id, section_id, is_class_teacher, status, assigned_by, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)');
            $assignment->execute([$teacherId, $classId, $subjectId, null, 1, 'active', $assignedBy ?: null, $now]);
        }
        if ((int) $this->pdo->query("SELECT COUNT(*) FROM fees WHERE invoice_no = 'INV-PORTAL-001'")->fetchColumn() === 0) {
            $this->pdo->prepare('INSERT INTO fees (invoice_no, student_name, class_name, school_term, school_session, amount, status, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)')->execute(['INV-PORTAL-001', 'Test Portal Student', 'Primary 5', 'First Term', '2026-2027', 120000, 'Partial', $now]);
        }
        if ((int) $this->pdo->query("SELECT COUNT(*) FROM student_attendance WHERE student_id = {$studentId}")->fetchColumn() === 0) {
            $attendance = $this->pdo->prepare('INSERT INTO student_attendance (student_id, class_name, section, attendance_date, status, remark, created_at) VALUES (?, ?, ?, ?, ?, ?, ?)');
            $attendance->execute([$studentId, 'Primary 5', 'A', date('Y-m-03'), 'Present', 'On time', $now]);
            $attendance->execute([$studentId, 'Primary 5', 'A', date('Y-m-04'), 'Late', 'Arrived after assembly', $now]);
        }
        if ((int) $this->pdo->query("SELECT COUNT(*) FROM homework_assignments WHERE class_name = 'Primary 5' AND section = 'A'")->fetchColumn() === 0) {
            $this->pdo->prepare('INSERT INTO homework_assignments (class_name, section, subject, title, description, due_date, created_at) VALUES (?, ?, ?, ?, ?, ?, ?)')->execute(['Primary 5', 'A', 'Mathematics', 'Fractions Practice', 'Solve exercises 1 to 10 on equivalent fractions.', date('Y-m-d', strtotime('+7 days')), $now]);
        }
        if ((int) $this->pdo->query("SELECT COUNT(*) FROM communication_messages WHERE recipient_name = 'Test Portal Student'")->fetchColumn() === 0) {
            $this->pdo->prepare('INSERT INTO communication_messages (message_type, channel, audience, recipient_role, recipient_name, subject, message, status, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)')->execute(['Internal', 'Internal', 'Students', 'student', 'Test Portal Student', 'Welcome to the Student Portal', 'Your portal modules are ready for testing.', 'Queued', $now]);
        }
    }

    private function ensureUiThemeSettings(): void
    {
        $settings = [
            'ui_theme_preset' => 'gmail_material',
            'ui_app_background' => '#FFFFFF',
            'ui_sidebar_background' => '#F2F6FC',
            'ui_primary_button_background' => '#C2E7FF',
            'ui_primary_button_text' => '#001D35',
            'ui_active_sidebar_background' => '#C2E7FF',
            'ui_active_sidebar_text' => '#0B57D0',
            'ui_inactive_sidebar_text' => '#444746',
            'ui_topbar_background' => '#FFFFFF',
            'ui_banner_background' => '#EAF1FB',
            'ui_card_background' => '#FFFFFF',
        ];
        $statement = $this->pdo->prepare('INSERT OR IGNORE INTO settings (setting_key, setting_value) VALUES (?, ?)');

        foreach ($settings as $key => $value) {
            $statement->execute([$key, $value]);
        }
    }
}
