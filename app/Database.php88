    }

    private function seedDesignations(): void
    {
        $now = date('Y-m-d');
        $statement = $this->pdo->prepare('INSERT INTO designations (name, created_at) VALUES (?, ?)');

        foreach (['Principal', 'Admin', 'Teacher', 'Asst Teacher', 'Accountant', 'Receptionist', 'Librarian'] as $name) {
            $statement->execute([$name, $now]);
        }
    }

    private function seedOfficeTransactions(): void
    {
        $now = date('Y-m-d');
        $statement = $this->pdo->prepare(
            'INSERT INTO office_transactions (type, account_name, category, title, amount, payment_method, reference_no, transaction_date, note, created_at)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)'
        );

        foreach ([
            ['Income', 'Main Account', 'Donation', 'PTA facility support', 85000, 'Bank Transfer', 'OFF-INC-001', 'General office income'],
            ['Income', 'Main Account', 'Uniform Sales', 'Uniform and exercise book sales', 72000, 'Cash', 'OFF-INC-002', 'Sales through front office'],
            ['Expenditure', 'Main Account', 'Utilities', 'Electricity bill payment', 45000, 'Bank Transfer', 'OFF-EXP-001', 'Monthly utility bill'],
            ['Expenditure', 'Main Account', 'Maintenance', 'Classroom furniture repairs', 30000, 'Cash', 'OFF-EXP-002', 'Repair of desks and chairs'],
        ] as $row) {
            $statement->execute([$row[0], $row[1], $row[2], $row[3], $row[4], $row[5], $row[6], $now, $row[7], $now]);
        }
    }

