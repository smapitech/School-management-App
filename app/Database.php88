        foreach ([['A', 70, 100, 'Excellent'], ['B', 60, 69, 'Very Good'], ['C', 50, 59, 'Good'], ['D', 40, 49, 'Pass'], ['F', 0, 39, 'Needs Improvement']] as $row) {
            $statement->execute([$row[0], $row[1], $row[2], $row[3], $now]);
        }
    }

