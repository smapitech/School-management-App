    private function ensureDesignationTable(): void
    {
        $this->pdo->exec(<<<SQL
            CREATE TABLE IF NOT EXISTS designations (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name TEXT NOT NULL UNIQUE,
                created_at TEXT NOT NULL
            );
        SQL);
    }

    private function ensurePayrollTables(): void
    {
        $this->pdo->exec(<<<SQL
            CREATE TABLE IF NOT EXISTS salary_templates (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                staff_id INTEGER NOT NULL,
                basic_salary REAL NOT NULL DEFAULT 0,
                overtime REAL NOT NULL DEFAULT 0,
                bonus REAL NOT NULL DEFAULT 0,
                allowance_name TEXT NOT NULL DEFAULT '',
                allowance_amount REAL NOT NULL DEFAULT 0,
                total_allowance REAL NOT NULL DEFAULT 0,
                total_deduction REAL NOT NULL DEFAULT 0,
                gross_pay REAL NOT NULL DEFAULT 0,
                net_salary REAL NOT NULL DEFAULT 0,
                created_at TEXT NOT NULL
            );

            CREATE TABLE IF NOT EXISTS salary_assignments (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                staff_id INTEGER NOT NULL,
                template_id INTEGER NOT NULL,
                assigned_date TEXT NOT NULL,
                note TEXT NOT NULL DEFAULT ''
            );

            CREATE TABLE IF NOT EXISTS salary_payments (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                staff_id INTEGER NOT NULL,
                template_id INTEGER NOT NULL,
                payment_month TEXT NOT NULL,
                net_payment REAL NOT NULL DEFAULT 0,
                status TEXT NOT NULL DEFAULT 'Pending',
                paid_at TEXT NOT NULL DEFAULT '',
                created_at TEXT NOT NULL
            );
        SQL);
    }

    private function ensureAttendanceTables(): void
    {
        $this->pdo->exec(<<<SQL
            CREATE TABLE IF NOT EXISTS student_attendance (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                student_id INTEGER NOT NULL,
                class_name TEXT NOT NULL,
                section TEXT NOT NULL,
                attendance_date TEXT NOT NULL,
                status TEXT NOT NULL DEFAULT 'Present',
                remark TEXT NOT NULL DEFAULT '',
                created_at TEXT NOT NULL,
                UNIQUE(student_id, attendance_date)
            );

            CREATE TABLE IF NOT EXISTS staff_attendance (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                staff_id INTEGER NOT NULL,
                role TEXT NOT NULL,
                attendance_date TEXT NOT NULL,
                clock_in TEXT DEFAULT NULL,
                clock_out TEXT DEFAULT NULL,
                status TEXT NOT NULL DEFAULT 'Present',
                remark TEXT NOT NULL DEFAULT '',
                note TEXT DEFAULT NULL,
                marked_by INTEGER DEFAULT NULL,
                created_at TEXT NOT NULL,
                updated_at TEXT DEFAULT NULL,
                UNIQUE(staff_id, attendance_date)
            );
        SQL);

        $staffAttendanceColumns = array_column($this->pdo->query('PRAGMA table_info(staff_attendance)')->fetchAll(), 'name');
        foreach ([
            'clock_in' => 'TEXT DEFAULT NULL',
            'clock_out' => 'TEXT DEFAULT NULL',
            'note' => 'TEXT DEFAULT NULL',
            'marked_by' => 'INTEGER DEFAULT NULL',
            'updated_at' => 'TEXT DEFAULT NULL',
        ] as $column => $definition) {
            if (!in_array($column, $staffAttendanceColumns, true)) {
                $this->pdo->exec("ALTER TABLE staff_attendance ADD COLUMN {$column} {$definition}");
            }
        }
    }

    private function ensureCommunicationTables(): void
    {
        $this->pdo->exec(<<<SQL
            CREATE TABLE IF NOT EXISTS communication_messages (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                message_type TEXT NOT NULL DEFAULT 'Internal',
                channel TEXT NOT NULL DEFAULT 'Internal',
                audience TEXT NOT NULL DEFAULT '',
                recipient_role TEXT NOT NULL DEFAULT '',
                recipient_name TEXT NOT NULL DEFAULT '',
                recipient_contact TEXT NOT NULL DEFAULT '',
                subject TEXT NOT NULL DEFAULT '',
                message TEXT NOT NULL,
                attachment_path TEXT NOT NULL DEFAULT '',
                attachment_name TEXT NOT NULL DEFAULT '',
                related_id INTEGER NOT NULL DEFAULT 0,
                status TEXT NOT NULL DEFAULT 'Queued',
                created_at TEXT NOT NULL
            );

            CREATE TABLE IF NOT EXISTS teacher_conversations (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                conversation_type TEXT NOT NULL,
                teacher_id INTEGER NOT NULL,
                parent_id INTEGER DEFAULT NULL,
                other_teacher_id INTEGER DEFAULT NULL,
                student_id INTEGER DEFAULT NULL,
                subject TEXT DEFAULT NULL,
                status TEXT NOT NULL DEFAULT 'open',
                last_message_at TEXT DEFAULT NULL,
                created_at TEXT NOT NULL,
                updated_at TEXT DEFAULT NULL
            );

            CREATE TABLE IF NOT EXISTS teacher_conversation_messages (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                conversation_id INTEGER NOT NULL,
                sender_id INTEGER NOT NULL,
                sender_role TEXT NOT NULL,
                message TEXT NOT NULL,
                attachment_path TEXT DEFAULT NULL,
                attachment_name TEXT NOT NULL DEFAULT '',
                is_read INTEGER NOT NULL DEFAULT 0,
                read_at TEXT DEFAULT NULL,
                created_at TEXT NOT NULL
            );
        SQL);

        $columns = array_column($this->pdo->query('PRAGMA table_info(communication_messages)')->fetchAll(), 'name');
        foreach (['attachment_path' => "TEXT NOT NULL DEFAULT ''", 'attachment_name' => "TEXT NOT NULL DEFAULT ''"] as $column => $definition) {
            if (!in_array($column, $columns, true)) {
                $this->pdo->exec("ALTER TABLE communication_messages ADD COLUMN {$column} {$definition}");
            }
        }

        $conversationMessageColumns = array_column($this->pdo->query('PRAGMA table_info(teacher_conversation_messages)')->fetchAll(), 'name');
        foreach ([
            'attachment_path' => 'TEXT DEFAULT NULL',
            'attachment_name' => "TEXT NOT NULL DEFAULT ''",
            'is_read' => 'INTEGER NOT NULL DEFAULT 0',
            'read_at' => 'TEXT DEFAULT NULL',
        ] as $column => $definition) {
            if (!in_array($column, $conversationMessageColumns, true)) {
                $this->pdo->exec("ALTER TABLE teacher_conversation_messages ADD COLUMN {$column} {$definition}");
            }
        }
    }

    private function ensureNotificationTables(): void
    {
        $this->pdo->exec(<<<SQL
            CREATE TABLE IF NOT EXISTS notifications (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                user_id INTEGER DEFAULT NULL,
                role TEXT DEFAULT NULL,
                title TEXT NOT NULL,
                message TEXT NOT NULL,
                type TEXT NOT NULL DEFAULT 'general',
                priority TEXT NOT NULL DEFAULT 'normal',
                link TEXT DEFAULT NULL,
                icon TEXT DEFAULT NULL,
                is_read INTEGER NOT NULL DEFAULT 0,
                read_at TEXT DEFAULT NULL,
                expires_at TEXT DEFAULT NULL,
                created_by INTEGER DEFAULT NULL,
                created_at TEXT NOT NULL,
                updated_at TEXT DEFAULT NULL
            );

            CREATE TABLE IF NOT EXISTS notification_user_states (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                notification_id INTEGER NOT NULL,
                user_id INTEGER NOT NULL,
                role TEXT NOT NULL DEFAULT '',
                is_read INTEGER NOT NULL DEFAULT 0,
                is_deleted INTEGER NOT NULL DEFAULT 0,
                read_at TEXT DEFAULT NULL,
                deleted_at TEXT DEFAULT NULL,
                UNIQUE(notification_id, user_id, role)
            );

            CREATE INDEX IF NOT EXISTS idx_notifications_user_id ON notifications(user_id);
            CREATE INDEX IF NOT EXISTS idx_notifications_role ON notifications(role);
            CREATE INDEX IF NOT EXISTS idx_notifications_is_read ON notifications(is_read);
            CREATE INDEX IF NOT EXISTS idx_notifications_type ON notifications(type);
            CREATE INDEX IF NOT EXISTS idx_notifications_created_at ON notifications(created_at);
        SQL);

        if ((int) $this->pdo->query("SELECT COUNT(*) FROM notifications WHERE title = 'Welcome to Notifications'")->fetchColumn() === 0) {
            $statement = $this->pdo->prepare('INSERT INTO notifications (role, title, message, type, priority, link, icon, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)');
            $statement->execute([
                'admin',
                'Welcome to Notifications',
                'You will receive school updates, homework alerts, attendance notices, and important announcements here.',
                'system',
                'normal',
                '/notifications',
                'bell',
                date('Y-m-d H:i:s'),
            ]);
        }
    }

    private function ensureStudentPortalTables(): void
    {
        $this->pdo->exec(<<<SQL
            CREATE TABLE IF NOT EXISTS homework_assignments (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                class_name TEXT NOT NULL,
                section TEXT NOT NULL DEFAULT '',
                subject TEXT NOT NULL DEFAULT '',
                title TEXT NOT NULL,
                description TEXT NOT NULL DEFAULT '',
                due_date TEXT NOT NULL DEFAULT '',
                created_at TEXT NOT NULL
            );

            CREATE TABLE IF NOT EXISTS homework_submissions (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                assignment_id INTEGER NOT NULL,
                student_id INTEGER NOT NULL,
                submission_text TEXT NOT NULL DEFAULT '',
                attachment_path TEXT NOT NULL DEFAULT '',
                attachment_name TEXT NOT NULL DEFAULT '',
                status TEXT NOT NULL DEFAULT 'Submitted',
                submitted_at TEXT NOT NULL
            );

            CREATE TABLE IF NOT EXISTS homework_submission_logs (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                homework_submission_id INTEGER NOT NULL,
                user_id INTEGER NOT NULL DEFAULT 0,
                action TEXT NOT NULL,
                note TEXT NOT NULL DEFAULT '',
                created_at TEXT NOT NULL
            );

            CREATE TABLE IF NOT EXISTS homework_notifications (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                recipient_role TEXT NOT NULL DEFAULT '',
                recipient_user_id INTEGER NOT NULL DEFAULT 0,
                title TEXT NOT NULL,
                message TEXT NOT NULL,
                homework_id INTEGER NOT NULL DEFAULT 0,
                read_at TEXT NOT NULL DEFAULT '',
                created_at TEXT NOT NULL
            );
        SQL);

        $assignmentColumns = array_column($this->pdo->query('PRAGMA table_info(homework_assignments)')->fetchAll(), 'name');
        $assignmentDefinitions = [
            'teacher_id' => 'INTEGER NOT NULL DEFAULT 0',
            'subject_id' => 'INTEGER NOT NULL DEFAULT 0',
            'topic' => "TEXT NOT NULL DEFAULT ''",
            'due_at' => "TEXT NOT NULL DEFAULT ''",
            'total_marks' => 'REAL NOT NULL DEFAULT 100',
            'submission_type' => "TEXT NOT NULL DEFAULT 'both'",
            'attachment_path' => "TEXT NOT NULL DEFAULT ''",
            'attachment_name' => "TEXT NOT NULL DEFAULT ''",
            'resource_link' => "TEXT NOT NULL DEFAULT ''",
            'allow_late_submission' => 'INTEGER NOT NULL DEFAULT 0',
            'status' => "TEXT NOT NULL DEFAULT 'published'",
            'created_by' => 'INTEGER NOT NULL DEFAULT 0',
            'updated_by' => 'INTEGER NOT NULL DEFAULT 0',
            'deleted_at' => "TEXT NOT NULL DEFAULT ''",
        ];

        foreach ($assignmentDefinitions as $column => $definition) {
            if (!in_array($column, $assignmentColumns, true)) {
                $this->pdo->exec("ALTER TABLE homework_assignments ADD COLUMN {$column} {$definition}");
            }
        }

        $submissionColumns = array_column($this->pdo->query('PRAGMA table_info(homework_submissions)')->fetchAll(), 'name');
        $submissionDefinitions = [
            'submission_link' => "TEXT NOT NULL DEFAULT ''",
            'is_late' => 'INTEGER NOT NULL DEFAULT 0',
            'score' => 'REAL DEFAULT NULL',
            'feedback' => "TEXT NOT NULL DEFAULT ''",
            'correction_file_path' => "TEXT NOT NULL DEFAULT ''",
            'correction_file_name' => "TEXT NOT NULL DEFAULT ''",
            'private_note' => "TEXT NOT NULL DEFAULT ''",
            'marked_by' => 'INTEGER NOT NULL DEFAULT 0',
            'marked_at' => "TEXT NOT NULL DEFAULT ''",
            'deleted_at' => "TEXT NOT NULL DEFAULT ''",
        ];

        foreach ($submissionDefinitions as $column => $definition) {
            if (!in_array($column, $submissionColumns, true)) {
                $this->pdo->exec("ALTER TABLE homework_submissions ADD COLUMN {$column} {$definition}");
            }
        }

        if ((int) $this->pdo->query('SELECT COUNT(*) FROM homework_assignments')->fetchColumn() === 0) {
            $statement = $this->pdo->prepare("INSERT INTO homework_assignments (class_name, section, subject, title, description, due_date, due_at, created_at, status, submission_type, total_marks) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)");
            $statement->execute(['Nursery 1', 'A', 'English', 'Reading Practice', 'Read one short story and write five new words you learned.', date('Y-m-d', strtotime('+7 days')), date('Y-m-d 16:00:00', strtotime('+7 days')), date('Y-m-d'), 'published', 'both', 20]);
            $statement->execute(['KG 1', 'B', 'Mathematics', 'Number Practice', 'Complete counting numbers 1 to 50 in your notebook.', date('Y-m-d', strtotime('+5 days')), date('Y-m-d 16:00:00', strtotime('+5 days')), date('Y-m-d'), 'published', 'text', 10]);
        }
    }

    private function ensureClassModuleTables(): void
    {
        $this->pdo->exec(<<<SQL
            CREATE TABLE IF NOT EXISTS class_assignments (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                class_name TEXT NOT NULL,
                section TEXT NOT NULL,
                teacher_id INTEGER NOT NULL,
                number_of_students INTEGER NOT NULL DEFAULT 0,
                created_at TEXT NOT NULL
            );

            CREATE TABLE IF NOT EXISTS subjects (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                subject_name TEXT NOT NULL,
                subject_type TEXT NOT NULL,
                subject_code TEXT NOT NULL UNIQUE,
                created_at TEXT NOT NULL
            );

            CREATE TABLE IF NOT EXISTS subject_assignments (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                class_name TEXT NOT NULL,
                section TEXT NOT NULL,
                subject_id INTEGER NOT NULL,
                created_at TEXT NOT NULL
            );

            CREATE TABLE IF NOT EXISTS timetables (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                class_name TEXT NOT NULL,
                section TEXT NOT NULL,
                subject_id INTEGER NOT NULL,
                teacher_id INTEGER NOT NULL,
                day_of_week TEXT NOT NULL,
                start_time TEXT NOT NULL,
                end_time TEXT NOT NULL,
                room TEXT NOT NULL DEFAULT '',
                note TEXT NOT NULL DEFAULT '',
                created_by INTEGER DEFAULT NULL,
                created_at TEXT NOT NULL,
                updated_at TEXT DEFAULT NULL
            );

            CREATE TABLE IF NOT EXISTS teacher_assignments (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                teacher_id INTEGER NOT NULL,
                class_id INTEGER NOT NULL,
                subject_id INTEGER DEFAULT NULL,
                section_id INTEGER DEFAULT NULL,
                is_class_teacher INTEGER NOT NULL DEFAULT 0,
                status TEXT NOT NULL DEFAULT 'active',
                assigned_by INTEGER DEFAULT NULL,
                created_at TEXT NOT NULL,
                updated_at TEXT DEFAULT NULL
            );

            CREATE UNIQUE INDEX IF NOT EXISTS unique_teacher_class_subject
                ON teacher_assignments (teacher_id, class_id, subject_id, section_id);
            CREATE INDEX IF NOT EXISTS idx_teacher_assignments_teacher_id ON teacher_assignments (teacher_id);
            CREATE INDEX IF NOT EXISTS idx_teacher_assignments_class_id ON teacher_assignments (class_id);
            CREATE INDEX IF NOT EXISTS idx_teacher_assignments_subject_id ON teacher_assignments (subject_id);
            CREATE INDEX IF NOT EXISTS idx_teacher_assignments_section_id ON teacher_assignments (section_id);
        SQL);

        $timetableColumns = array_column($this->pdo->query('PRAGMA table_info(timetables)')->fetchAll(), 'name');
        $timetableDefinitions = [
            'room' => "TEXT NOT NULL DEFAULT ''",
            'note' => "TEXT NOT NULL DEFAULT ''",
            'created_by' => 'INTEGER DEFAULT NULL',
            'updated_at' => 'TEXT DEFAULT NULL',
        ];

        foreach ($timetableDefinitions as $column => $definition) {
            if (!in_array($column, $timetableColumns, true)) {
                $this->pdo->exec("ALTER TABLE timetables ADD COLUMN {$column} {$definition}");
            }
        }
    }

    private function ensureApiTables(): void
    {
        $this->pdo->exec(<<<SQL
            CREATE TABLE IF NOT EXISTS api_tokens (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                user_id INTEGER NOT NULL,
                role TEXT NOT NULL,
                token_hash TEXT NOT NULL,
                device_name TEXT DEFAULT NULL,
                device_type TEXT DEFAULT NULL,
                last_used_at TEXT DEFAULT NULL,
                expires_at TEXT DEFAULT NULL,
                revoked_at TEXT DEFAULT NULL,
                created_at TEXT NOT NULL
            );
            CREATE INDEX IF NOT EXISTS idx_api_tokens_user_role ON api_tokens (user_id, role);
            CREATE INDEX IF NOT EXISTS idx_api_tokens_hash ON api_tokens (token_hash);
            CREATE INDEX IF NOT EXISTS idx_api_tokens_expires ON api_tokens (expires_at);
        SQL);
    }

    private function ensureWebsiteTables(): void
    {
        $this->pdo->exec(<<<SQL
            CREATE TABLE IF NOT EXISTS website_settings (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                active_template TEXT NOT NULL DEFAULT 'classic',
                site_title TEXT DEFAULT NULL,
                meta_description TEXT DEFAULT NULL,
                meta_keywords TEXT DEFAULT NULL,
                og_title TEXT DEFAULT NULL,
                og_description TEXT DEFAULT NULL,
                og_image TEXT DEFAULT NULL,
                school_logo TEXT DEFAULT NULL,
                favicon TEXT DEFAULT NULL,
                footer_text TEXT DEFAULT NULL,
                show_teacher_phone INTEGER NOT NULL DEFAULT 0,
                show_teacher_email INTEGER NOT NULL DEFAULT 1,
                created_at TEXT NOT NULL,
                updated_at TEXT DEFAULT NULL
            );

            CREATE TABLE IF NOT EXISTS website_sections (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                section_key TEXT NOT NULL UNIQUE,
                section_value TEXT DEFAULT NULL,
                section_type TEXT NOT NULL DEFAULT 'text',
                is_enabled INTEGER NOT NULL DEFAULT 1,
                updated_at TEXT DEFAULT NULL
            );

            CREATE TABLE IF NOT EXISTS website_gallery (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                image_path TEXT NOT NULL,
                title TEXT DEFAULT NULL,
                description TEXT DEFAULT NULL,
                category TEXT DEFAULT NULL,
                is_featured INTEGER NOT NULL DEFAULT 0,
                is_published INTEGER NOT NULL DEFAULT 1,
                sort_order INTEGER NOT NULL DEFAULT 0,
                created_by INTEGER DEFAULT NULL,
                created_at TEXT NOT NULL,
                updated_at TEXT DEFAULT NULL
            );

            CREATE TABLE IF NOT EXISTS website_teachers (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                photo_path TEXT DEFAULT NULL,
                full_name TEXT NOT NULL,
                role_title TEXT DEFAULT NULL,
                subject TEXT DEFAULT NULL,
                phone TEXT DEFAULT NULL,
                email TEXT DEFAULT NULL,
                biography TEXT DEFAULT NULL,
                social_link TEXT DEFAULT NULL,
                is_featured INTEGER NOT NULL DEFAULT 0,
                is_published INTEGER NOT NULL DEFAULT 1,
                sort_order INTEGER NOT NULL DEFAULT 0,
                created_by INTEGER DEFAULT NULL,
                created_at TEXT NOT NULL,
                updated_at TEXT DEFAULT NULL
            );

            CREATE TABLE IF NOT EXISTS website_contact_messages (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                full_name TEXT NOT NULL,
                email TEXT NOT NULL,
                phone TEXT DEFAULT NULL,
                subject TEXT DEFAULT NULL,
                message TEXT NOT NULL,
                is_read INTEGER NOT NULL DEFAULT 0,
                created_at TEXT NOT NULL
            );

            CREATE TABLE IF NOT EXISTS website_reviews (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                parent_name TEXT NOT NULL,
                parent_title TEXT DEFAULT NULL,
                review_text TEXT NOT NULL,
                parent_image TEXT DEFAULT NULL,
                rating INTEGER NOT NULL DEFAULT 5,
                is_featured INTEGER NOT NULL DEFAULT 0,
                is_published INTEGER NOT NULL DEFAULT 1,
                sort_order INTEGER NOT NULL DEFAULT 0,
                created_by INTEGER DEFAULT NULL,
                created_at TEXT NOT NULL,
                updated_at TEXT DEFAULT NULL
            );
        SQL);

        if ((int) $this->pdo->query('SELECT COUNT(*) FROM website_settings')->fetchColumn() === 0) {
            $statement = $this->pdo->prepare('INSERT INTO website_settings (active_template, site_title, footer_text, created_at) VALUES (?, ?, ?, ?)');
            $statement->execute(['classic', 'Smapis School Portal', 'Building knowledge, character, and confidence.', date('Y-m-d H:i:s')]);
        }

        $defaults = [
            'hero_title' => 'Welcome to Our School',
            'hero_subtitle' => 'A modern learning environment where students grow in knowledge, character, and confidence.',
            'hero_button_text' => 'Apply for Admission',
            'hero_button_link' => '/admissions/create',
            'hero_image' => '',
            'about_title' => 'About Our School',
            'about_content' => 'Please update this section from the Website Manager.',
            'about_image' => '',
            'mission_title' => 'Our Mission',
            'mission_content' => 'To provide excellent learning experiences that prepare children for a purposeful future.',
            'vision_title' => 'Our Vision',
            'vision_content' => 'To become a trusted African school known for discipline, innovation, and academic excellence.',
            'why_choose_title' => 'Why Choose Us',
            'why_choose_points' => "Qualified teachers\nSafe learning environment\nBalanced academics and character formation",
            'programs_title' => 'Our Programs',
            'programs_content' => 'Nursery, kindergarten, and primary learning programs designed for steady growth.',
            'gallery_title' => 'Students Gallery',
            'teachers_title' => 'Our Teachers',
            'contact_title' => 'Contact Us',
            'contact_intro' => 'Please update the school contact information from the Website Manager.',
            'contact_address' => '',
            'contact_phone' => '',
            'contact_email' => '',
            'contact_whatsapp' => '',
            'opening_hours' => 'Monday - Friday, 8:00am - 4:00pm',
            'facebook_url' => '',
            'instagram_url' => '',
            'youtube_url' => '',
            'tiktok_url' => '',
            'linkedin_url' => '',
            'footer_text' => 'Building knowledge, character, and confidence.',
        ];
        $statement = $this->pdo->prepare('INSERT OR IGNORE INTO website_sections (section_key, section_value, section_type, is_enabled, updated_at) VALUES (?, ?, ?, ?, ?)');
        foreach ($defaults as $key => $value) {
            $statement->execute([$key, $value, str_contains($key, 'image') ? 'image' : 'text', 1, date('Y-m-d H:i:s')]);
        }
    }

    private function ensureAccountingTables(): void
    {
        $this->pdo->exec(<<<SQL
            CREATE TABLE IF NOT EXISTS office_transactions (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                type TEXT NOT NULL,
                account_name TEXT NOT NULL DEFAULT 'Main Account',
                category TEXT NOT NULL DEFAULT '',
                title TEXT NOT NULL,
                amount REAL NOT NULL DEFAULT 0,
                payment_method TEXT NOT NULL DEFAULT '',
                reference_no TEXT NOT NULL DEFAULT '',
                transaction_date TEXT NOT NULL,
                note TEXT NOT NULL DEFAULT '',
                created_at TEXT NOT NULL
            );
        SQL);
    }

    private function ensureFeeReminderTable(): void
    {
        $this->pdo->exec(<<<SQL
            CREATE TABLE IF NOT EXISTS fee_reminders (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                class_name TEXT NOT NULL,
                school_term TEXT NOT NULL DEFAULT '',
                school_session TEXT NOT NULL DEFAULT '',
                due_date TEXT NOT NULL DEFAULT '',
                audience TEXT NOT NULL DEFAULT 'Parents',
                message TEXT NOT NULL,
                communication_status TEXT NOT NULL DEFAULT 'Draft',
                created_at TEXT NOT NULL
            );
        SQL);
    }

    private function ensureExamTables(): void
    {
        $this->pdo->exec(<<<SQL
            CREATE TABLE IF NOT EXISTS exam_settings (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                class_name TEXT NOT NULL,
                section TEXT NOT NULL,
                school_term TEXT NOT NULL,
                school_session TEXT NOT NULL,
                subject_id INTEGER NOT NULL,
                exam_name TEXT NOT NULL DEFAULT 'Term Examination',
                created_by INTEGER NOT NULL DEFAULT 0,
                created_at TEXT NOT NULL
            );

            CREATE TABLE IF NOT EXISTS mark_distributions (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name TEXT NOT NULL,
                max_mark REAL NOT NULL DEFAULT 0,
                sort_order INTEGER NOT NULL DEFAULT 0,
                created_at TEXT NOT NULL
            );

            CREATE TABLE IF NOT EXISTS exam_grades (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                grade_name TEXT NOT NULL,
                min_mark REAL NOT NULL DEFAULT 0,
                max_mark REAL NOT NULL DEFAULT 0,
                remark TEXT NOT NULL DEFAULT '',
                created_at TEXT NOT NULL
            );

            CREATE TABLE IF NOT EXISTS exam_marks (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                exam_setting_id INTEGER NOT NULL,
                student_id INTEGER NOT NULL,
                distribution_id INTEGER NOT NULL,
                mark REAL NOT NULL DEFAULT 0,
                teacher_id INTEGER NOT NULL DEFAULT 0,
                created_at TEXT NOT NULL,
                UNIQUE(exam_setting_id, student_id, distribution_id)
            );

            CREATE TABLE IF NOT EXISTS exam_schedules (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                exam_setting_id INTEGER NOT NULL,
                exam_date TEXT NOT NULL,
                start_time TEXT NOT NULL,
                end_time TEXT NOT NULL,
                created_at TEXT NOT NULL
            );

            CREATE TABLE IF NOT EXISTS exam_comments (
                exam_setting_id INTEGER NOT NULL,
                student_id INTEGER NOT NULL,
                teacher_remark TEXT NOT NULL DEFAULT '',
                teacher_comment TEXT NOT NULL DEFAULT '',
                created_at TEXT NOT NULL,
                PRIMARY KEY (exam_setting_id, student_id)
            );
        SQL);

        if ((int) $this->pdo->query('SELECT COUNT(*) FROM mark_distributions')->fetchColumn() === 0) {
            $this->seedMarkDistributions();
        }

        if ((int) $this->pdo->query('SELECT COUNT(*) FROM exam_grades')->fetchColumn() === 0) {
            $this->seedExamGrades();
        }
    }

