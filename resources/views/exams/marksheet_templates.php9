                            <a href="/exams/marksheet-templates/preview?id=<?= e($templateRow['id']) ?>">View</a>
                            <?php if (can('exams', 'edit')): ?><a href="/exams/marksheet-templates?edit=<?= e($templateRow['id']) ?>">Edit</a><?php endif; ?>
                            <?php if (can('exams', 'delete')): ?><form method="post" action="/exams/marksheet-templates/delete"><input type="hidden" name="id" value="<?= e($templateRow['id']) ?>"><button type="submit">Delete</button></form><?php endif; ?>
                        </td>
                    </tr>
                <?php endforeach; ?>
                <?php if (empty($templates)): ?>
                    <tr><td colspan="8">No marksheet template has been created yet.</td></tr>
                <?php endif; ?>
            </tbody>
        </table>
    </div>
</section>
