<?php
    $formatNumber = static function (?float $value, int $precision = 2): string {
        if ($value === null) {
            return '-';
        }

        $formatted = number_format($value, $precision, '.', '');
        return rtrim(rtrim($formatted, '0'), '.');
    };

    $students = (array) ($students ?? []);
    $studentReports = (array) ($studentReports ?? []);
    $summary = (array) ($summary ?? []);
    $warnings = (array) ($warnings ?? []);
    $distributionRows = array_values((array) ($distributions ?? []));

    // Build a safe distribution header from the actual student reports if the global
    // distribution list is not available. This prevents Result Preview from showing
    // only total/grade while hiding Test, Assignment, Exam, etc.
    if (!$distributionRows) {
        $seenDistributions = [];
        foreach ($studentReports as $reportRow) {
            foreach ((array) ($reportRow['subjects'] ?? []) as $subjectRow) {
                foreach ((array) ($subjectRow['distribution_marks'] ?? []) as $markRow) {
                    $distributionId = (int) ($markRow['distribution_id'] ?? 0);
                    if ($distributionId <= 0 || isset($seenDistributions[$distributionId])) {
                        continue;
                    }
                    $seenDistributions[$distributionId] = true;
                    $distributionRows[] = [
                        'id' => $distributionId,
                        'name' => trim((string) ($markRow['name'] ?? ('Column ' . $distributionId))),
                        'max_mark' => (float) ($markRow['max_mark'] ?? 0),
                    ];
                }
            }
        }
    }

    $findDistributionMark = static function (array $subjectRow, int $distributionId): array {
        foreach ((array) ($subjectRow['distribution_marks'] ?? []) as $markRow) {
            if ((int) ($markRow['distribution_id'] ?? 0) === $distributionId) {
                return (array) $markRow;
            }
        }

        return ['display' => '-', 'mark' => null, 'max_mark' => null];
    };
    $selectedStudent = $selectedStudent ?? null;
    $selectedStudentId = (int) ($selectedStudentId ?? 0);
    $selectedStudentData = $selectedStudent['student'] ?? [];
    $selectedStudentSummary = $selectedStudent['summary'] ?? [];
    $selectedAttendance = $selectedStudent['attendance'] ?? [];
    $selectedStudentQuery = $selectedStudentId > 0
