                                <?php if ($showGradeRemark): ?><td><?= e((string) ($gradeRow['remark'] ?? '')) ?></td><?php endif; ?>
                            </tr>
                        <?php endforeach; ?>
                        <?php if (empty($gradeRows)): ?>
                            <tr>
