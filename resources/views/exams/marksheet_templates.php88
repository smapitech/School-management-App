<?php
    $defaultHeader = '<h2>{institute_name}</h2><p>{institute_address}</p><h3>Student Report Sheet</h3>';
    $defaultFooter = '<p>Principal Comment: {principal_comments}</p><p>Teacher Comment: {teacher_comments}</p>';
?>

<section class="module-hero">
    <div>
        <p class="eyebrow">Report sheet design</p>
        <h2>Marksheet Template</h2>
        <p>Create editable report sheet templates for student and parent result display.</p>
    </div>
</section>

<section class="panel">
    <div class="panel-header">
        <div>
            <p class="eyebrow"><?= $edit ? 'Edit template' : 'Add template' ?></p>
            <h3><?= $edit ? 'Update Marksheet Template' : 'New Marksheet Template' ?></h3>
        </div>
    </div>
    <form class="marksheet-form" method="post" action="/exams/marksheet-templates/save" enctype="multipart/form-data">
        <input type="hidden" name="id" value="<?= e($edit['id'] ?? '') ?>">
        <label><span>Template Name</span><input name="name" value="<?= e($edit['name'] ?? '') ?>" required></label>
        <label><span>Page Layout</span><select name="page_layout"><option <?= ($edit['page_layout'] ?? '') === 'Portrait' ? 'selected' : '' ?>>Portrait</option><option <?= ($edit['page_layout'] ?? '') === 'Landscape' ? 'selected' : '' ?>>Landscape</option></select></label>
        <label><span>Photo Style</span><select name="photo_style"><option <?= ($edit['photo_style'] ?? '') === 'Square' ? 'selected' : '' ?>>Square</option><option <?= ($edit['photo_style'] ?? '') === 'Round' ? 'selected' : '' ?>>Round</option></select></label>
        <label><span>Photo Size PX</span><input type="number" name="photo_size" value="<?= e($edit['photo_size'] ?? 100) ?>"></label>
        <label><span>Top Space PX</span><input type="number" name="top_space" value="<?= e($edit['top_space'] ?? 20) ?>"></label>
        <label><span>Bottom Space PX</span><input type="number" name="bottom_space" value="<?= e($edit['bottom_space'] ?? 20) ?>"></label>
        <label><span>Right Space PX</span><input type="number" name="right_space" value="<?= e($edit['right_space'] ?? 20) ?>"></label>
        <label><span>Left Space PX</span><input type="number" name="left_space" value="<?= e($edit['left_space'] ?? 20) ?>"></label>
        <label><span>Logo Image</span><input type="file" name="logo" accept=".jpg,.jpeg,.png,.gif,.webp"></label>
        <label class="form-wide upload-field">
            <span>A4 Background Image</span>
            <input type="file" name="background" accept=".jpg,.jpeg,.png,.gif,.webp">
            <small>Upload the school-branded A4 report sheet background. Recommended portrait size: 2480 x 3508px. For landscape: 3508 x 2480px.</small>
            <?php if (!empty($edit['background'])): ?>
                <a href="<?= e($edit['background']) ?>" target="_blank">View current A4 background</a>
            <?php endif; ?>
        </label>
        <label><span>Left Signature</span><input type="file" name="left_signature" accept=".jpg,.jpeg,.png,.gif,.webp"></label>
        <label><span>Middle Signature</span><input type="file" name="middle_signature" accept=".jpg,.jpeg,.png,.gif,.webp"></label>
        <label><span>Right Signature</span><input type="file" name="right_signature" accept=".jpg,.jpeg,.png,.gif,.webp"></label>
        <div class="form-wide rich-editor" data-rich-editor>
            <div class="editor-title">
                <span>Header Content</span>
                <button type="button" data-editor-toggle>HTML Code</button>
            </div>
            <div class="editor-toolbar">
                <button type="button" data-command="bold"><strong>B</strong></button>
                <button type="button" data-command="italic"><em>I</em></button>
                <button type="button" data-command="underline"><u>U</u></button>
                <select data-command="fontName">
                    <option value="">Font</option>
                    <option value="Arial">Arial</option>
                    <option value="Georgia">Georgia</option>
                    <option value="Tahoma">Tahoma</option>
                    <option value="Times New Roman">Times New Roman</option>
                    <option value="Verdana">Verdana</option>
                </select>
                <select data-command="formatBlock">
                    <option value="">Style</option>
                    <option value="h2">Heading</option>
                    <option value="h3">Subheading</option>
                    <option value="p">Paragraph</option>
                </select>
                <input type="color" value="#17394a" data-command="foreColor" title="Text color">
                <button type="button" data-create-link>Link</button>
            </div>
            <div class="editor-surface" contenteditable="true" data-editor-surface><?= $edit['header_content'] ?? $defaultHeader ?></div>
            <textarea name="header_content" rows="6" data-editor-source><?= e($edit['header_content'] ?? $defaultHeader) ?></textarea>
        </div>
        <div class="form-wide rich-editor" data-rich-editor>
            <div class="editor-title">
                <span>Footer Content</span>
                <button type="button" data-editor-toggle>HTML Code</button>
            </div>
            <div class="editor-toolbar">
                <button type="button" data-command="bold"><strong>B</strong></button>
                <button type="button" data-command="italic"><em>I</em></button>
                <button type="button" data-command="underline"><u>U</u></button>
                <select data-command="fontName">
                    <option value="">Font</option>
                    <option value="Arial">Arial</option>
                    <option value="Georgia">Georgia</option>
                    <option value="Tahoma">Tahoma</option>
                    <option value="Times New Roman">Times New Roman</option>
                    <option value="Verdana">Verdana</option>
                </select>
                <select data-command="formatBlock">
                    <option value="">Style</option>
                    <option value="h3">Subheading</option>
                    <option value="p">Paragraph</option>
                    <option value="div">Block</option>
                </select>
                <input type="color" value="#17394a" data-command="foreColor" title="Text color">
                <button type="button" data-create-link>Link</button>
            </div>
            <div class="editor-surface" contenteditable="true" data-editor-surface><?= $edit['footer_content'] ?? $defaultFooter ?></div>
            <textarea name="footer_content" rows="5" data-editor-source><?= e($edit['footer_content'] ?? $defaultFooter) ?></textarea>
        </div>
        <div class="form-wide tag-bank">
            <?php foreach ($tags as $tag): ?><button type="button" data-template-tag="<?= e($tag) ?>"><?= e($tag) ?></button><?php endforeach; ?>
        </div>
        <div class="form-wide marksheet-options">
            <?php
                $checks = [
                    'attendance_percentage' => 'Attendance Percentage',
                    'grading_scale' => 'Grading Scale',
                    'position' => 'Position',
                    'cumulative_average' => 'Cumulative Average',
                    'class_average' => 'Class Average',
                    'subject_position' => 'Subject Position',
                    'remark' => 'Remark',
                    'result' => 'Result',
                ];
            ?>
            <?php foreach ($checks as $name => $label): ?>
                <label><input type="checkbox" name="<?= e($name) ?>" value="1" <?= (int) ($edit[$name] ?? 1) === 1 ? 'checked' : '' ?>> <?= e($label) ?></label>
            <?php endforeach; ?>
        </div>
        <div class="form-actions form-wide">
            <?php if ($edit): ?><a class="secondary-action" href="/exams/marksheet-templates">Cancel Edit</a><?php endif; ?>
            <button type="submit"><?= $edit ? 'Update Template' : 'Save Template' ?></button>
        </div>
    </form>
</section>

<section class="panel">
    <div class="panel-header"><div><p class="eyebrow">Templates</p><h3>Template List</h3></div></div>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Name</th><th>Layout</th><th>Photo</th><th>Attendance</th><th>Grades</th><th>Created</th><th>Action</th></tr></thead>
            <tbody>
                <?php foreach ($templates as $template): ?>
                    <tr>
                        <td><?= e($template['name']) ?></td>
                        <td><?= e($template['page_layout']) ?></td>
                        <td><?= e($template['photo_style']) ?> / <?= e($template['photo_size']) ?>px</td>
                        <td><span class="status"><?= (int) $template['attendance_percentage'] === 1 ? 'Shown' : 'Hidden' ?></span></td>
                        <td><span class="status"><?= (int) $template['grading_scale'] === 1 ? 'Shown' : 'Hidden' ?></span></td>
                        <td><?= e($template['created_at']) ?></td>
                        <td class="row-actions">
                            <a href="/exams/marksheet-templates/preview?id=<?= e($template['id']) ?>">View</a>
                            <?php if (can('exams', 'edit')): ?><a href="/exams/marksheet-templates?edit=<?= e($template['id']) ?>">Edit</a><?php endif; ?>
                            <?php if (can('exams', 'delete')): ?><form method="post" action="/exams/marksheet-templates/delete"><input type="hidden" name="id" value="<?= e($template['id']) ?>"><button type="submit">Delete</button></form><?php endif; ?>
                        </td>
                    </tr>
                <?php endforeach; ?>
                <?php if (empty($templates)): ?><tr><td colspan="7">No marksheet template has been created yet.</td></tr><?php endif; ?>
            </tbody>
        </table>
    </div>
</section>
